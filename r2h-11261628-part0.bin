<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' blob:; style-src 'unsafe-inline'; img-src blob: data:; media-src blob: data:; font-src blob: data:; connect-src 'none'">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <link rel="icon" data-island-href="sausage/ui-v4/GoldenBean_GoldDash.png">
  
  <title>肠岛箭行 · 本地离线</title>
<style>html{background:#61c9f9}body{margin:0}.loading{text-align:center;color:#173552;padding-top:22vh}</style>
</head>
<body>
  <main id="game">
    <canvas id="world" aria-label="游戏场景"></canvas>
    <div id="labels" aria-hidden="true"></div>
    <div id="vignette" aria-hidden="true"></div>
    <div id="hud" hidden>
      <div class="hud-stats">
        <span class="stat health"><img data-island-src="sausage/ui-v4/Heart_2.png" alt="血量"><strong id="hp">100</strong></span>
        <div class="hud-readings">
          <span class="stat" data-hud-cell="shots" title="子弹数量：每次开枪打出几颗子弹"><img data-island-src="sausage/ui-v4-r2/bullet.png" alt=""><span class="hud-key">子弹</span><strong id="arrows"></strong></span>
          <span class="stat"><img data-island-src="sausage/icons/sword.png" alt=""><span class="hud-key">飞剑</span><strong id="swords"></strong></span>
          <span class="stat score">分 <strong id="score"></strong></span>
          <span class="stat"><img data-island-src="sausage/ui-v4/GoldenBean_GoldDash.png" alt="金豆"><strong id="run-gold"></strong></span>
        </div>
      </div>
      <div class="hud-controls">
        <button class="small" data-action="stats">属性</button>
        <button class="small" data-action="pause" aria-label="暂停">暂停</button>
      </div>
      <div id="loadout" role="list" aria-label="当前装备和搭档" hidden></div>
    </div>
    <div id="boss-progress" role="progressbar" aria-label="本圈巡岛进度" aria-valuemin="0" aria-valuemax="1963" aria-valuenow="0" hidden>
      <span class="progress-track"></span><span class="progress-fill"></span><span class="progress-marks"></span>
      <img class="progress-hero" data-island-src="sausage/ui-v4/tj_zzxc.png" alt="">
    </div>
    <div id="bossbar" hidden><img id="boss-portrait" alt="" data-island-src="sausage/ui-v4/tj_wpgs.png"><span id="bossname"></span><i id="boss-warning" aria-hidden="true">WARNING</i><progress id="bosshp"></progress></div>
    <p id="toast" aria-live="polite" hidden></p>
    <p id="price-status" class="sr-only" role="status"></p>
    <section id="pet-promotion" role="status" aria-live="polite" hidden></section>
    <div id="touch" hidden>
      <button data-direction="-1" aria-label="向左"><img data-island-src="sausage/icons/left.png" alt="" draggable="false"></button>
      <button data-direction="1" aria-label="向右"><img data-island-src="sausage/icons/right.png" alt="" draggable="false"></button>
    </div>
    <section id="overlay" aria-label="菜单">
      <div class="loading"><span>肠岛巡航</span><strong>肠岛箭行</strong><p>正在打开游戏……</p>
        <p class="loading-note">首次载入约需 10–20 秒</p>
        <p class="loading-slow" hidden>一直停在这一页？请改用电脑上最新版的 Chrome 或 Edge 打开（不要用兼容模式）。</p></div>
    </section>
  </main>
  <script>
    // A page still on the loading screen after 25 seconds gets one more line. Plain old-style script on purpose: it has to run
    // in the browsers (and compatibility modes) where the game itself cannot start. The line is hidden by its attribute, not by a style.
    setTimeout(function () {
      var line = document.querySelector(".loading-slow");
      if (line && !document.documentElement.getAttribute("data-ready")) line.removeAttribute("hidden");
    }, 25000);
  </script>
  <script>
    // Startup diagnostics stay in the console. The startup surface has one player-facing message.
    const startupState = new MutationObserver(() => {
      const ready = document.documentElement.dataset.ready;
      if (ready === "failed") {
        const message = document.createElement("p");
        message.className = "panel narrow";
        message.textContent = "无法打开游戏。请用 Chrome 或 Edge 重新打开这个文件。";
        document.getElementById("overlay").replaceChildren(message);
      }
      if (ready) startupState.disconnect();
    });
    startupState.observe(document.documentElement, { attributes: true, attributeFilter: ["data-ready"] });
  </script>
  
<script id="island-style" type="text/plain">@font-face { font-family: Island; src: url(assets/sausage/fonts/sausage.woff2) format("woff2"); font-weight: 400 900; font-display: swap; }
@font-face { font-family: IslandCompat; src: url(assets/sausage/fonts/compat.woff2) format("woff2"); font-weight: 400 900; font-display: swap; }

:root {
  font: 16px/1.38 Island, IslandCompat, sans-serif;
  --ink: #1e293f;
  --navy: #172338;
  --paper: #f3f8ff;
  --sheet: #e2edf9;
  --yellow: #ffdf36;
  --green: #00ce9c;
  --pink: #ff366d;
  --sky: #69cbff;
  --muted: #475876;
  --line: #a7bbd2;
  color: var(--ink);
  background: #7ad2fc;
}
*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
#game { position: relative; width: 100%; height: 100%; height: 100dvh; isolation: isolate; overflow: hidden; }
#world, #labels, #overlay { position: absolute; width: 100%; height: 100%; inset: 0; }
#world { display: block; }
#labels { pointer-events: none; overflow: hidden; }
img { vertical-align: middle; max-width: 100%; }
h1, h2, h3, p { margin: 0; }
button, input { font: inherit; }
button { cursor: pointer; color: inherit; -webkit-tap-highlight-color: transparent; }
button:disabled { cursor: default; }
:focus-visible { outline: 3px solid #fff; box-shadow: 0 0 0 6px #244ba1; outline-offset: 2px; }
.sr-only { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
.muted { color: var(--muted); font-size: .9rem; }

#overlay { z-index: 4; display: grid; place-items: center; background: #182b4780;
  padding: max(10px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right))
    max(10px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left)); }
#overlay[data-screen="menu"] { background: none; padding: 0; }
#overlay:not([data-screen]) { background: linear-gradient(145deg,#078cdb,#72ddfb 78%,#f2fbff); }
.loading { display: grid; justify-items: center; align-content: center; row-gap: 12px; color: #fff; text-shadow: 0 3px #193c68; }
.loading strong { font-size: clamp(2.25rem,10vw,5rem); }
.loading span, .eyebrow span { background: var(--yellow); color: var(--ink); text-shadow: none;
  padding: 4px 10px; border: 2px solid var(--ink); transform: skewX(-7deg); }
.loading p { font-size: 1.05rem; }
.menu { position: absolute; inset: 0; }
.lobby-heading { position: absolute; top: clamp(22px,7vh,76px); left: max(5vw,env(safe-area-inset-left));
  max-width: 45%; color: #fff; text-shadow: 0 3px 0 #1e3657; }
.eyebrow { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; font-size: clamp(.64rem,1vw,.93rem); }
.eyebrow span + span { color: #fff; background: var(--ink); border-color: #fff; }
.wordmark { font-size: clamp(2.75rem,7vw,7.5rem); line-height: 1.1; margin: .13em 0 .08em;
  letter-spacing: .025em; -webkit-text-stroke: clamp(1.2px,.22vw,3px) #1e293f; paint-order: stroke fill;
  text-shadow: 3px 5px #1e293f, 0 8px 0 #1e293f; transform: skewX(-6deg); }
.lobby-heading p { font-size: clamp(.75rem,1.35vw,1.18rem); text-wrap: balance; }
.lobby-balance { position: absolute; top: max(16px,env(safe-area-inset-top)); right: max(4vw,env(safe-area-inset-right));
  min-width: 92px; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px 12px;
  color: #fff; background: var(--ink); border: 2px solid #fff; border-radius: 12px 7px 12px 7px; box-shadow: 0 3px #273751; }
.lobby-balance > span:last-child { font-size: .75rem; color: #d2e7fc; }
.lobby-brief { position: absolute; left: max(5vw,env(safe-area-inset-left)); bottom: max(8vh,env(safe-area-inset-bottom));
  width: min(27vw,298px); padding: 15px 17px; background: var(--paper); border: 3px solid var(--ink);
  border-radius: 9px 18px 9px 18px; box-shadow: 4px 5px 0 #22324a; }
.lobby-brief > span { display: inline-block; color: #fff; background: var(--ink); padding: 3px 7px; font-size: .82rem; }
.lobby-brief p { margin: 8px 0 6px; }
.lobby-brief small { color: var(--muted); font-size: .7rem; }
.lobby-note { position: absolute; left: max(5vw,env(safe-area-inset-left)); bottom: max(2vh,env(safe-area-inset-bottom));
  color: #fff; text-shadow: 0 2px var(--ink); font-size: .69rem; white-space: nowrap; }
.menu-buttons { position: absolute; right: max(4vw,env(safe-area-inset-right)); bottom: max(8vh,env(safe-area-inset-bottom));
  width: clamp(232px,25vw,358px); display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
.menu-buttons .launch { grid-column: 1 / -1; display: grid; justify-content: stretch; text-align: left;
  min-height: 80px; padding: 9px 21px; background: #ffda36 url(assets/sausage/icons/cta.png) center/100% 100%; }
.launch span { font-size: clamp(1.55rem,3.3vw,2.65rem); line-height: 1.07; transform: skewX(-5deg); }
.launch small { font-size: .75rem; letter-spacing: .075em; color: #293750; }

.action, .small, .card, .nav, #touch button {
  min-height: 44px; border: 2px solid var(--ink); border-radius: 8px 12px 8px 12px;
  box-shadow: 0 3px 0 var(--ink); background: #334562; color: #fff; padding: 8px 12px;
  transition: background-color .12s, transform .12s; }
.action, .small, .nav { display: inline-flex; justify-content: center; align-items: center; gap: 6px; }
.action img, .small img, .nav img { width: 20px; height: 20px; object-fit: contain; flex: 0 0 auto; }
.action:hover:not(:disabled), .small:hover:not(:disabled), #touch button:hover { background-color: #4a6084; }
.action:active:not(:disabled), .small:active:not(:disabled), .card:active, #touch button:active { transform: translateY(2px); }
.action.primary, .primary { color: var(--ink); background-color: var(--yellow); }
.primary:hover:not(:disabled) { background-color: #fff08c; }
.action:disabled { background: #c2cedd; color: #344763; box-shadow: 0 2px #8da0b7; border-color: #8499b3; }
.coin { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; color: inherit; }
.coin img { width: 23px; height: 23px; object-fit: contain; }
.action .coin img { width: 18px; height: 18px; }
.price-refresh { color: #ffe677; }
.price-shop { color: #ffdd50; }
.price-short { color: #ff435c; }
.panel { width: min(716px,100%); max-height: 100%; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable;
  color: var(--ink); background: var(--paper); border: 3px solid var(--ink); border-radius: 14px 20px 14px 20px;
  padding: clamp(12px,3vw,25px); box-shadow: 0 7px #1b2942, 0 14px 35px #0d2b5070; }
.panel.wide { width: min(946px,100%); }
.panel.narrow { width: min(419px,100%); }
.panel header { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin-bottom: 12px; }
.panel header > .coin { color: #fff; padding: 4px 9px; border-radius: 8px; background: var(--ink); }
.collection-panel { display: flex; flex-direction: column; overflow: hidden; scrollbar-gutter: auto; }
.collection-panel > header, .collection-panel > .buttons { flex: none; }
.collection-scroll { min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable;
  padding: 8px; margin: -4px -8px 0; }
h2 { font-size: clamp(1.35rem,4vw,2.3rem); line-height: 1; position: relative; isolation: isolate; padding: 8px 13px 7px; }
h2::before { content: ""; position: absolute; inset: 0; z-index: -1; transform: skewX(-7deg);
  background: #ffda35 url(assets/sausage/icons/header.png) right center/auto 100% no-repeat; border: 2px solid var(--ink);
  border-radius: 5px 10px 5px 4px; box-shadow: 2px 2px #233451; }
.buttons { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
.cards, .store, .summary { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; margin-top: 10px; }
.cards { align-items: stretch; }
.card { display: flex; flex-direction: column; justify-content: flex-start; align-items: stretch; gap: 5px;
  text-align: left; color: var(--ink); background: var(--sheet); padding: clamp(5px,1.5vw,13px);
  --card-ink: #275683; --card-bright: #9de5ff; min-width: 0; min-height: 148px; }
.card:hover { background: #fff; }
.card[data-family="red"] { --card-ink: #9b2454; --card-bright: #ff8da7; }
.card[data-family="dark"] { --card-ink: #684093; --card-bright: #d0a7ff; }
.card[data-family="gear"] { --card-ink: #344963; --card-bright: #c8d9ef; }
.card[data-family="pet"] { --card-ink: #106659; --card-bright: #7ce8ca; }
.card[data-family="relic"] { --card-ink: #755016; --card-bright: #ffe277; }
.card-tag { color: #fff; background: var(--card-ink); padding: 3px 8px; border-radius: 4px 8px 4px 8px; font-size: .72rem; }
.card-picture { display: grid; place-items: center; border-radius: 7px; min-height: clamp(47px,11vw,91px);
  background: repeating-linear-gradient(135deg,#fff0 0 11px,#fff3 11px 13px),var(--card-ink); border: 2px solid var(--card-bright); }
.card img { width: clamp(32px,8vw,70px); height: clamp(32px,8vw,66px); object-fit: contain; filter: drop-shadow(0 2px 1px #112746); }
.card b { color: var(--card-ink); font-size: .8rem; letter-spacing: .02em; }
.card strong { font-size: clamp(.8rem,2.1vw,1.19rem); line-height: 1.15; }
.card small { color: var(--muted); line-height: 1.32; overflow-wrap: anywhere; font-size: clamp(.65rem,1.2vw,.87rem); }
.reward-underlay { pointer-events: none; position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; opacity: .28; z-index: -1; }
.product, .metric { min-width: 0; background: var(--sheet); border: 1px solid var(--line); padding: 9px; border-radius: 9px 13px 9px 13px; }
.product { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.product > img { width: 41px; height: 33px; object-fit: contain; background: #52688c; padding: 4px; border-radius: 8px; }
.product h3 { font-size: 1rem; }
.product p.muted { flex: 1; }
.product button { align-self: stretch; margin: 1px 0 3px; padding-inline: 5px; }
.metric { display: grid; gap: 4px; }
.metric span { color: var(--muted); font-size: .74rem; overflow-wrap: anywhere; }
.metric strong { font-size: clamp(.82rem,2vw,1.22rem); overflow-wrap: anywhere; }
.records { display: grid; gap: 7px; }
.record-entry { border: 1px solid var(--line); background: var(--sheet); border-radius: 8px; padding: 8px; margin-top: 7px; }
.scoreline { display: flex; gap: 7px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.scoreline img { width: 29px; height: 29px; object-fit: contain; }
.scoreline small { display: block; color: var(--muted); }
.scoreline.achievement { display: grid; grid-template-columns: auto minmax(0,1fr) auto; padding: 7px;
  background: var(--sheet); border-radius: 7px; border: 1px solid var(--line); min-height: 52px; }
.achievement > img { background: var(--ink); padding: 4px; border-radius: 6px; }
.status-chip { display: inline-flex; align-items: center; color: #fff; background: #48648b; padding: 2px 7px; border-radius: 4px; font-size: .75rem; }
.status-chip.success { color: #183647; background: #65e4bb; }
.record-buffs { display: flex; flex-wrap: wrap; gap: 3px; padding: 6px 0; }
.record-buffs .loadout-item.loadout-text { font-size:14px; }
.record-damage { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 4px; margin: 6px 0 0; }
.record-damage > div { background: var(--paper); padding: 3px 6px; border-radius: 4px; font-size: .75rem; overflow-wrap: anywhere; }
.record-damage dt { color: var(--muted); }
.record-damage dd { margin: 0; }
.empty-state { text-align: center; border: 2px dashed #b5c9dd; color: var(--muted); padding: 28px 12px; border-radius: 12px; }
.option { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 48px;
  margin: 5px 0; padding: 4px 8px; background: var(--sheet); border-radius: 6px; }
.option input { accent-color: #286bb7; min-height: 44px; }
.option input[type="range"] { width: min(45%,220px); }
.option input[type="checkbox"] { width: 23px; }
.pause-layout { display: grid; grid-template-columns: minmax(220px,.67fr) minmax(0,1.33fr); align-items: center; gap: 10px;
  width: min(1070px,100%); height: auto; max-height: 100%; overflow: auto; overscroll-behavior: contain; padding: 3px 5px 10px; }
.pause-layout .buttons { justify-content: stretch; }
.pause-layout .action { flex: 1; }
.pause-layout .stats-panel { max-height: 90dvh; }
.stat-group h3 { padding: 4px 7px; border-left: 4px solid #26a6da; background: var(--sheet); margin: 5px 0; font-size: .87rem; }
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(75px,1fr)); gap: 4px; }
.stat-tile { display: grid; grid-template-columns: 19px 1fr; gap: 2px 4px; align-items: center; padding: 5px;
  background: #dceaf8; border-radius: 5px; word-break: break-word; font-size: .77rem; }
.stat-tile img { grid-row: 1 / span 2; width: 19px; height: 21px; object-fit: contain; }
.stat-tile span { color: #354f71; }
.cape-bonus { color: #136b60 !important; }
.pet-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
.pet-stats .stat-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
.damage-stats { margin-top: 9px; }
.damage-stats summary { cursor: pointer; min-height: 44px; padding: 9px 0; }

#hud { position: absolute; z-index: 2; top: max(9px,env(safe-area-inset-top)); left: max(10px,env(safe-area-inset-left));
  right: max(10px,env(safe-area-inset-right)); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5px; }
.hud-stats, .hud-controls, #loadout { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
#loadout { flex-basis: 100%; pointer-events: none; }
.stat, .loadout-item { position: relative; color: #fff; background: var(--ink); border: 2px solid #f2f8ff;
  border-radius: 7px 11px 7px 11px; box-shadow: 0 2px #233c5c; }
.stat { display: inline-flex; align-items: center; gap: 4px; min-height: 35px; padding: 4px 6px; font-size: .86rem; }
.stat img { width: 20px; height: 21px; object-fit: contain; }
.stat.health { background: #962c56; }
.stat.score { background: #235f91; }
.small { padding: 4px 8px; }
.loadout-item { display: inline-grid; place-items: center; width: 35px; height: 35px; }
.loadout-item img { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; }
.loadout-item strong { position: absolute; right: 1px; bottom: -1px; font-size: .83rem; color: #ffe878;
  text-shadow: 0 1px var(--ink), 1px 0 var(--ink), -1px 0 var(--ink); }
#bossbar { position: absolute; z-index: 2; top: max(85px,calc(env(safe-area-inset-top) + 80px)); left: 50%;
  transform: translateX(-50%); display: grid; justify-items: center; gap: 3px; min-width: 158px; }
#bossbar span { color: #fff; background: #7e2751; border: 1px solid #fff; border-radius: 6px; padding: 2px 6px; white-space: nowrap; }
#bossbar progress { display: block; width: clamp(145px,31vw,332px); height: 14px; accent-color: #ff476d; }
#boss-progress { position: absolute; top: 20%; left: max(11px,env(safe-area-inset-left)); height: min(57vh,620px);
  width: 24px; z-index: 1; }
.progress-track, .progress-fill, .progress-marks { position: absolute; inset: 0; border-radius: 9px; }
.progress-track { background: #1a2943 url(assets/sausage/icons/track.png) center/100% 100%; border: 2px solid #f4f8ff; box-shadow: 0 3px #253c63; }
.progress-fill { inset: 3px 5px; background: #ffdf36; clip-path: inset(calc(100% - var(--progress-fill)) 0 0 0); }
.progress-marks { inset: 7px 6px; background: repeating-linear-gradient(to top,#fff0 0 6.05%,#fff9 6.05% 6.26%); }
.progress-hero { position: absolute; width: 27px; max-width: none; left: 50%; bottom: var(--progress-marker);
  transform: translate(-50%,50%); filter: drop-shadow(0 1px 1px #10213c); }
#toast { position: absolute; z-index: 3; left: 50%; bottom: max(12%,calc(65px + env(safe-area-inset-bottom)));
  transform: translateX(-50%); max-width: 80%; width: max-content; text-align: center;
  color: #fff; padding: 6px 10px; background: var(--ink); border: 2px solid #fff; border-radius: 7px 12px 7px 12px; }
.world-label { position: absolute; left: 0; top: 0; white-space: nowrap; color: #fff;
  text-shadow: 0 2px #1e293f; -webkit-text-stroke: 1.5px #1e293f; paint-order: stroke fill; }
.enemy-life, .boss-life { font-size: clamp(.8rem,2.2vw,1.22rem); }
.boss-life { color: #ffe877; }
.gate-label { font-size: clamp(.65rem,1.6vw,1rem); background: #174772; padding: 3px 5px;
  border: 1px solid #e4f8ff; border-radius: 4px 8px 4px 8px; }
.gate-1 { background: #853056; border-color: #ffe78f; }
#touch { position: absolute; z-index: 2; bottom: max(12px,env(safe-area-inset-bottom)); left: max(12px,env(safe-area-inset-left));
  right: max(12px,env(safe-area-inset-right)); justify-content: space-between; display: none; pointer-events: none; }
#touch button { display: grid; place-items: center; pointer-events: auto; width: 56px; height: 52px; padding: 4px; user-select: none; touch-action: none; }
#touch img { width: 37px; height: 36px; object-fit: contain; }
#pet-promotion { position: absolute; z-index: 3; left: 50%; top: 44%; width: min(590px,95%,72vh);
  transform: translate(-50%,-50%); pointer-events: none; text-align: center; }
.promotion-announcement { display: inline-block; max-width: 95%; background: var(--yellow); color: var(--ink);
  border: 2px solid var(--ink); transform: skewX(-6deg); padding: 5px 12px; border-radius: 5px; }
.promotion-stage { position: relative; width: 100%; aspect-ratio: 1100 / 571.1; }
.promotion-card { position: absolute; left: calc(50% + var(--card-shift)); top: 48.17%; width: 32.02%;
  padding: 6%; display: grid; grid-template-rows: minmax(0,1fr) auto; align-items: center;
  aspect-ratio: 352.22 / 571.1; transform: translate(-50%,-50%) scale(var(--card-scale));
  border: 3px solid var(--ink); background: var(--sheet); box-shadow: 0 6px var(--ink); border-radius: 9px 16px 9px 16px; }
.promotion-result { background: #ffd947; border-color: #28233b; }
.promotion-portrait { min-height: 0; }
.promotion-portrait > img { width: 100%; aspect-ratio: 1; object-fit: contain; background: #50678b; border-radius: 9px; }
.promotion-stars { color: #6c4509; white-space: nowrap; font-size: clamp(.6rem,2.4vw,1.1rem); }
.promotion-stars .empty-star { opacity: .2; }
.promotion-copy { font-size: clamp(.62rem,2vw,1.06rem); line-height: 1.05; }

@media (pointer: coarse), (max-width: 690px) { #touch { display: flex; } }
@media (max-width: 680px) {
  .lobby-heading { top: max(14px,env(safe-area-inset-top)); left: max(13px,env(safe-area-inset-left)); max-width: 80%; }
  .lobby-heading p { max-width: 92%; font-size: .78rem; color: var(--ink); text-shadow: none; }
  .lobby-balance { right: max(12px,env(safe-area-inset-right)); top: max(9px,env(safe-area-inset-top)); min-width: 52px; padding: 4px 6px; }
  .lobby-balance > span:last-child { display: none; }
  .menu-buttons { width: min(92%,420px); right: 50%; transform: translateX(50%); bottom: max(32px,calc(env(safe-area-inset-bottom) + 28px)); }
  .menu-buttons .launch { min-height: 60px; }
  .lobby-brief { bottom: max(228px,calc(env(safe-area-inset-bottom) + 221px)); width: auto; max-width: min(92%,420px);
    left: 50%; transform: translateX(-50%); padding: 4px 7px; display: grid; white-space: normal; font-size: .68rem; }
  .lobby-brief > span, .lobby-brief small { display: none; }
  .lobby-brief p { margin: 0; }
  .lobby-note { left: 50%; transform: translateX(-50%); bottom: max(7px,env(safe-area-inset-bottom)); }
  .pause-layout { grid-template-columns: minmax(0,1fr); align-items: start; }
  .pause-layout .panel.narrow, .pause-layout .stats-panel { width: 100%; max-height: none; overflow: visible; }
  #boss-progress { top: 26%; width: 16px; left: max(6px,env(safe-area-inset-left)); height: min(43vh,360px); }
  #boss-progress .progress-hero { width: 20px; }
  #bossbar { top: max(114px,calc(env(safe-area-inset-top) + 108px)); }
}
@media (max-width: 460px) {
  .store { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .record-damage { grid-template-columns: repeat(3,minmax(0,1fr)); }
  .hud-stats, .hud-controls, #loadout { gap: 3px; }
  .stat { font-size: .76rem; min-height: 31px; padding-inline: 5px; }
  .stat img { width: 16px; height: 16px; }
  .small { min-width: 44px; font-size: .8rem; }
  .loadout-item { width: 26px; height: 26px; border-width: 1px; }
  .panel header { margin-bottom: 8px; }
  .card-tag { padding: 3px; }
}
@media (max-width: 360px) { .lobby-heading { max-width: 76%; } .eyebrow { gap: 2px; } .stat-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } }
@media (max-height: 555px) and (max-width: 680px) {
  .lobby-brief { display: none; }
  .menu-buttons { bottom: max(26px,env(safe-area-inset-bottom)); gap: 5px; }
  .menu-buttons .launch { min-height: 47px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
}

/* Theme 2 UI polish: use the staged source sprites for the high-salience surfaces. */
.action, .small, .nav, #touch button {
  background: #334562 url(assets/sausage/icons/secondary.png) center / 100% 100% no-repeat;
  border-width: 3px;
  box-shadow: 0 4px 0 #1a2943, inset 0 1px #90a7c4;
  font-weight: 800;
}
.action.primary, .primary, .menu-buttons .launch {
  background-image: url(assets/sausage/icons/cta.png);
  border-color: #1f2c44;
  box-shadow: 0 4px 0 #1a2943, inset 0 1px #fff3a1;
}
.panel {
  background: linear-gradient(145deg, #f9fcff 0%, #e8f1fb 58%, #d8e7f5 100%);
  border-width: 4px;
  box-shadow: 0 8px 0 #1b2942, 0 17px 35px #0d2b5070, inset 0 1px #fff;
}
.product, .metric, .stat-tile, .option {
  border: 2px solid #9cb6d3;
  box-shadow: inset 0 1px #fff9, 0 2px 0 #c0d2e5;
}
.product > img {
  width: 46px;
  height: 38px;
  border: 2px solid #dbeaff;
  box-shadow: 0 2px 0 #324d73;
}
.card {
  border-width: 3px;
  box-shadow: 0 4px 0 var(--ink), inset 0 1px #fff9;
}
.card-picture {
  min-height: clamp(52px, 11vw, 96px);
  box-shadow: inset 0 2px #ffffff33, 0 2px 0 #24456c;
}
.panel header { margin-bottom: 15px; }
.collection-scroll { padding: 10px; }
.collection-scroll::-webkit-scrollbar { width: 14px; }
.collection-scroll::-webkit-scrollbar-thumb { background: #4d6b94; border: 3px solid #dceafa; border-radius: 8px; }
.collection-scroll::-webkit-scrollbar-track { background: #d4e2f1; border-radius: 8px; }

.promotion-card {
  border: 16px solid transparent;
  border-image: url(assets/sausage/ui-s0/frame.png) 94 fill / 16px / 0 round;
  background: transparent;
  box-shadow: 0 8px 0 #2a2632;
  isolation: isolate;
}
.promotion-card::before {
  content: "";
  position: absolute;
  z-index: 0;
  inset: 14% 12% 23%;
  border-radius: 12px;
  background: url(assets/sausage/ui-s0/panel.png) center / 100% 100% no-repeat;
  opacity: .45;
  pointer-events: none;
}
.promotion-card::after {
  content: "";
  position: absolute;
  z-index: 0;
  inset: -8% -5%;
  background: url(assets/sausage/ui-s0/light.png) center / 100% 100% no-repeat;
  opacity: .25;
  pointer-events: none;
}
.promotion-card.promotion-result::after {
  background-image: url(assets/sausage/ui-s0/light.png);
  opacity: .55;
}
.promotion-card > * { position: relative; z-index: 1; }
.promotion-stars .filled-star, .promotion-stars .empty-star {
  display: inline-block;
  width: 1.05em;
  height: 1.05em;
  margin-inline: .03em;
  overflow: hidden;
  font-size: 0;
  vertical-align: -.15em;
  background: center / contain no-repeat;
}
.promotion-stars .filled-star { background-image: url(assets/sausage/ui-s0/star.png); }
.promotion-stars .empty-star { background-image: url(assets/sausage/ui-s0/star-off.png); opacity: .82; }

.lobby-note { padding: 3px 8px; background: #1e293fcc; border: 1px solid #eaf4ff; border-radius: 5px; font-weight: 700; }
.world-label { text-shadow: 0 2px #172338, 0 0 3px #172338; }
.world-label { background: #172338cc; border: 1px solid #f4f8ff; border-radius: 5px; padding: 2px 5px; }
.stat, .loadout-item { box-shadow: 0 3px 0 #1b2942, inset 0 1px #ffffff55; }

@media (max-width: 460px) {
  .panel { border-width: 3px; }
  .product > img { width: 40px; height: 34px; }
  .card small { font-size: .72rem; line-height: 1.25; }
  .lobby-note { font-size: .67rem; }
}
.promotion-card::after { display: none; }
.promotion-card .promotion-glow {
  position: absolute;
  z-index: 0;
  inset: -8% -5%;
  width: 110%;
  height: 116%;
  object-fit: fill;
  pointer-events: none;
}

/* Unity-style Canvas pass: safe-area anchors, sliced materials, and explicit control states. */
:root {
  --canvas-safe-top: max(10px, env(safe-area-inset-top));
  --canvas-safe-right: max(10px, env(safe-area-inset-right));
  --canvas-safe-bottom: max(10px, env(safe-area-inset-bottom));
  --canvas-safe-left: max(10px, env(safe-area-inset-left));
  --frame-blue: #182b47;
  --frame-blue-soft: #29486d;
  --frame-line: #e9f5ff;
  --frame-paper: #edf6ff;
  --material-panel: url(assets/sausage/ui-s0/panel.png);
  --material-button: url(assets/sausage/icons/secondary.png);
  --material-cta: url(assets/sausage/icons/cta.png);
}
#game { container-type: inline-size; }
#world { z-index: 0; }
#labels { z-index: 1; }
#hud, #boss-progress, #bossbar, #toast, #touch, #pet-promotion { pointer-events: none; }
#hud > *, #boss-progress, #bossbar, #toast, #touch button, #pet-promotion button { pointer-events: auto; }

/* Canvas HUD groups use anchored trays instead of floating text. */
#hud { top: var(--canvas-safe-top); left: var(--canvas-safe-left); right: var(--canvas-safe-right); display: grid; grid-template-columns: minmax(0,1fr) auto; grid-template-areas: "stats controls" "loadout controls"; align-items: start; gap: 6px 10px; }
.hud-stats { grid-area: stats; max-width: min(72vw, 720px); padding: 5px; background: #10233dcc; border: 2px solid var(--frame-line); border-radius: 10px 16px 10px 16px; box-shadow: 0 5px 0 #0c1830, inset 0 1px #ffffff66; }
.hud-controls { grid-area: controls; padding: 5px; background: #10233dcc; border: 2px solid var(--frame-line); border-radius: 10px 16px 10px 16px; box-shadow: 0 5px 0 #0c1830, inset 0 1px #ffffff66; }
#loadout { grid-area: loadout; padding: 4px 6px; width: max-content; max-width: min(72vw, 720px); background: #10233dcc; border: 2px solid #b9d6ee; border-radius: 8px 12px 8px 12px; box-shadow: 0 4px 0 #0c1830; }
.stat, .loadout-item { border-color: #d9efff; background: linear-gradient(#294a72,#132844); box-shadow: inset 0 1px #ffffff66, 0 3px 0 #0b1930; }
.stat.health { background: linear-gradient(#b44972,#6d1f4b); }
.stat.score { background: linear-gradient(#3a82b4,#1e4e7a); }
.stat strong { font-variant-numeric: tabular-nums; }

/* Nine-slice panel shell with header, body, and footer rhythm. */
.panel { position: relative; isolation: isolate; border: 12px solid transparent; border-image: var(--material-panel) 24 fill / 12px / 0 round; border-radius: 0; background: linear-gradient(145deg,#f8fcff 0%,#e4f0fb 56%,#cbddec 100%); box-shadow: 0 10px 0 #0b1930, 0 22px 42px #071b3599, inset 0 1px #ffffff; padding: clamp(14px,2.7vw,27px); }
.panel::before { content: ""; position: absolute; inset: 10px; z-index: -1; border: 1px solid #ffffff99; border-radius: 8px; pointer-events: none; }
.panel header { min-height: 42px; padding-bottom: 8px; border-bottom: 2px solid #96b6d4; }
.panel header h2 { filter: drop-shadow(0 2px 0 #223451); }
.panel header > .coin { border: 2px solid #e9f5ff; box-shadow: inset 0 1px #ffffff66, 0 3px 0 #0b1930; }
.collection-panel > .buttons, .reward-panel > .buttons { padding-top: 10px; margin-top: 8px; border-top: 2px solid #96b6d4; }
.collection-scroll { padding: 10px 8px 12px; }

/* Unity-like button state stack. */
.action, .small, .nav, #touch button { position: relative; overflow: hidden; border: 3px solid #0d1d35; border-radius: 8px 14px 8px 14px; background: var(--material-button) center/100% 100% no-repeat; box-shadow: inset 0 1px #b8d2eb, 0 4px 0 #09172d; transition: filter .12s, transform .12s, box-shadow .12s; }
.action::after, .small::after, .nav::after, #touch button::after { content: ""; position: absolute; inset: 2px; border: 1px solid #ffffff36; border-radius: 5px 10px 5px 10px; pointer-events: none; }
.action:hover:not(:disabled), .small:hover:not(:disabled), .nav:hover:not(:disabled), #touch button:hover { filter: brightness(1.12) saturate(1.06); }
.action:active:not(:disabled), .small:active:not(:disabled), .nav:active:not(:disabled), #touch button:active { transform: translateY(3px); box-shadow: inset 0 1px #7a9aba, 0 1px 0 #09172d; }
.action:focus-visible, .small:focus-visible, .nav:focus-visible, #touch button:focus-visible { outline: 3px solid #fff; box-shadow: 0 0 0 6px #3d72c9, 0 4px 0 #09172d; }
.action.primary, .primary, .menu-buttons .launch { background-image: var(--material-cta); background-color: #ffc92e; color: #18233e; box-shadow: inset 0 1px #fff7b5, 0 4px 0 #7e4a12; }
.action:disabled, .small:disabled { filter: grayscale(.8); opacity: .7; background: #8294aa; box-shadow: inset 0 1px #d2dce8, 0 3px 0 #44556d; }
.action[aria-pressed="true"], .action.selected, .card[aria-selected="true"] { outline: 2px solid #ffdf36; box-shadow: 0 0 0 4px #315f97, 0 4px 0 #09172d; }

/* Cards and products read as prefab slots with title, art, stats, and footer. */
.card { position: relative; overflow: hidden; border: 4px solid var(--card-ink,#344963); border-radius: 10px 18px 10px 18px; background: linear-gradient(160deg,#ffffff,#d7e7f6); box-shadow: inset 0 1px #ffffff, 0 5px 0 #14263f, 0 10px 18px #10274636; padding: 9px; }
.card::before { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg,#ffffff55 0 26%,transparent 27% 72%,#1b426318 73%); pointer-events: none; }
.card-tag { position: relative; z-index: 1; border: 1px solid #ffffffaa; box-shadow: 0 2px 0 #192a44; }
.card-picture { position: relative; z-index: 1; border: 2px solid #aac8e3; background: radial-gradient(circle at 50% 32%,#ffffff,#bad4eb 74%); box-shadow: inset 0 2px 0 #ffffff, inset 0 -4px 0 #7f9fbe; }
.card b, .card strong, .card small { position: relative; z-index: 1; }
.product, .metric, .stat-tile, .option { border: 2px solid #8eafd0; border-radius: 8px 14px 8px 14px; background: linear-gradient(150deg,#f6fbff,#d8e9f8); box-shadow: inset 0 1px #ffffff, 0 3px 0 #8ba6c0; }
.product { position: relative; overflow: hidden; padding: 11px; }
.product::before { content: ""; position: absolute; inset: 0; background: linear-gradient(130deg,#ffffff55,transparent 38%); pointer-events: none; }
.product > * { position: relative; z-index: 1; }
.product > img { border: 2px solid #cce4f6; box-shadow: 0 3px 0 #365979; }

/* Toast, boss strip, progression, and touch controls remain inside the Canvas safe area. */
#toast { bottom: max(14%, calc(72px + env(safe-area-inset-bottom))); padding: 8px 14px; border: 3px solid #f4fbff; border-radius: 8px 16px 8px 16px; background: linear-gradient(#294a72,#132844); box-shadow: 0 5px 0 #09172d, inset 0 1px #ffffff66; font-weight: 800; }
#bossbar { padding: 5px 8px 7px; border: 2px solid #eef9ff; border-radius: 8px 14px 8px 14px; background: #132844dd; box-shadow: 0 4px 0 #09172d; }
#bossbar span { border: 2px solid #f4fbff; box-shadow: 0 2px 0 #3c1736; }
#bossbar progress { border: 2px solid #f4fbff; border-radius: 8px; overflow: hidden; background: #273a56; }
#touch button { width: 60px; height: 56px; }

/* Promotion prefab uses the real frame, glow, panel, and star sprites with a layered shell. */
#pet-promotion { filter: drop-shadow(0 12px 14px #071b3555); }
.promotion-announcement { border: 3px solid #12233d; box-shadow: 0 4px 0 #7e4a12, inset 0 1px #fff8b0; background: var(--material-cta) center/100% 100% no-repeat; }
.promotion-portrait > img { border: 3px solid #765e45; border-radius: 3px; background: #8e7c68; box-shadow: inset 0 2px #fff8, 0 3px 0 #493d36; }
.promotion-copy { text-shadow: 0 1px #fff8; font-weight: 800; }

@media (max-width: 680px) {
  #hud { grid-template-columns: 1fr auto; gap: 4px; }
  .hud-stats { max-width: 78vw; }
  #loadout { max-width: 78vw; }
  .panel { border-width: 9px; padding: 12px; }
  .panel::before { inset: 8px; }
  .card { border-width: 3px; padding: 7px; }
}
@media (max-width: 460px) {
  #hud { left: var(--canvas-safe-left); right: var(--canvas-safe-right); }
  .hud-stats, .hud-controls, #loadout { padding: 3px; border-width: 2px; }
  .stat { min-height: 30px; }
  .panel { border-width: 8px; }
  .promotion-card { border-width: 11px; border-image-width: 11px; }
}

/* S0 runtime Canvas. Geometry and color from the isolated source kit. */
:root {
  --ink:#1e293f; --muted:#465062; --outline:#c4d6e8;
  --paper:#fff; --sheet:#eaf5ff; --blue:#3c599c; --yellow:#ffdf36;
  --surface-shadow:0 8px 24px #203b5828;
  --ui-top:max(18px, env(safe-area-inset-top));
  --ui-edge:max(20px, env(safe-area-inset-left), env(safe-area-inset-right));
  --ui-bottom:max(18px, env(safe-area-inset-bottom));
  font-variant-numeric:tabular-nums;
}
[hidden] { display:none !important; }
#overlay { padding:var(--ui-top) var(--ui-edge) var(--ui-bottom); background:#fff6; backdrop-filter:blur(3px); }
#overlay[data-screen="menu"] { padding:0; background:none; backdrop-filter:none; }
#overlay[data-screen="reward"] { background:#ffffff73; }
#overlay:not([data-screen]) { background:linear-gradient(#eaf5ff,#caf1ff); }
.loading { color:var(--ink); text-shadow:none; }
.loading span, .eyebrow span { color:var(--blue); background:#eaf5ff; border:0; border-radius:4px; }
.muted { color:var(--muted); font-size:16px; }
.lobby-heading {
  top:var(--ui-top); left:var(--ui-edge); width:max-content; max-width:calc(58vw - var(--ui-edge));
  padding:16px 22px; color:var(--ink); text-shadow:none; border-radius:22px;
  background:#fffffff5; box-shadow:var(--surface-shadow);
}
.eyebrow { font-size:14px; }
.wordmark {
  font-size:clamp(36px,5vw,72px); letter-spacing:0; line-height:1.15;
  margin:2px 0 5px; transform-origin:left bottom; -webkit-text-stroke:0; text-shadow:none;
}
.lobby-heading p { font-size:16px; text-wrap:wrap; }
.lobby-balance, .panel header > .coin {
  color:var(--ink); background:#fff; border:1px solid var(--outline); border-radius:18px;
  box-shadow:var(--surface-shadow); min-height:38px;
}
.lobby-balance { top:var(--ui-top); right:var(--ui-edge); }
.lobby-balance > span:last-child { color:var(--blue); font-size:14px; }
.lobby-brief {
  left:var(--ui-edge); bottom:var(--ui-bottom); border:1px solid var(--outline); border-radius:18px;
  width:min(28vw,310px); color:var(--ink); padding:14px 16px; box-shadow:var(--surface-shadow);
}
.lobby-brief > span { color:var(--blue); background:var(--sheet); border-radius:6px; font-size:14px; }
.lobby-brief small { font-size:14px; }
.menu-buttons {
  right:var(--ui-edge); bottom:var(--ui-bottom); transform:none; width:clamp(250px,26vw,346px);
  border:1px solid #c4d6e8a0; border-radius:22px; padding:9px;
  background:#fffffff0; box-shadow:var(--surface-shadow); gap:8px;
}
.menu-buttons .launch { min-height:68px; padding:6px 20px 10px; justify-items:center; text-align:center; }
.launch span { font-size:32px; }
.launch small { font-size:14px; letter-spacing:0; color:var(--ink); }
.action, .small, .nav, #touch button {
  border:1px solid #a9c5e3; border-radius:14px;
  color:var(--ink); background:linear-gradient(#fff,#eaf5ff);
  box-shadow:0 3px #a8c5df; padding:7px 12px; min-height:44px; min-width:44px;
}
.action::after, .small::after, .nav::after, #touch button::after { content:none; }
.action:hover:not(:disabled), .small:hover:not(:disabled), .nav:hover:not(:disabled), #touch button:hover { filter:none; background-color:#e1efff; }
.action:active:not(:disabled), .small:active:not(:disabled), #touch button:active { transform:translateY(2px); box-shadow:0 1px #a8c5df; }
.action.primary, .primary, .menu-buttons .launch {
  isolation:isolate; background:none; border:0; box-shadow:none; color:var(--ink); overflow:visible; min-height:56px;
}
.action.primary::before {
  content:""; position:absolute; inset:0; z-index:-1; pointer-events:none;
  border:solid transparent;
  border-image:url(assets/sausage/ui-s0/button.png) 100 120 145 fill / 23px 26px 33px stretch;
}
.action:disabled { color:#465062; background:#e5ebf3; box-shadow:none; filter:none; }
.action:focus-visible, .small:focus-visible, .nav:focus-visible, #touch button:focus-visible, .card:focus-visible {
  outline:2px solid #fff; outline-offset:1px; box-shadow:0 0 0 5px var(--blue);
}
.action img, .small img, .nav img { width:24px; height:24px; }
.panel {
  border:0; border-radius:22px; background:none; box-shadow:none; padding:clamp(16px,2.5vw,28px);
}
.panel::before {
  inset:0; border:solid transparent; border-radius:0;
  border-image:url(assets/sausage/ui-s0/panel.png) 59 fill / 26px stretch;
  filter:drop-shadow(0 10px 18px #243c5c2d);
}
.panel header { border:0; padding:0; gap:10px; margin-bottom:10px; min-height:40px; }
.panel header h2, .panel h2 { filter:none; color:var(--ink); font-size:30px; line-height:1.2; padding:2px 8px 2px 0; }
h2::before { content:none; }
.panel header > .coin { background:var(--sheet); box-shadow:none; min-height:32px; font-size:16px; }
.collection-panel > .buttons, .reward-panel > .buttons { border-top:1px solid #dce8f6; }
.reward-panel { width:min(914px,100%); }
.reward-panel > .muted { margin-bottom:3px; }
.cards { gap:12px; }
.card {
  border:1px solid #b8cee8; border-radius:16px; padding:11px; background:#fff;
  box-shadow:0 4px #d8e6f4; gap:5px;
}
.card::before { background:none; }
.card:hover { border-color:var(--blue); }
.card-tag {
  width:max-content; max-width:100%; color:var(--card-ink); background:var(--card-light,#eaf5ff);
  border:0; border-radius:6px; box-shadow:none; font-size:14px; padding:2px 7px;
}
.card[data-family="red"] { --card-ink:#884152; --card-light:#ffe8ee; }
.card[data-family="dark"] { --card-ink:#4f427c; --card-light:#eee8fc; }
.card[data-family="pet"] { --card-ink:#176154; --card-light:#dff7ed; }
.card[data-family="relic"] { --card-ink:#714e16; --card-light:#fff5d7; }
.card-picture {
  background:linear-gradient(#f3f8ff,var(--card-light,#e8f3ff));
  border:1px solid #c7dcf4; border-radius:12px; min-height:106px; box-shadow:none;
}
.card-picture img { width:104px; height:96px; object-fit:contain; filter:none; }
.card-picture .asset-gap { font-size:14px; color:var(--muted); text-align:center; }
.card strong { font-size:22px; line-height:1.22; }
.card small { font-size:16px; line-height:1.4; }
.card-stars, .promotion-stars { display:flex; gap:3px; width:max-content; padding:3px 5px; background:#3c599c; border-radius:7px; }
.card-stars img, .promotion-stars img { width:14px; height:14px; object-fit:contain; filter:none; }
#hud { top:var(--ui-top); left:var(--ui-edge); right:var(--ui-edge); gap:6px 10px; }
.hud-stats, .hud-controls, #loadout {
  padding:0; border:0; background:none; box-shadow:none; gap:5px; max-width:100%;
}
.hud-stats { width:max-content; }
.stat, .stat.health, .stat.score, .loadout-item {
  min-height:36px; padding:4px 8px; color:var(--ink); border:1px solid #c0d8ed;
  border-radius:12px; background:#fffffffa; box-shadow:0 2px #183b5d22; font-size:14px;
}
.stat.health { background:#fff0f3; color:#8a3151; }
.stat img { width:24px; height:24px; }
.stat .hud-key { color:var(--blue); }
.loadout-item { width:38px; height:38px; }
.loadout-item img { inset:2%; width:96%; height:96%; }
.loadout-item strong { color:var(--ink); text-shadow:none; background:#fff; border-radius:4px; padding:0 2px; }
.loadout-item .asset-gap { font-size:12px; margin-bottom:7px; }
.loadout-item.loadout-text {
  display:inline-flex; align-items:center; gap:5px; width:auto; max-width:100%; height:auto;
  min-width:0; line-height:1.25; padding:4px 7px; font-size:12px;
}
.loadout-text .loadout-name { min-width:0; overflow-wrap:anywhere; }
.loadout-item.loadout-text strong {
  position:static; flex:none; padding:1px 4px; background:#e7f2ff; color:var(--ink);
}
#bossbar {
  top:var(--ui-top); padding:5px 10px 6px; border:1px solid #bbd2e8;
  border-radius:13px; color:var(--ink); background:#fffffffa; box-shadow:var(--surface-shadow);
}
#bossbar span { color:#8a3151; background:none; border:0; box-shadow:none; padding:0; }
#bossbar progress {
  width:clamp(135px,19vw,240px); height:9px; border:0; border-radius:6px; background:#f4d7e1;
}
#bossbar progress::-webkit-progress-bar { background:#f4d7e1; }
#bossbar progress::-webkit-progress-value { background:#b84569; border-radius:6px; }
#boss-progress { top:24%; left:var(--ui-edge); width:16px; height:min(39vh,286px); }
.progress-track { border:1px solid #aac8e4; background:#f7fbff; box-shadow:0 2px #183b5d22; }
.progress-fill { inset:2px 3px; background:#efc93c; }
.progress-marks { inset:5px; background:repeating-linear-gradient(to top,#fff0 0 6.05%,#476d972c 6.05% 6.26%); }
#boss-progress .progress-hero { width:21px; }
#toast { color:var(--ink); background:#fffffff5; border:1px solid #b4cee9; box-shadow:var(--surface-shadow); border-radius:14px; }
.world-label {
  color:var(--ink); background:#f7fbfff5; padding:2px 5px; border:1px solid #b5cbe4;
  border-radius:9px; font-size:14px; line-height:1.25; text-shadow:none; -webkit-text-stroke:0;
  translate:var(--label-offset,0px) var(--label-rise,0px);
}
.world-label[data-ui-obscured] { visibility:hidden; }
.world-label[data-sign="plus"] { color:#145941; background:#eafff5; border-color:#80c9ab; }
.world-label[data-sign="minus"], .boss-life { color:#822e4c; background:#fff0f5; border-color:#e2a7bc; }
.loot-label { border-color:#debe6d; background:#fff7d9; }
/* FX line: damage numbers, the player's red loss number and the three screen-edge layers.
   Owner: effects line. To be placed in styles.css by the merge (replacing the UI line's .damage / .crit / .heal rules). */
:root { --fx-damage-numbers: 1; }
#labels .world-label.damage, #labels .world-label.crit, #labels .world-label.heal, #labels .world-label.fx-hurt-number { font-family: inherit; font-weight: 900; padding: 0; border: 0; background: none;
  line-height: 1; letter-spacing: .5px; transform-origin: 50% 60%; paint-order: stroke fill; }
#labels .world-label.damage { font-size: 21px; color: #fff; -webkit-text-stroke: 4px #1b2a4a; text-shadow: 0 3px 0 #1b2a4a; z-index: 2; }
#labels .world-label.damage.sword-damage { color: #c9f1ff; -webkit-text-stroke: 4px #15406e; text-shadow: 0 3px 0 #15406e; }
#labels .world-label.damage.pet-damage { color: #ffd08a; -webkit-text-stroke: 4px #6e3410; text-shadow: 0 3px 0 #6e3410; }
#labels .world-label.crit { font-size: 34px; font-style: italic; color: #ffe44a; -webkit-text-stroke: 5px #b3260c; text-shadow: 0 4px 0 #b3260c; z-index: 3; }
#labels .world-label.heal { font-size: 19px; color: #8dffb9; -webkit-text-stroke: 4px #0d5a3a; text-shadow: 0 3px 0 #0d5a3a; z-index: 2; }
#labels .world-label.fx-hurt-number { font-size: 27px; color: #ff4a3c; -webkit-text-stroke: 5px #fff; text-shadow: 0 3px 0 #7a0c08; transform-origin: 0 50%; z-index: 4; }
#v4fx-screen, #v4fx-screen > i { position: absolute; inset: 0; pointer-events: none; display: block; }
#v4fx-screen { z-index: 1; overflow: hidden; }
#v4fx-dim { background: linear-gradient(90deg, rgba(8,10,26,.78) 0%, rgba(8,10,26,0) 24%, rgba(8,10,26,0) 76%, rgba(8,10,26,.78) 100%), linear-gradient(180deg, rgba(8,10,26,.5) 0%, rgba(8,10,26,0) 22%); opacity: 0; }
#v4fx-hurt { background: radial-gradient(ellipse at 50% 50%, rgba(235,24,34,0) 66%, rgba(235,24,34,.22) 84%, rgba(225,16,28,.58) 100%); opacity: 0; }
#v4fx-gold { background: radial-gradient(ellipse at 50% 55%, rgba(255,214,90,0) 64%, rgba(255,214,90,.26) 100%); opacity: 0; }
#touch { left:var(--ui-edge); right:var(--ui-edge); bottom:var(--ui-bottom); }
#touch button { width:60px; height:54px; }
.promotion-card {
  border:0; border-image:none; border-radius:0; padding:8%; background:none; box-shadow:none;
}
.promotion-card::before {
  inset:0; opacity:1; background:#eaf5ff;
  border:solid transparent; border-image:url(assets/sausage/ui-s0/frame.png) 96 / 14px stretch; border-radius:10px;
}
.promotion-portrait { display:grid; gap:5px; justify-items:center; align-content:center; font-size:12px; }
.promotion-card > .promotion-glow { position:absolute; width:44%; max-width:82px; z-index:0; }
.promotion-stars { color:inherit; }
.promotion-copy { color:var(--ink); text-shadow:none; font-size:14px; }
@media(max-width:1024px) and (min-width:600px) {
  #bossbar { top:calc(var(--ui-top) + 52px); }
}
@media(max-width:599px) {
  :root { --ui-top:max(12px,env(safe-area-inset-top)); --ui-edge:max(12px,env(safe-area-inset-left),env(safe-area-inset-right)); --ui-bottom:max(12px,env(safe-area-inset-bottom)); }
  .lobby-heading { top:calc(var(--ui-top) + 53px); left:var(--ui-edge); max-width:calc(100% - 2 * var(--ui-edge)); width:max-content; padding:9px 12px; }
  .wordmark { font-size:38px; line-height:1.15; margin:1px 0; }
  .lobby-heading p, .muted { font-size:14px; }
  .eyebrow, .lobby-balance > span:last-child { font-size:12px; }
  .lobby-balance { min-width:70px; padding:4px 7px; }
  .menu-buttons { left:var(--ui-edge); right:var(--ui-edge); width:auto; bottom:var(--ui-bottom); padding:8px; gap:6px; }
  .menu-buttons .launch { min-height:56px; }
  .launch span { font-size:26px; }
  .menu-buttons .action, .launch small { font-size:14px; }
  .lobby-brief { display:none; }
  .panel { padding:14px; }
  .panel header h2, .panel h2 { font-size:24px; }
  .reward-panel { max-height:100%; display:flex; flex-direction:column; }
  .reward-panel > :not(.cards) { flex:none; }
  .cards { grid-template-columns:1fr; overflow:auto; overscroll-behavior:contain; gap:7px; padding:3px 4px 6px; margin:5px -4px 0; min-height:0; }
  .card {
    display:grid; grid-template-columns:76px minmax(0,1fr); grid-template-rows:auto auto 1fr;
    grid-template-areas:"picture tag" "picture name" "picture values"; min-height:92px;
    column-gap:9px; row-gap:2px; padding:7px 8px;
  }
  .card-tag { grid-area:tag; font-size:12px; }
  .card-picture { grid-area:picture; min-height:74px; align-content:center; }
  .card-picture img { width:72px; height:72px; }
  .card-picture .asset-gap { font-size:12px; }
  .card strong { grid-area:name; font-size:18px; }
  .card small { grid-area:values; font-size:14px; }
  .card > .card-stars { grid-column:2; }
  .card-stars img, .promotion-stars img { width:12px; height:12px; }
  .reward-panel > .buttons { gap:6px; padding-top:8px; margin-top:5px; }
  .reward-panel > .buttons .action { font-size:14px; }
  #hud { grid-template-columns:minmax(0, 1fr) auto; grid-template-areas:"stats stats" "loadout controls"; gap:6px; }
  .hud-stats { justify-content:space-between; width:100%; }
  .stat { min-height:32px; padding:3px 5px; gap:2px; font-size:12px; }
  .stat img { width:18px; height:18px; }
  .hud-controls .small { font-size:14px; }
  #loadout { max-inline-size:100%; }
  #bossbar { top:calc(var(--ui-top) + 90px); font-size:14px; }
  #boss-progress { top:25%; left:max(7px,env(safe-area-inset-left)); width:12px; height:min(32vh,245px); }
  #boss-progress .progress-hero { width:17px; }
  .world-label { font-size:12px; }
  #touch button { width:56px; height:52px; }
}
@media(prefers-reduced-motion:reduce) {
  button, .action, .small, .card, #touch button { transition:none; }
}


/* Legibility on light surfaces and narrow stat groups. */
.menu-buttons img, .hud-stats img, .stat-tile img {
  filter:drop-shadow(0 0 1px #24446c70);
}
.menu-buttons [data-action="records"] img, .menu-buttons [data-action="settings"] img,
.hud-stats img[src$="sword.png"] { filter:brightness(.55) saturate(1.35); }
.stat-tile { font-size:14px; border-radius:10px; }
.stat-tile[data-text-only] { grid-template-columns:minmax(0,1fr); }
.stat-group h3 { font-size:16px; }
.pause-layout .buttons { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
.pause-layout .buttons > .action { white-space:nowrap; }
#toast { left:auto; right:calc(var(--ui-edge) + 8vw); transform:none; bottom:calc(var(--ui-bottom) + 60px); }
@media(max-width:599px) {
  .stat-tile { font-size:12px; }
  .stat-group h3 { font-size:14px; }
  #toast { right:var(--ui-edge); bottom:calc(var(--ui-bottom) + 65px); }
}
.price-refresh, .price-shop { color:#654713; }
.price-short, .price.price-short { color:#861d42; }
.card:hover::after, .card:focus-visible::after {
  content:""; position:absolute; inset:0; pointer-events:none;
  border:solid transparent;
  border-image:url(assets/sausage/ui-s0/frame.png) 96 / 15px stretch;
}

/* Bound card sprites to their source resolution at DPR 2. */
.card-picture img[data-ui-asset="ui-clean/medkit.png"] { max-width: 46px; max-height: 37.5px; }
.card-picture img[data-ui-asset="ui-clean/holy-sword.png"] { max-width: 57.5px; max-height: 57px; }
.card-picture img[data-ui-asset="ui-clean/glove.png"] { max-width: 18px; max-height: 12.5px; }
.card-picture img[data-ui-asset="ui-clean/impact-shield.png"] { max-width: 21.5px; max-height: 20px; }
.card-picture img[data-ui-asset="icons/sword.png"] { max-width: 31px; max-height: 27px; }
.card-picture img[data-ui-asset="icons/heart.png"] { max-width: 12px; max-height: 9.5px; }
.card-picture img[data-ui-asset="icons/gold.png"] { max-width: 70.5px; max-height: 69.5px; }
.card-picture img[data-ui-asset="ui-s0/burst.png"] { max-width: 100px; max-height: 100px; }
.card-picture img[data-ui-asset="ui-s0/target.png"] { max-width: 51px; max-height: 51px; }
.product > img[data-ui-asset="ui-s0/target.png"] { background: var(--sheet); }
.product > img[data-ui-asset="ui-clean/glove.png"], .product > img[data-ui-asset="ui-clean/impact-shield.png"] { width:40px; height:34px; padding:7px 9px; }


/* GoldDash source pieces with a new layout for the island route. */
:root {
  --field: #222a2e;
  --field-deep: #151d22;
  --paper: #f5ebd0;
  --paper-ink: #282822;
  --signal: #ffd34b;
  --line-brass: #e5b840;
  --lobby-left: max(32px, 5.5vw, env(safe-area-inset-left));
}
.lobby-heading, .lobby-balance, .lobby-brief, .menu-buttons {
  position:absolute; color:var(--paper); box-shadow:none;
}
.lobby-heading {
  left:var(--lobby-left); top:clamp(48px,14vh,118px); width:min(470px,44vw); max-width:none;
  padding:20px 25px 23px; border:1px solid #4c574d; border-left:5px solid var(--signal);
  border-radius:2px 26px 2px 2px; background:
    linear-gradient(transparent 25%,#262d2788),
    url("assets/sausage/ui-reset/header-dots.png") right bottom / 110px auto no-repeat,
    linear-gradient(118deg,#242a26 25%,#313b33);
}
.lobby-heading .eyebrow { color:var(--signal); font-size:13px; letter-spacing:.16em; }
.lobby-heading .eyebrow span { background:none; color:inherit; padding:0; }
.lobby-heading .wordmark {
  margin:4px 0 7px; color:#fff6dc; font-size:clamp(42px,6vw,80px); line-height:1;
  letter-spacing:-.055em; text-shadow:2px 5px #12191a;
}
.lobby-heading p { color:#f6ecc9; margin:9px 0 0; font-size:16px; line-height:1.45; }
.lobby-balance {
  top:var(--ui-top); right:var(--ui-edge); min-width:106px; padding:7px 12px;
  background:var(--field); border:1px solid #d5bb74; border-radius:5px; gap:5px;
}
.lobby-balance .coin, .lobby-balance > span:last-child { color:#ffe697; }
.lobby-brief { display:none; }
.menu-buttons {
  left:var(--lobby-left); right:auto; bottom:max(31px,env(safe-area-inset-bottom));
  width:min(455px,48vw); grid-template-columns:repeat(4,minmax(0,1fr)); gap:5px;
  padding:8px; border:1px solid #7c7762; border-top:2px solid #897044; border-radius:5px 16px 5px 5px;
  background:var(--field-deep);
}
.menu-buttons .action:not(.launch) {
  display:grid; align-content:center; justify-items:center; gap:3px; white-space:normal;
  min-height:66px; padding:5px; color:#fff6dc; border:1px solid #69716d;
  border-radius:4px 11px 4px 4px; background:#30383a url("assets/sausage/ui-reset/dock.png") center/100% 100% no-repeat;
  box-shadow:none; font-size:14px; line-height:1.18;
}
.menu-buttons .action:not(.launch):hover { border-color:var(--signal); background-color:#434a40; }
.menu-buttons .action:not(.launch) img { width:22px; height:22px; object-fit:contain; filter:none; }
.menu-buttons .launch {
  grid-column:1/-1; min-height:68px; padding:5px 16px; justify-items:start;
  color:#251d13; text-shadow:none; border:1px solid #ffdc58; border-radius:12px;
  background:#ffbc19 url("assets/sausage/ui-reset/launch.png") center / 100% 100% no-repeat;
  box-shadow:0 3px #5f4d21; line-height:1.18;
}
.menu-buttons .launch span { font-size:28px; }
.menu-buttons .launch small { color:#392a15; font-size:13px; }

#hud { top:var(--ui-top); gap:5px 9px; }
.hud-stats {
  width:max-content; max-width:100%; flex-wrap:nowrap; gap:0;
  border:1px solid #718078; border-left:3px solid var(--signal); border-radius:3px 10px 3px 3px;
  background:#20282a url("assets/sausage/ui-reset/panel.png") 50% 50%/100% 100% no-repeat;
  box-shadow:0 2px #151d2277; padding:0;
}
.hud-stats .stat {
  color:#fff3cc; margin:0; min-width:0; min-height:36px; gap:4px; padding:4px 9px;
  border:0; border-right:1px solid #e3e5dd36; border-radius:0; background:none; box-shadow:none;
}
.hud-stats .stat:last-child { border-right:0; }
.hud-stats .stat.health { color:#ffd2c5; }
.hud-stats .stat .hud-key { color:#f3db91; }
.hud-stats .stat img { width:22px; height:22px; filter:drop-shadow(0 1px #151d22); }
.hud-controls { gap:4px; }
.hud-controls .small, #touch button {
  color:#fff3d0; border:1px solid #9a9279; border-radius:3px 9px 3px 3px;
  background:#252e30 url("assets/sausage/ui-reset/dock.png") center/100% 100% no-repeat;
  box-shadow:0 2px #141d20;
}
.hud-controls .small { min-height:44px; padding-inline:8px; }
.hud-controls [data-action="pause"] img { width:22px; height:22px; }
#loadout .loadout-item {
  background:#27302f; color:#fff2d3; border:1px solid #ac9664; border-radius:3px 7px 3px 3px;
}
#loadout .loadout-item strong { background:#f6dfa0; color:#211c15; }
#bossbar {
  background:var(--field) url("assets/sausage/ui-reset/strip.png") center/100% 100% no-repeat;
  border:1px solid #948456; border-radius:4px; box-shadow:0 2px #171f22;
}
#bossbar span { color:#ffeed8; }
#bossbar progress { background:#634541; }
#bossbar progress::-webkit-progress-bar { background:#634541; }
#bossbar progress::-webkit-progress-value {
  background:#ffbd40 url("assets/sausage/ui-reset/bar.png") left center / auto 100% repeat-x;
}
.progress-track { background:#273231; border:1px solid #e5d3a0; }
.progress-fill { background:var(--signal); }
.progress-marks { background:repeating-linear-gradient(to top,#fff0 0 6.05%,#eddeb8a0 6.05% 6.26%); }
.world-label.gate-label {
  color:#fff0bb; background:#29332e; border:1px solid #ddba57; border-left:3px solid #dab340; border-radius:2px 6px 2px 2px;
  font-size:clamp(12px,1.2vw,15px);
}
.world-label.gate-label[data-sign="minus"] { color:#ffe0d6; background:#3e2829; border-color:#d99883; }
.world-label.loot-label { color:#44341c; background:#fff0c2; border-color:#bf9b36; border-radius:4px; }
.world-label.enemy-life, .world-label.boss-life { border-radius:4px; }
#toast { border-radius:4px 10px 4px 4px; color:#312a1c; background:#f7e7b7; border-color:#c5a354; }
#touch button img { filter:brightness(0) invert(1); width:26px; height:26px; }

#overlay:not([data-screen="menu"]):not([hidden]) {
  background:#11181d85; backdrop-filter:none;
}
.panel {
  padding:18px; color:var(--paper-ink); border:1px solid #b29b65; border-radius:4px 18px 4px 4px;
  background:#eee4c9; box-shadow:0 6px 24px #111a1d77;
}
.panel::before { content:none; }
.panel > header {
  min-height:53px; margin:-14px -14px 10px; padding:10px 14px; color:#fbebc5;
  background:#262f30 url("assets/sausage/ui-reset/combat-summary.png") center/cover no-repeat;
  border-radius:3px 17px 0 0; border-bottom:3px solid var(--line-brass);
}
.panel > header h2 { color:inherit; text-shadow:none; }
.panel > header .coin { color:#fff0b4; background:#343a2c; border:1px solid #ab9560; border-radius:4px; }
.panel .muted { color:#4d4535; }
.panel .action {
  color:#f7ebc6; border:1px solid #6b684e; border-radius:3px 8px 3px 3px;
  background:#333a34 url("assets/sausage/ui-reset/panel.png") center/100% 100% no-repeat;
  box-shadow:0 2px #231f17; min-height:44px;
}
.panel .action.primary { color:#2d2211; background:#ffc939 url("assets/sausage/ui-reset/launch.png") center/100% 100% no-repeat; }
.panel .action:disabled { color:#474236; background:#d7cbb0; border-color:#a99f86; box-shadow:none; opacity:1; }
.panel .action:hover:not(:disabled), .hud-controls .small:hover, #touch button:hover { filter:brightness(1.12); background-color:#444940; }
.panel .action:focus-visible, .menu-buttons .action:focus-visible, .card:focus-visible, .hud-controls .small:focus-visible, #touch button:focus-visible {
  outline:3px solid #ffd34b; outline-offset:3px; box-shadow:0 0 0 2px #181c18;
}
.panel .option, .product, .metric, .stat-tile {
  background:#fff7de; border:1px solid #baaa80; border-radius:2px 7px 2px 2px; box-shadow:none;
}
.panel .option input { accent-color:#9b6813; }
.panel .status-chip.success { background:#d4e7ca; color:#25432d; }
.panel .status-chip:not(.success) { background:#57553c; color:#fff1c7; }
.panel .product > img { background:#3e443d; border-color:#b8ac87; box-shadow:none; }

.reward-panel {
  --accent:#e5b840; width:min(960px, 100%); background:#282e2d; color:#fff1c9;
  border-color:#a68d50; box-shadow:0 9px 30px #111414c2;
}
.reward-panel > header { background:
    linear-gradient(90deg,transparent 60%,#20272899),
    url("assets/sausage/ui-reset/header-dots.png") center right/134px auto no-repeat,
    #202728; }
.reward-panel > header h2 { display:flex; align-items:center; gap:9px; }
.reward-panel .reward-icon { width:33px; height:25px; object-fit:contain; }
.reward-panel > .muted { color:#eee0b6; }
.reward-panel .buttons { border-color:#a99155; }
.reward-panel .cards { align-items:stretch; }
.reward-panel .card {
  --card-hue:#415c70; --card-tint:#e4ebd7;
  color:var(--paper-ink); border:2px solid #d0c39a; border-left:6px solid var(--card-hue);
  border-radius:5px 13px 5px 5px; background:#f4ebd0;
  box-shadow:0 3px #161c18; min-width:0; text-align:left;
}
.reward-panel .card[data-family="blue"] { --card-hue:#2c6377; --card-tint:#dce9e3; }
.reward-panel .card[data-family="dark"] { --card-hue:#594675; --card-tint:#e9deef; }
.reward-panel .card[data-family="red"] { --card-hue:#a74436; --card-tint:#eeded0; }
.reward-panel .card[data-family="relic"] { --card-hue:#885923; --card-tint:#f7e7ad; }
.reward-panel .card:hover, .reward-panel .card:focus-visible { border-color:var(--signal); border-left-color:var(--card-hue); }
.reward-panel .card:active { box-shadow:0 1px #161c18; }
.reward-panel .card-tag {
  background:var(--card-hue); color:#fff7e0; border:0; border-radius:2px 7px 2px 2px;
  letter-spacing:.02em; padding:3px 7px; justify-self:start;
}
.reward-panel .card-picture {
  min-height:120px; padding:3px; margin:4px 0;
  border:1px solid #9c977a; border-radius:4px; box-shadow:inset 0 1px #fff9;
  background:var(--card-tint) url("assets/sausage/ui-reset/ticket.png") center/100% 100% no-repeat;
}
.reward-panel .card-picture img[data-weapon-card] { width:104px; height:104px; }
.reward-panel .card strong { color:#2c2922; font-size:22px; line-height:1.2; }
.reward-panel .card small,.reward-panel .card-picture .asset-gap { color:#4b4338; }
.reward-panel .card-stars { background:#353a34; border-color:#5d5641; }

@media (min-width:600px) {
  .panel > header { margin-top:-18px; margin-inline:-18px; padding-inline:18px; }
  .reward-panel { width:min(860px, 100%); }
}
@media (max-width:599px) {
  :root { --lobby-left:var(--ui-edge); }
  .lobby-heading { top:var(--ui-top); width:calc(100% - 2 * var(--ui-edge)); padding:9px 12px 11px; }
  .lobby-balance { min-width:59px; padding:5px 7px; margin:9px 9px 0 0; }
  .lobby-heading .wordmark { font-size:clamp(34px,10vw,44px); }
  .lobby-heading p { font-size:13px; margin-top:7px; }
  .menu-buttons { left:var(--ui-edge); right:var(--ui-edge); width:auto; bottom:var(--ui-bottom); padding:6px; }
  .menu-buttons .action:not(.launch) { min-height:54px; font-size:12px; }
  .menu-buttons .launch { min-height:61px; }
  .menu-buttons .launch span { font-size:24px; }
  .hud-stats { justify-content:space-between; }
  .hud-stats .stat { min-height:32px; padding:3px 5px; gap:2px; font-size:12px; }
  .hud-stats .stat img { width:17px; height:17px; }
  #bossbar { top:calc(var(--ui-top) + 88px); }
  .reward-panel .cards { gap:8px; }
  .reward-panel .card { grid-template-columns:74px minmax(0,1fr); padding:7px 9px 7px 6px; column-gap:9px; }
  .reward-panel .card-picture { min-height:74px; margin:0; padding:2px; }
  .reward-panel .card-picture img[data-weapon-card] { width:68px; height:68px; }
  .reward-panel .card strong { font-size:18px; }
  .reward-panel .card small { font-size:13px; }
  .panel { padding:14px; }
  .panel > header h2 { font-size:23px; }
  .panel .action { font-size:14px; }
}


@font-face {
  font-family:Island;
  src:url("assets/sausage/ui-reset/controls.woff2") format("woff2");
  font-weight:400 900;
  font-display:swap;
  unicode-range:U+89E6,U+5C4F;
}

/* Island departure / combat / choice: separate surfaces for separate actions. */
:root {
  --sea-ink: #192e4d;
  --sea-muted: #425873;
  --frost: #f4faff;
  --sand: #fff4d7;
  --sea-edge: #94b6d5;
}
.lobby-heading {
  width:max-content; max-width:min(38vw,485px); padding:11px 15px 13px;
  top:clamp(28px,11vh,90px); border:1px solid #afd0e4; border-left:4px solid #f2ba3d;
  border-radius:14px 23px 14px 14px; background:#f7fbfff5; color:var(--sea-ink);
  box-shadow:0 3px 10px #173c6533;
}
.lobby-heading .eyebrow, .lobby-heading .eyebrow span { color:#526c8a; }
.lobby-heading .wordmark { color:var(--sea-ink); font-size:clamp(34px,4.5vw,57px); letter-spacing:-.03em; text-shadow:0 2px #fff; }
.lobby-heading p { color:#334c69; margin-top:6px; font-size:16px; }
.lobby-balance { color:var(--sea-ink); background:#fff8e7; border-color:#ceaa50; border-radius:12px; }
.lobby-balance .coin, .lobby-balance > span:last-child { color:var(--sea-ink); }
.menu-buttons {
  background:#edf6ffef; border:1px solid #a3bfd7; border-radius:15px;
  box-shadow:0 3px 9px #132d4c40;
}
.menu-buttons .action:not(.launch) {
  color:var(--sea-ink); border:1px solid #b3cbe1; border-radius:11px;
  background:#f9fcff; box-shadow:0 2px #b3cbe1;
}
.menu-buttons .action:not(.launch) img {
  filter:brightness(0) saturate(100%) invert(19%) sepia(18%) saturate(1800%) hue-rotate(178deg);
}
.menu-buttons .action[data-action="achievements"] img { filter:none; }
.menu-buttons .action:not(.launch):hover { border-color:#5990c0; background:#deeefa; }
.menu-buttons .launch {
  position:relative; isolation:isolate; border:0; border-radius:13px; color:#3b260d;
  background:none; box-shadow:none; min-height:67px;
  place-items:center; padding-block:9px 15px;
}
.menu-buttons .launch::before {
  content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; border:solid transparent;
  border-image:url(assets/sausage/ui-s0/button.png) 100 120 145 fill / 23px 26px 28px stretch;
}
.menu-buttons .launch:hover { filter:brightness(1.08); }
.menu-buttons .launch:active { transform:translateY(2px); }
.menu-buttons .launch small { color:#473012; }
.menu-buttons .action:focus-visible, .hud-controls .small:focus-visible, #touch button:focus-visible {
  outline:3px solid #205889; outline-offset:2px; box-shadow:0 0 0 2px #fff;
}

.hud-stats {
  box-sizing:border-box; width:max-content; max-width:100%; border:0; padding:0;
  border-radius:0; box-shadow:none; background:none; gap:6px; justify-content:flex-start;
}
.hud-stats .stat.health {
  color:#843452; min-height:43px; min-width:79px; gap:5px; padding:4px 8px;
  background:#fff0f2; border:1px solid #d792a9; border-radius:13px;
  box-shadow:0 2px #9e50652e; font-size:22px; line-height:1;
}
.hud-stats .stat.health img { width:23px; height:23px; }
.hud-stats .hud-readings {
  display:flex; align-items:center; background:#f2f9ffeF; border:1px solid #9cbdd6;
  border-radius:11px; padding:0 3px; min-width:0;
}
.hud-stats .stat:not(.health) {
  color:var(--sea-ink); border-right:1px solid #bfd1e3; min-height:31px; padding:3px 7px;
}
.hud-stats .stat:last-child { border-right:0; }
.hud-stats .stat strong { color:inherit; font-variant-numeric:tabular-nums; }
.hud-stats .stat .hud-key { color:#375474; }
.hud-stats .stat img { filter:none; }
.hud-stats .stat:has(#swords) img {
  filter:brightness(0) saturate(100%) invert(28%) sepia(30%) saturate(960%) hue-rotate(176deg);
}
.hud-controls .small, #touch button {
  color:var(--sea-ink); background:#edf7ff; border:1px solid #8cadae; border-radius:12px;
  box-shadow:0 2px #8da9bf;
}
.hud-controls .small:hover, #touch button:hover { filter:none; background:#def0fb; }
.hud-controls [data-action="pause"] img { filter:brightness(0) saturate(100%) invert(18%) sepia(18%) saturate(2500%) hue-rotate(181deg); }
#touch button img { filter:none; }
#loadout .loadout-item { color:#254061; background:#eff7fff5; border-color:#a8c9e4; border-radius:9px; }
#bossbar { background:#fff3f3; border:1px solid #d69aab; border-radius:12px; box-shadow:0 2px #88445c38; }
#bossbar span { color:#8a3151; }
#bossbar progress, #bossbar progress::-webkit-progress-bar { background:#ead0d7; }
#bossbar progress::-webkit-progress-value { background:#b64868; }
.progress-track { background:#e9f6ff; border-color:#9dbbd6; }
.progress-marks { background:repeating-linear-gradient(to top,#fff0 0 6.05%,#83a7c3a0 6.05% 6.26%); }
.world-label.gate-label {
  color:#183a5b; background:#eaf5ff; border:1px solid #86adce; border-left:3px solid #4d7ca0;
  border-radius:6px; box-shadow:0 1px #1a385b44;
}
.world-label.gate-label[data-sign="plus"] { color:#164b3b; background:#eafff5; border-color:#69aa93; }
.world-label.gate-label[data-sign="minus"] { color:#772842; background:#fff0f3; border-color:#c886a0; }
.world-label.loot-label { color:#613e10; background:#fff1c3; border:1px solid #bc9140; border-radius:9px; }
.world-label.gate-label, .world-label.loot-label { font-size:14px; }

#overlay:not([data-screen="menu"]):not([hidden]) { background:#10293b69; }
.panel {
  color:var(--sea-ink); background:#f1f8ff; border:1px solid #a9c6df; border-radius:17px;
  box-shadow:0 5px 22px #132a4782;
}
.panel > header {
  color:var(--sea-ink); background:#e3f0fc; border-radius:16px 16px 0 0;
  border-bottom:2px solid #a6c4de;
}
.panel > header .coin { color:var(--sea-ink); background:#fff5d7; border-color:#bd9b57; border-radius:8px; }
.panel .muted, .reward-panel > .muted { color:var(--sea-muted); font-size:16px; }
.panel .option, .panel .product, .panel .stat-tile, .panel .metric {
  background:#faffff; border-color:#b9d1e5; border-radius:8px;
}
.panel .action {
  color:var(--sea-ink); border:1px solid #8caecb; border-radius:10px; background:#e0effb;
  box-shadow:0 2px #9fbdd8;
}
.panel .action:hover:not(:disabled) { background:#cde4f7; filter:none; }
.panel .action.primary, .panel .action.primary:hover:not(:disabled) { color:#3a240b; background:#ffd760; border-color:#c49c3d; }
.panel .action:disabled { background:#e5ebf3; color:#4e5d6e; border-color:#b5c3d0; }
.panel .action:focus-visible, .reward-panel .card:focus-visible {
  outline:3px solid #235e91; outline-offset:2px; box-shadow:0 0 0 2px white;
}
.reward-panel { width:min(920px,100%); }
.reward-panel > header h2 { color:#193354; }
.reward-panel .reward-icon {
  filter:brightness(0) saturate(100%) invert(19%) sepia(35%) saturate(1300%) hue-rotate(179deg);
}
.reward-panel .buttons { border-color:#b2ccdf; }
.reward-panel .cards { align-items:stretch; gap:12px; }
.reward-panel .card {
  --card-hue:#3d6682; --card-tint:#e2eef7;
  display:grid; grid-template-columns:minmax(0,1fr); grid-template-rows:auto auto auto 1fr;
  grid-template-areas:"head" "art" "name" "stats";
  align-content:start; padding:11px; gap:8px;
  background:#fffbef; color:var(--sea-ink);
  border:1px solid #b9a97f; border-top:4px solid var(--card-hue); border-radius:12px;
  box-shadow:0 3px #9c8b6040;
}
.reward-panel .card[data-family="blue"] { --card-hue:#27637f; --card-tint:#e0f1f6; }
.reward-panel .card[data-family="dark"] { --card-hue:#674a81; --card-tint:#eee8f7; }
.reward-panel .card[data-family="red"] { --card-hue:#963e31; --card-tint:#fae9de; }
.reward-panel .card:hover, .reward-panel .card:focus-visible { border-color:#ae965d; border-top-color:var(--card-hue); background:#fff5dc; }
.reward-panel .card-head { grid-area:head; display:flex; align-items:center; justify-content:space-between; min-width:0; gap:6px; }
.reward-panel .card-tag { font-size:14px; color:#fff; background:var(--card-hue); border-radius:6px; padding:3px 6px; }
.reward-panel .card-stars { flex:none; margin:0; background:#314861; }
.reward-panel .card-picture { grid-area:art; min-height:118px; margin:0; padding:4px; border-radius:9px; border:1px solid #bdcad5; background-color:var(--card-tint); }
.reward-panel .card-picture img[data-weapon-card] { width:106px; height:106px; }
.reward-panel .card strong { grid-area:name; margin:0; color:var(--sea-ink); }
.reward-panel .card .card-effects {
  grid-area:stats; align-self:start; display:flex; flex-wrap:wrap; gap:3px 7px;
  color:#294361; font-size:16px; line-height:1.45;
}
.reward-panel .card .effect-unit { white-space:nowrap; max-width:100%; padding-inline:4px; background:#f0f4f6; border-radius:4px; }
.reward-panel .effect-unit b { color:#1b3958; }
.reward-panel .effect-unit[data-effect=gain] b { color:#1d6050; }
.reward-panel .effect-unit[data-effect=cost] b { color:#8b2948; }
.reward-panel .effect-phrase { max-width:100%; }
.reward-panel .mode-line { display:inline-flex; gap:6px; align-items:center; font-size:12px; line-height:1.1; }
.reward-panel .mode-line em { font-style:normal; font-weight:bold; }
.reward-panel .mode-mark { position:relative; width:22px; height:19px; display:inline-grid; place-items:center; background:#fff; color:var(--card-hue); border:1px solid currentColor; border-radius:4px; font-size:12px; }
.reward-panel .card[data-family=blue] .mode-mark { border-radius:11px 4px 4px 11px; }
.reward-panel .card[data-family=dark] .mode-mark { border-style:double; border-width:3px; }
.reward-panel .card[data-family=red] .mode-mark { border-radius:2px; border-bottom-width:3px; }

@media (max-width:599px) {
  .lobby-heading {
    top:var(--ui-top); width:max-content; max-width:calc(100% - 2 * var(--ui-edge));
    padding:7px 11px 8px; border-radius:10px 16px 10px 10px;
  }
  .lobby-heading .wordmark { font-size:clamp(30px,8vw,38px); margin:2px 0 4px; }
  .lobby-heading p { display:none; }
  .lobby-balance { margin:0; min-width:48px; padding:4px 8px; }
  .menu-buttons .action:not(.launch) { min-height:54px; }
  .menu-buttons .launch { min-height:62px; }
  .hud-stats { gap:5px; }
  .hud-stats .stat.health { min-width:62px; min-height:38px; padding-inline:6px; font-size:19px; }
  .hud-stats .stat:not(.health) { padding-inline:4px; gap:2px; }
  .hud-stats .stat img { width:16px; height:16px; }
  .hud-stats .stat.health img { width:19px; height:19px; }
  #bossbar { top:calc(var(--ui-top) + 86px); }
  .panel .muted, .reward-panel > .muted { font-size:14px; line-height:1.36; }
  .reward-panel { padding:12px; }
  .reward-panel > header { margin:-12px -12px 8px; padding:8px 10px; min-height:48px; }
  .reward-panel .cards { gap:7px; }
  .reward-panel .card {
    grid-template-columns:64px minmax(0,1fr); grid-template-rows:auto auto auto;
    grid-template-areas:"art head" "art name" "stats stats"; gap:5px 8px; padding:7px 8px;
  }
  .reward-panel .card-head { flex-wrap:wrap; justify-content:flex-start; gap:4px; }
  .reward-panel .card-tag { font-size:12px; }
  .reward-panel .card-picture { min-height:58px; }
  .reward-panel .card-picture img[data-weapon-card] { width:56px; height:58px; }
  .reward-panel .card strong { font-size:17px; }
  .reward-panel .card .card-effects { font-size:14px; }
  .world-label.gate-label, .world-label.loot-label { font-size:12px; }
}


.reward-panel .card:hover:not(:focus-visible) {
  background:#eef9fc; border-color:#6b9caa; border-top-color:var(--card-hue);
}
.reward-panel .card:hover:not(:focus-visible)::after { content:none; }
.reward-panel .card:focus-visible {
  outline:3px solid #17476c; outline-offset:2px; background:#fff5dc;
}
.reward-panel .card:active { transform:translateY(1px); }

.reward-panel .card.card-compact {
  min-height:176px;
  grid-template-columns:87px minmax(0,1fr);
  grid-template-rows:auto auto 1fr;
  grid-template-areas:"head head" "art name" "art stats";
  gap:10px;
}
.reward-panel .card.card-text {
  grid-template-areas:"head head" "name name" "stats stats";
}
.reward-panel .card-compact .card-head { padding-bottom:8px; border-bottom:1px solid #c8d2d8; }
.reward-panel .card-compact > strong { font-size:21px; align-self:end; }
.reward-panel .card-compact[data-family="pet"] { --card-hue:#486c57; }
.reward-panel .card-compact[data-family="relic"] { --card-hue:#88581f; }
.reward-panel .card-compact .card-effects { min-width:0; }
.reward-panel .card-compact .effect-unit { white-space:normal; }
.reward-art {
  grid-area:art; display:flex; align-items:center; justify-content:center; gap:2px;
  flex-direction:column; position:relative; min-width:0; align-self:stretch;
  border:1px solid #bfd0de; border-radius:15px; padding:4px;
  background:linear-gradient(#e1edf6,#f5f9fc); color:#203a58;
}
.reward-art img { position:static; width:46px; height:46px; object-fit:contain; }
.reward-art.pet-art { background:linear-gradient(#deeee6,#f2f9ef); border-color:#a9c5b7; }
.reward-art[data-pet="dragon"] { background:linear-gradient(#faead9,#fff6e8); border-color:#d8b598; }
.reward-art b {
  font-size:14px; padding:2px 6px; background:white; border-radius:6px;
  color:#24445c; line-height:1.15;
}
.reward-art.duo-art { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); justify-items:center; align-content:center; background:#faefcd; }
.reward-art.duo-art img { width:34px; height:35px; }
.reward-art.duo-art b { grid-column:1 / -1; }
.reward-art.reward-token { font-size:27px; font-weight:800; }
.promotion-portrait > img[data-reward-art] { display:block; width:min(50px, 100%); aspect-ratio:1; object-fit:contain; border:0; background:none; box-shadow:none; }

.panel.settlement-panel { --result:#24574c; --result-tint:#e5f5ed; }
.panel.settlement-panel[data-result="lost"] { --result:#78452f; --result-tint:#fbecdf; }
.settlement-panel > header { background:var(--result-tint); border-bottom-color:var(--result); }
.settlement-panel > header h2 { display:flex; align-items:center; gap:9px; }
.outcome-seal {
  display:inline-grid; place-items:center; min-width:36px; height:36px;
  font-size:20px; line-height:1; color:white; background:var(--result);
  border-radius:12px 12px 12px 3px;
}
[data-result="lost"] .outcome-seal { border-radius:50%; }
.panel.settlement-panel > .summary { grid-template-columns:1.32fr 1fr 1fr; }
.settlement-panel > .summary .metric { font-size:15px; }
.settlement-panel > .summary .metric strong { font-size:22px; }
.panel.settlement-panel > .summary .metric:nth-child(1) { color:var(--result); background:var(--result-tint); }
.panel.settlement-panel > .summary .metric:nth-child(2) { background:#fff3d2; }
.settlement-panel .record-damage > div, .settlement-panel .status-chip { font-size:14px; }
.settlement-panel .record-damage dd { font-size:16px; }
.settlement-panel .record-buffs .loadout-item strong { font-size:14px; }
.settlement-panel .record-buffs .loadout-item:not(.loadout-text) {
  display:inline-flex; width:auto; min-width:58px; height:auto; padding:4px 6px;
  align-items:center; gap:5px;
}
.settlement-panel .record-buffs .loadout-item img { position:static; width:25px; height:25px; }
.settlement-panel .record-buffs .loadout-item strong { position:static; flex:none; padding:1px 4px; background:#e7f2ff; }
.outcome-seal::after { content:""; width:15px; height:9px; border-left:3px solid currentColor; border-bottom:3px solid currentColor; transform:rotate(-45deg) translateY(-3px); }
[data-result="lost"] .outcome-seal::after { width:16px; height:0; border-left:0; transform:none; }
.settlement-panel .record-buffs .loadout-item img { position:static; width:25px; height:25px; object-fit:contain; }
.settlement-panel .record-buffs .loadout-item { font-size:14px; }
.settlement-panel .record-buffs .loadout-item img { inset:auto; }

.record-buffs .loadout-text img { position:static; inset:auto; width:25px; height:25px; object-fit:contain; }
/* V4 GoldDash UI. Point samples and tinted materials are documented in palette.json. */
:root {
  --v4-navy:#202c43;
  --v4-navy-deep:#111a2c;
  --v4-blue:#30415e;
  --v4-gold:#ffae1c;
  --v4-gold-hi:#ffcb00;
  --v4-cyan:#3ae6ff;
  --v4-white:#fff;
  --v4-red:#d92d45;
  --v4-purple:#5542b9;
  --v4-cta:url(assets/sausage/ui-v4/LobbyGameModeBtn.png);
  --v4-side:url(assets/sausage/ui-v4/GoldDashRightBtnBG.png);
  --v4-quality:url(assets/sausage/ui-v4/QualityGradient.png);
}
html, body { background:#182238; color:var(--v4-white); }
body { font-family:Island,IslandCompat,sans-serif; }
#overlay { background:linear-gradient(135deg,#111a2cf2,#263957ef); }
#overlay:not([data-screen]) { background:radial-gradient(circle at 50% 40%,#315170,#101a2d 72%); }
#overlay[data-screen="menu"] { background:linear-gradient(135deg,#142039aa,#10182755); }
#overlay[data-screen="reward"] { background:#101a2dcc; }
#overlay[data-screen="pause"],#overlay[data-screen="stats"],#overlay[data-screen="settings"],#overlay[data-screen="store"],#overlay[data-screen="records"],#overlay[data-screen="achievements"] { background:#111a2cd9; }
.loading { color:#fff; text-shadow:0 4px 0 #101827,0 0 18px #3ae6ff66; }
.loading span,.eyebrow span { background:var(--v4-gold-hi); color:#1a2237; border:3px solid #fff; box-shadow:0 3px 0 #8b4314; }
.loading strong,.wordmark,.panel h2 { font-style:italic; font-weight:900; letter-spacing:.02em; -webkit-text-stroke:2px #101827; paint-order:stroke fill; text-shadow:0 4px 0 #101827,0 0 16px #fff4; }
.lobby-heading { top:clamp(22px,5vh,54px); left:max(4vw,env(safe-area-inset-left)); width:auto; max-width:48vw; padding:0; background:none; border:0; box-shadow:none; color:#fff; text-shadow:none; }
.lobby-heading .wordmark { font-size:clamp(44px,6vw,84px); line-height:.96; }
.lobby-heading p { color:#fff; font-size:clamp(16px,1.5vw,21px); text-shadow:0 2px 0 #101827; }
.lobby-balance { top:max(22px,env(safe-area-inset-top)); right:max(4vw,env(safe-area-inset-right)); min-height:44px; padding:8px 13px; color:#fff; background:linear-gradient(135deg,#17243a,#2e4669); border:3px solid #fff; border-radius:18px 9px 18px 9px; box-shadow:0 4px 0 #101827, inset 0 1px #ffffff55; }
.lobby-balance img { width:28px; height:28px; object-fit:contain; filter:drop-shadow(0 2px 0 #101827); }
.lobby-balance > span:last-child { color:#d8f7ff; font-size:14px; }
.lobby-brief,.lobby-note { color:#fff; background:#17243add; border:2px solid #fff7; box-shadow:0 4px 0 #101827; }
.lobby-brief > span { color:#19243a; background:var(--v4-cyan); border:2px solid #fff; }
.menu-buttons { right:max(4vw,env(safe-area-inset-right)); bottom:max(6vh,env(safe-area-inset-bottom)); width:clamp(270px,27vw,390px); display:grid; grid-template-columns:1fr; gap:9px; padding:0; background:none; border:0; box-shadow:none; }
.menu-buttons .launch { grid-column:1; min-height:86px; background:var(--v4-cta) center/100% 100% no-repeat; border:4px solid #fff; box-shadow:0 6px 0 #7d4311, inset 0 1px #fff8; color:#152238; }
.menu-buttons .launch span { font-size:clamp(28px,3.2vw,44px); font-weight:900; text-shadow:0 2px #fff8; }
.menu-buttons .launch small { color:#26314a; font-size:15px; }
.menu-buttons .action:not(.launch) { min-height:58px; justify-content:flex-start; padding-inline:16px; background:var(--v4-side) center/100% 100% no-repeat; border:3px solid #fff; color:#fff; box-shadow:0 4px 0 #101827; }
.v4-menu-icon { width:48px !important; height:44px !important; object-fit:contain; filter:drop-shadow(0 2px 0 #101827); }
.action,.small,.nav,#touch button { min-height:44px; border:3px solid #fff; border-radius:10px 18px 10px 18px; background:var(--v4-side) center/100% 100% no-repeat; color:#fff; box-shadow:0 4px 0 #101827,inset 0 1px #ffffff66; font-weight:900; }
.action.primary,.primary,.menu-buttons .launch { background-image:var(--v4-cta); color:#18233a; border-color:#fff; }
.action:hover:not(:disabled),.small:hover:not(:disabled),.nav:hover:not(:disabled) { filter:brightness(1.15) saturate(1.2); }
.action:active:not(:disabled),.small:active:not(:disabled),.nav:active:not(:disabled),#touch button:active { transform:translateY(3px) scale(.98); box-shadow:0 1px 0 #101827; }
.action:disabled,.small:disabled { filter:grayscale(1); opacity:.6; background:#4a5870; }
:focus-visible { outline:3px solid #fff; box-shadow:0 0 0 6px var(--v4-cyan),0 4px 0 #101827; }
.panel { color:#fff; background:linear-gradient(145deg,#253a5b,#121d32 72%); border:12px solid transparent; border-image:none; box-shadow:0 10px 0 #0b1222,0 24px 42px #07101fcc,inset 0 1px #fff5; }
.panel::before { inset:10px; border:1px solid #3ae6ff66; border-radius:0; }
.panel header { padding-bottom:12px; border-bottom:3px solid #3ae6ff; }
.panel header h2 { color:#fff; font-size:clamp(24px,3vw,40px); }
.panel header>.coin { color:#fff; background:#17243a; border:3px solid #fff; border-radius:14px 7px 14px 7px; box-shadow:0 3px 0 #101827; }
.muted { color:#d8eaff; font-size:16px; }
.collection-scroll { padding:12px 10px 14px; }
.collection-scroll::-webkit-scrollbar-thumb { background:#ffae1c; border:3px solid #152038; }
.collection-scroll::-webkit-scrollbar-track { background:#1b2a43; }
.cards,.store,.summary { gap:12px; }
.card { border:4px solid #fff; border-radius:12px 20px 12px 20px; background:linear-gradient(150deg,#304d70,#18273f 72%); box-shadow:0 6px 0 #0b1222,0 12px 20px #07101f99,inset 0 1px #ffffff66; }
.card::before { background:linear-gradient(135deg,#3ae6ff2b 0 20%,transparent 21% 66%,#ffae1c22 67%); }
.card:hover { background:linear-gradient(150deg,#395c83,#20324f 72%); }
.card[data-family="red"] { --card-ink:#c53a51; --card-bright:#ffae1c; }
.card[data-family="dark"] { --card-ink:#5c4bd0; --card-bright:#c8c0ff; }
.card[data-family="gear"] { --card-ink:#3b8191; --card-bright:#3ae6ff; }
.card[data-family="pet"] { --card-ink:#1f9f87; --card-bright:#6fffe1; }
.card[data-family="relic"] { --card-ink:#b56e20; --card-bright:#ffcb00; }
.card-tag { background:var(--card-ink); border:2px solid #fff; border-radius:5px 12px 5px 12px; font-size:14px; }
.card-picture { background:var(--v4-quality) center/cover,radial-gradient(circle,#3a638c,#172840); border:3px solid #fff; box-shadow:inset 0 2px #fff7,0 4px 0 #101827; }
.card strong { color:#fff; font-size:20px; text-shadow:0 2px #101827; }
.card small { color:#e7f5ff; font-size:16px; }
.card[aria-selected="true"],.card:focus-visible { transform:translateY(-4px) scale(1.03); outline:4px solid var(--v4-gold-hi); box-shadow:0 0 0 6px #1b3157,0 8px 0 #101827; }
.product,.metric,.stat-tile,.option { color:#fff; border:3px solid #fff; border-radius:10px 18px 10px 18px; background:linear-gradient(145deg,#2e4b70,#17263e); box-shadow:0 4px 0 #101827,inset 0 1px #ffffff55; }
.product > img { border:3px solid #fff; box-shadow:0 3px 0 #101827; }
#hud { color:#fff; }
.hud-stats { gap:7px; }
.stat { min-height:46px; padding:6px 10px; background:linear-gradient(145deg,#2d4668,#17263e); border:3px solid #fff; border-radius:14px 8px 14px 8px; box-shadow:0 4px 0 #101827,inset 0 1px #ffffff55; font-size:18px; }
.stat img { width:28px; height:28px; filter:drop-shadow(0 2px 0 #101827); }
.stat strong { font-size:24px; color:#fff; }
.stat.health { background:linear-gradient(145deg,#8d3048,#431c38); }
.stat.score { background:linear-gradient(145deg,#2f788d,#183c5b); }
#loadout { background:#111d31e6; border:3px solid #fff; box-shadow:0 4px 0 #101827; }
.loadout-item { border:3px solid #fff; background:linear-gradient(145deg,#43648a,#182a44); box-shadow:0 3px 0 #101827; }
#boss-progress { background:#17243ae8; border:3px solid #fff; box-shadow:0 5px 0 #101827; }
#boss-progress .progress-track { background:#0d1628; border:2px solid #fff8; }
#boss-progress .progress-fill { background:linear-gradient(90deg,#3ae6ff,#ffcb00); }
#bossbar { background:var(--v4-navy-deep) url(assets/sausage/ui-v4/BossHpBarBg.png) center/100% 100% no-repeat; border:4px solid #fff; border-radius:12px 22px 12px 22px; box-shadow:0 6px 0 #101827; padding:8px 12px 10px; }
#bossbar span { border:0; font-size:20px; text-shadow:0 2px #101827; }
#bossbar progress { height:20px; border:3px solid #fff; background:#111a2c; }
#bossbar progress::-webkit-progress-value { background:linear-gradient(90deg,#ff3b54,#ffae1c); }
#toast { color:#fff; background:var(--v4-side) center/100% 100% no-repeat; border:3px solid #fff; border-radius:10px 18px 10px 18px; box-shadow:0 5px 0 #101827; }
#pet-promotion { background:radial-gradient(circle,#354f9c,#171f50 72%); border:3px solid #ffcb00; box-shadow:0 0 0 6px #fff4,0 14px 32px #070d1acc; }
.promotion-announcement { background:var(--v4-cta) center/100% 100% no-repeat; border:3px solid #fff; color:#172238; }
.promotion-card { border-color:#ffcb00; background:linear-gradient(145deg,#263b72,#121b3e); box-shadow:0 8px 0 #0b1222; }
.promotion-portrait > img { border:3px solid #fff; background:#22385d; }
.settlement-panel[data-result="won"] { background:linear-gradient(145deg,#68451a,#1e2c44); }
.settlement-panel[data-result="lost"] { background:linear-gradient(145deg,#4b3a91,#19233e); }
.settlement-panel[data-result="won"]::after,.settlement-panel[data-result="lost"]::after { content:""; position:absolute; top:0; right:0; width:44%; height:100%; background:center/contain no-repeat; opacity:.9; pointer-events:none; }
.settlement-panel[data-result="won"]::after { background-image:url(assets/sausage/ui-v4/Evacuation_Win1.png); }
.settlement-panel[data-result="lost"]::after { background-image:url(assets/sausage/ui-v4/Evacuation_Lose.png); }
.settlement-panel > * { position:relative; z-index:1; }
@media (max-width:680px) { .lobby-heading { max-width:72vw; } .menu-buttons { width:min(84vw,380px); } .panel { border-width:9px; } .card strong { font-size:18px; } }
/* GoldDash V4 skin. Sample positions and tint derivations are in palette.json. */
:root { --gd-night:#1e2c42; --gd-slate:#2d353f; --gd-bottom:#121a28; --gd-yellow:#feba25; --gd-mint:#02cf9c; --gd-white:#fff; --gd-paler:#dcf1ff; --gd-crimson:#d62400; --gd-hatch:repeating-linear-gradient(128deg,#ffffff12 0 2px,transparent 2px 12px); --gd-dot:radial-gradient(circle,#fff5 1px,transparent 1.5px); }
#overlay[data-screen="menu"] { background:linear-gradient(90deg,#121a2b80,transparent 46%); }
#overlay:not([data-screen="menu"]):not([hidden]) { background:#10182bb0; backdrop-filter:blur(2px); }
.lobby-heading .wordmark { color:#fff; text-shadow:3px 5px #101827; -webkit-text-stroke:3px #101827; }
.lobby-heading .eyebrow span { color:#111a2b; border:0; }
.lobby-balance .coin,.lobby-balance > span:last-child { color:#fff; }
.menu-buttons { left:auto; right:max(3vw,20px); bottom:max(4vh,20px); justify-items:end; width:clamp(240px,27vw,350px); gap:8px; }
.menu-buttons .launch { grid-row:5; width:100%; aspect-ratio:401 / 130; min-height:76px; background:var(--v4-cta) center/100% 100% no-repeat; padding:14px 12px 15px; border:0; border-radius:14px; box-shadow:none; }
.menu-buttons .launch::before { content:none; }
.menu-buttons .launch span { color:white; -webkit-text-stroke:4px var(--gd-crimson); paint-order:stroke fill; text-shadow:0 4px #782b16; }
.menu-buttons .action:not(.launch),.hud-controls .small,.panel .action { background:var(--v4-side) center/100% 100% no-repeat,var(--gd-slate); color:white; border:1px solid #8d9fbf; border-radius:10px; box-shadow:0 4px var(--gd-bottom); }
.menu-buttons .action:not(.launch) { width:164px; min-height:48px; padding:2px 9px; font-size:16px; }
.menu-buttons .action:not(.launch) img,.menu-buttons .action[data-action="achievements"] img { width:35px!important; height:35px!important; filter:drop-shadow(0 1px 0 #fff) drop-shadow(0 -1px 0 #fff); }
.menu-buttons .action:not(.launch):hover,.hud-controls .small:hover,.panel .action:hover:not(:disabled) { color:white; background:var(--gd-hatch),#435572; border-color:var(--gd-mint); }
.menu-buttons .launch:active,.panel .action:active:not(:disabled) { transform:translateY(2px) scale(.97); }
.panel .action.primary,.panel .action.primary:hover:not(:disabled) { color:#161c2a; background:linear-gradient(#ffdd53,var(--gd-yellow)); border-color:#ffda71; }
.panel .action:disabled { color:#d3dbec; background:#465168; border-color:#8490a6; opacity:.85; }
.panel .action:focus-visible,.menu-buttons .action:focus-visible,.hud-controls .small:focus-visible,.reward-panel .card:focus-visible { outline:3px solid var(--gd-mint); outline-offset:3px; box-shadow:0 0 0 2px #0d1425; }
.overlay .coin img,.coin .v4-menu-icon { width:24px!important; height:24px!important; }
#hud { z-index:3; }
.hud-stats { flex-direction:column; align-items:flex-start; }
.hud-stats .stat.health { color:white; min-height:48px; min-width:110px; background:var(--gd-hatch),var(--gd-night); border:2px solid #8195b5; border-radius:20px; box-shadow:0 4px var(--gd-bottom); padding:3px 12px; }
.hud-stats .stat.health img { width:29px; height:29px; filter:drop-shadow(0 2px #ab2f52); }
.hud-stats .hud-readings { padding:2px; background:var(--gd-bottom); border:1px solid #839bb9; gap:2px; border-radius:8px; }
.hud-stats .stat:not(.health) { min-height:38px; border:0; color:white; background:linear-gradient(#384b68,#25344e); border-radius:5px; padding:4px 7px; box-shadow:none; }
.hud-stats .stat .hud-key { color:var(--gd-paler); font-size:14px; }
.hud-stats .stat strong { color:white; font-size:22px; display:inline-block; }
.hud-stats .stat:has(#swords) img { filter:drop-shadow(0 1px white); }
#loadout .loadout-item { color:white; background:linear-gradient(#3e447a,#272c50); border-color:#93a3c7; }
#loadout .loadout-item strong { color:white; background:#151c30; font-size:20px; }
#boss-progress { top:max(18px,env(safe-area-inset-top)); left:50%; translate:-50% 0; width:clamp(200px,30vw,420px); height:16px; border:0; background:var(--gd-bottom); border-radius:9px; }
#boss-progress .progress-track { inset:0; border:1px solid #8da8c8; background:var(--gd-hatch),var(--gd-slate); border-radius:inherit; }
#boss-progress .progress-fill { inset:3px auto 3px 3px; width:var(--progress-fill,0%); height:auto; background:var(--gd-mint); border-radius:4px; }
#boss-progress .progress-marks { inset:3px; background:repeating-linear-gradient(90deg,transparent 0 15%,#fff6 15% 16%); }
#boss-progress .progress-hero { left:clamp(12px,var(--progress-marker,0%),calc(100% - 12px)); width:33px; height:35px; bottom:50%; transform:translate(-50%,50%); object-fit:contain; filter:drop-shadow(0 1px #fff); }
#bossbar { top:48px; width:min(40vw,520px); display:grid; grid-template-columns:52px 1fr; column-gap:8px; padding:4px 11px 8px; border:1px solid #ae98c3; border-radius:11px; background:url(assets/sausage/ui-v4/BossHpBarBg.png) center/100% 100% no-repeat,#252438; }
#bossbar #boss-portrait { width:49px; height:54px; object-fit:contain; grid-row:span 2; filter:drop-shadow(0 1px white); }
#bossbar span { grid-column:2; color:#fff; background:none; box-shadow:none; }
#bossbar progress { grid-column:2; width:100%; height:14px; border:1px solid #ac95b8; background:#262236; }
#bossbar progress::-webkit-progress-bar { background:#262236; }
#bossbar progress::-webkit-progress-value { background:linear-gradient(90deg,#ae3563,#fe9235); }
#toast { color:white; display:flex; gap:8px; align-items:center; border:1px solid #7d99b4; border-left:4px solid var(--gd-mint); background:var(--gd-hatch),var(--gd-night); font-size:16px; }
#toast img { width:27px!important; height:27px!important; }
#toast.v4-pulse { animation:gd-toast 360ms ease-out both; }
.panel { background:linear-gradient(148deg,var(--gd-slate),var(--gd-night) 48%,var(--gd-bottom)); color:white; border:1px solid #7489a8; border-image:none; border-radius:12px; box-shadow:0 8px var(--gd-bottom),0 18px 36px #111624bb; animation:gd-panel 210ms cubic-bezier(.18,.7,.35,1) both; }
.panel::before { content:""; inset:0; border:0; border-radius:inherit; background:var(--gd-dot) 1px 0/6px 6px no-repeat; }
.panel > header { padding:9px 18px; color:white; border:0; border-bottom:2px solid var(--gd-mint); border-radius:0; background:var(--gd-hatch),linear-gradient(90deg,#18243c,#435674); clip-path:polygon(0 0,100% 0,calc(100% - 12px) 100%,0 100%); }
.panel > header h2,.reward-panel > header h2 { color:white; font-size:31px; text-shadow:0 3px var(--gd-bottom); }
.panel > header .coin { color:white; border:1px solid #8293b0; background:#151d30; }
.panel .muted,.reward-panel > .muted { color:var(--gd-paler); font-size:16px; }
.panel .option,.panel .product,.panel .stat-tile,.panel .metric,.panel .record-entry,.panel .achievement { background:linear-gradient(#3c4d69,#29364f); border-color:#7f92b4; color:white; }
.panel .stat-group h3,.panel .record-damage dt,.panel .loadout-name { color:#eaf3ff; }
.panel .record-damage > div,.panel .record-buffs .loadout-item,.panel .empty-state { background:#1e2b44; border-color:#687d9f; color:white; }
.panel .record-damage dd,.panel .metric strong { color:white; }
.panel .status-chip:not(.success) { background:#29344a; color:white; }
.panel .status-chip.success { background:var(--gd-mint); color:#10232c; }
.panel .action .price-short { color:#ff9aa9; }
.reward-panel { width:min(940px,100%); }
.reward-panel .reward-icon { filter:drop-shadow(0 1px #fff); }
.reward-panel .cards { gap:16px; }
.reward-panel .card,.reward-panel .card-compact { --gd-card:#38445d; --gd-card-light:#607491; display:grid; grid-template-columns:minmax(0,1fr); grid-template-rows:auto 132px auto 1fr; grid-template-areas:"head" "art" "name" "stats"; background:linear-gradient(164deg,var(--gd-card-light),var(--gd-card) 60%,#19233a); border:1px solid #8191b0; border-top:4px solid var(--gd-card-light); border-radius:7px; color:white; padding:12px; transition:transform .16s,border-color .16s,box-shadow .16s; }
.reward-panel .card.card-text { grid-template-rows:auto auto 1fr; grid-template-areas:"head" "name" "stats"; }
.reward-panel .card[data-family="blue"] { --gd-card:#224a78; --gd-card-light:#4d83b3; }
.reward-panel .card[data-family="dark"] { --gd-card:#463471; --gd-card-light:#8b6fbe; }
.reward-panel .card[data-family="red"],.reward-panel .card[data-family="relic"] { --gd-card:#7d451e; --gd-card-light:#ce913e; }
.reward-panel .card[data-family="pet"] { --gd-card:#1b5145; --gd-card-light:#2f947e; }
.reward-panel .card:hover { background:linear-gradient(164deg,var(--gd-card-light),var(--gd-card) 62%,#202c43); border-color:var(--gd-yellow); transform:translateY(-3px) scale(1.015); }
.reward-panel .card:focus-visible { background:linear-gradient(164deg,var(--gd-card-light),var(--gd-card) 60%,#19233a); border-color:#97b7d8; transform:none; }
.reward-panel .card:active { transform:scale(.98); }
.reward-panel .card-head { border-color:#fff4; }
.reward-panel .card-tag { background:#111c31; border:0; }
.reward-panel .card-picture,.reward-panel .reward-art { isolation:isolate; background:var(--gd-hatch),linear-gradient(135deg,#111a2d80,#566c8c45); border:1px solid #f3f7ff70; border-radius:5px; min-height:0; color:white; }
.reward-panel .card-picture img[data-weapon-card] { width:185px; height:124px; filter:drop-shadow(1px 0 0 white) drop-shadow(-1px 0 0 white) drop-shadow(0 4px 5px #121725); }
.reward-panel .reward-art img { width:82px; height:82px; filter:drop-shadow(0 1px white); }
.reward-panel .reward-art .reward-gap { writing-mode:horizontal-tb; width:auto; padding:3px 6px; font-size:14px; text-wrap:balance; }
.reward-panel .card > strong { color:white; font-size:20px; }
.reward-panel .card .card-effects,.reward-panel .card .effect-unit b { color:white; font-size:16px; }
.reward-panel .card .effect-unit { display:inline-flex; align-items:center; gap:4px; white-space:nowrap; background:#0e162981; }
.reward-panel .effect-unit[data-effect="gain"] b { color:#80ffe0; }
.reward-panel .effect-unit[data-effect="cost"] b { color:#ffadc1; }
.reward-panel .card .mode-line,.reward-panel .card .mode-mark { font-size:14px; }
.reward-panel .card .mode-mark { min-width:25px; }
.reward-panel .buttons { border-color:#617596; }
.panel.settlement-panel { background:linear-gradient(140deg,#253753,#151d2d); }
.panel.settlement-panel[data-result="won"]::after,.panel.settlement-panel[data-result="lost"]::after { width:65%; background: center / cover no-repeat; opacity:.30; z-index:0; }
.panel.settlement-panel[data-result="won"]::after { background-image:url(assets/sausage/ui-v4/GoldDashSettlement_19.png); }
.panel.settlement-panel[data-result="lost"]::after { background-image:url(assets/sausage/ui-v4/GoldDashSettlement_20.png); }
.panel.settlement-panel > header { min-height:66px; border-color:#e49831; }
.panel.settlement-panel[data-result="lost"] > header { border-color:#93a3f7; }
.settlement-panel > header::after { content:""; width:130px; height:48px; flex:none; background:center / contain no-repeat; }
.settlement-panel[data-result="won"] > header::after { background-image:url(assets/sausage/ui-v4/Evacuation_Win1.png); }
.settlement-panel[data-result="lost"] > header::after { background-image:url(assets/sausage/ui-v4/Evacuation_Lose.png); }
.panel.settlement-panel > .summary .metric { background:#25344c; color:white; }
.settlement-panel .metric strong { animation:gd-number 350ms cubic-bezier(.22,.72,.32,1) both; }
.settlement-panel .metric:nth-child(2) strong { animation-delay:65ms; }
.settlement-panel .metric:nth-child(3) strong { animation-delay:130ms; }
#pet-promotion { color:white; border:0; background:none; box-shadow:none; }
.promotion-announcement { color:white; font-size:16px; background:var(--gd-dot) 0 0/7px 7px,linear-gradient(140deg,#363475,#171c49); border:1px solid var(--gd-yellow); text-shadow:0 0 12px #aabaef; }
.promotion-card { color:white; background:linear-gradient(135deg,#412f77,#141733); }
.promotion-copy { color:white; font-size:16px; text-shadow:0 0 8px #728ced; }
@keyframes gd-panel { from { opacity:.3; translate:0 18px; } to { opacity:1; translate:0 0; } }
@keyframes gd-toast { 0% { opacity:0; translate:0 10px; } 65% { opacity:1; translate:0 -4px; } 100% { translate:0 0; } }
@keyframes gd-number { from { transform:translateY(8px); opacity:.25; } to { transform:translateY(0); opacity:1; } }

/* Final PC direction. Preserve the same DOM actions and control hit areas. */
.menu-buttons .action:not(.launch) { display:flex; align-items:center; justify-content:flex-start; gap:10px; }
.hud-stats .hud-readings { display:flex; flex-flow:row wrap; max-width:min(42vw,435px); }
.hud-stats .stat:has(#arrows) { background:linear-gradient(155deg,#456c97,#263d62); }
.hud-stats .stat:has(#swords) { background:linear-gradient(155deg,#685196,#36264f); }
.hud-controls .small { font-size:16px; }
#boss-warning { position:absolute; width:min(245px,90%); height:19px; bottom:-23px; left:50%; translate:-50% 0; opacity:0; pointer-events:none; background:url(assets/sausage/ui-v4/Sfx_BossHpBG_6.png) center/contain no-repeat; }
.world-label.enemy-life,.world-label.boss-life { color:white; background:url(assets/sausage/ui-v4/HpBarBg.png) center/100% 100% no-repeat,#182438; border:1px solid #7f92b4; text-shadow:0 1px #111a2c; font-size:16px; }
.reward-panel .card-picture,.reward-panel .reward-art { background:var(--gd-hatch),url(assets/sausage/ui-v4/QualityGradient.png) center/100px 100px,linear-gradient(135deg,#111a2d80,#566c8c45); }
.reward-panel .card { --gd-edge:#8191b0; border-inline-color:var(--gd-edge); }
.reward-panel .card[data-rank="2"] { --gd-edge:#70b9ff; }
.reward-panel .card[data-rank="3"] { --gd-edge:#ad97ff; }
.reward-panel .card[data-rank="4"] { --gd-edge:#fed767; }
.reward-panel .card:hover { border-color:var(--gd-yellow); }
.reward-panel .card:focus-visible { border-color:var(--gd-mint); }
.reward-panel .card:focus-visible::after { box-shadow:inset 0 0 0 2px var(--gd-mint); }
.collection-panel { --gd-collection-tab:url(assets/sausage/ui-v4/GoldDashWarehouseTab1.png); }
.collection-panel .collection-scroll { padding-left:12px; border-left:4px solid var(--gd-mint); border-image:var(--gd-collection-tab) 9 / 4px; }
.collection-panel .product,.collection-panel .achievement { background:var(--gd-hatch),linear-gradient(155deg,#435877,#20304a 78%); }
.panel .option,.panel .product p,.panel .achievement strong { font-size:16px; }
.panel .achievement small,.panel .status-chip { font-size:14px; }
.panel .action:disabled,.hud-controls .small:disabled { color:#eaf1ff; background:#3b455a; opacity:.7; }
.panel .action:active:not(:disabled),.menu-buttons .action:active:not(:disabled) { transform:translateY(3px) scale(.98); box-shadow:0 1px var(--gd-bottom); }
@media (prefers-reduced-motion:reduce) {
  .panel,.settlement-panel .metric strong,#toast.v4-pulse { animation:none; }
  .reward-panel .card,.menu-buttons .action { transition:none; }
  .reward-panel .card:hover { transform:none; }
}

.menu-buttons .launch:hover { filter:brightness(1.09) saturate(1.15); }
.menu-buttons .launch:active { filter:brightness(.91) saturate(1.09); }
.hud-stats .stat .hud-key { white-space:nowrap; }

.lobby-heading .eyebrow span { color:#fff; background:var(--gd-night); display:inline-block; font-size:14px; padding:3px 9px; border-left:3px solid var(--gd-mint); border-radius:3px; }
.panel .stat-group h3 { color:#eaf3ff; background:var(--gd-hatch),#30445d; border-color:var(--gd-mint); font-size:16px; }
.reward-panel .card.card-compact { grid-template-columns:minmax(0,1fr); grid-template-rows:auto minmax(64px,auto) auto 1fr; grid-template-areas:"head" "art" "name" "stats"; }
.reward-panel .card.card-compact.card-text { grid-template-rows:auto auto 1fr; grid-template-areas:"head" "name" "stats"; }
.reward-panel .card.card-compact .reward-art { min-height:64px; }
.reward-panel .card.card-compact .reward-gap { color:#fff; background:#142238; }
.reward-panel .card[data-family]:hover { background:linear-gradient(164deg,var(--gd-card-light),var(--gd-card) 57%,#202c43); }
.reward-panel .card[data-family]:focus-visible { background:linear-gradient(164deg,var(--gd-card-light),var(--gd-card) 60%,#19233a); }
.panel.settlement-panel > .summary .metric:nth-child(1) { color:white; background:#34485e; border-color:#a6b2c5; }
.panel.settlement-panel[data-result="won"] > .summary .metric:nth-child(1) { background:#5a3d21; border-color:#f5b64a; }
.panel.settlement-panel[data-result="lost"] > .summary .metric:nth-child(1) { background:#39345f; border-color:#a9a7ff; }
.panel.settlement-panel > .summary .metric:nth-child(2) { color:#ffe8a1; background:#38362f; border-color:#b38d42; }
.panel.settlement-panel .record-buffs .loadout-item strong { color:#fff; background:#243750; }
.promotion-card::before { background:var(--gd-dot) 1px 1px/8px 8px,radial-gradient(ellipse at 50% 28%,#62519c,#251f58 64%,#141934); }
.promotion-card .reward-gap { color:white; background:#272548; border:1px solid #b1a3e5; }
/* R2. Keep the original action anchors and give content its own clean surfaces. */
.menu-buttons .action:not(.launch), .panel .action:not(.primary), .hud-controls .small {
  background:linear-gradient(150deg,#344964,#1d2b42);
}
.menu-buttons .action:not(.launch):hover,.panel .action:not(.primary):hover:not(:disabled),.hud-controls .small:hover {
  background:#405c78;
}
.menu-buttons .action:not(.launch) img.semantic-lobby-icon {
  width:38px!important; height:38px!important; flex:none; object-fit:contain;
}
.hud-stats .stat.health,#toast,.world-label.enemy-life,.world-label.boss-life { background-color:#243349; }
.hud-stats .stat.health,#toast { background-image:none; }
#boss-progress { height:22px; top:19px; }
#boss-progress .progress-hero { width:39px; height:42px; }
#bossbar { top:54px; overflow:visible; }
#bossbar::before {
  content:""; position:absolute; left:64px; right:9px; top:5px; bottom:5px;
  border-radius:6px; background:var(--boss-foil) center/auto 100% no-repeat; opacity:.20; pointer-events:none;
}
#bossbar[data-plate="1"] { --boss-foil:url(assets/sausage/ui-v4-r2/BossHpBG_2.png); --boss-fill:linear-gradient(90deg,#a84737,#ffad3e); }
#bossbar[data-plate="2"] { --boss-foil:url(assets/sausage/ui-v4-r2/BossHpBG_3.png); --boss-fill:linear-gradient(90deg,#454dc3,#7be8fc); }
#bossbar[data-plate="3"] { --boss-foil:url(assets/sausage/ui-v4-r2/BossHpBG_4.png); --boss-fill:linear-gradient(90deg,#5e3794,#df94fa); }
#bossbar[data-plate="4"] { --boss-foil:url(assets/sausage/ui-v4-r2/BossHpBG_5.png); --boss-fill:linear-gradient(90deg,#a5263a,#ff6e4d); }
#bossbar progress::-webkit-progress-value { background:var(--boss-fill); }
#boss-warning {
  width:min(282px,90%); height:27px; bottom:-31px; display:grid; place-content:center;
  background:linear-gradient(90deg,#782436,#bd2e35 34% 66%,#782436);
  border:1px solid #ffba44; clip-path:polygon(4% 0,100% 0,96% 100%,0 100%);
  color:#fff0a1; font:900 italic 16px/1 sans-serif; letter-spacing:.16em;
  text-shadow:0 2px #6c2523; isolation:isolate;
}
#boss-warning::before {
  content:""; position:absolute; inset:2px 7px; z-index:-1;
  background:url(assets/sausage/ui-v4/Sfx_BossHpBG_6.png) center/contain no-repeat; opacity:.53;
}
.reward-panel { width:min(990px,100%); }
.reward-panel .cards { gap:18px; padding:5px 3px; }
.reward-panel .card.card-weapon {
  min-height:clamp(315px,53vh,399px); grid-template-rows:auto minmax(160px,1fr) auto minmax(70px,auto);
  padding:12px 14px 14px; align-items:start;
}
.reward-panel .card.card-compact { min-height:280px; grid-template-rows:auto minmax(112px,1fr) auto minmax(54px,auto); }
.reward-panel .card.card-compact.card-text { grid-template-rows:auto auto 1fr; }
.reward-panel .card-picture,.reward-panel .reward-art {
  align-self:stretch; background:none; box-shadow:none; border:0; padding:0;
}
.reward-panel .card-picture img[data-weapon-card] {
  width:100%; height:100%; object-fit:contain; align-self:center;
  filter:drop-shadow(0 2px #f5f8ff) drop-shadow(0 6px 10px #101828);
}
.reward-panel .card:not(.card-weapon) .reward-art img { width:min(92px,90%); height:83px; }
.reward-panel .card[data-family]:hover,.reward-panel .card[data-committed] {
  z-index:2; border-color:#ffe184; box-shadow:0 0 0 2px #feb63a,0 10px 20px #121b2a;
  transform:translateY(-4px) scale(1.035);
}
.reward-panel .card[data-family]:active { transform:translateY(-5px) scale(1.055); border-color:#fff0aa; }
.reward-panel .card[data-family]:focus-visible { outline:3px solid #43f8c9; }
.reward-panel .card-head {
  background:var(--rank-face) center/contain no-repeat; min-height:37px; border-bottom-color:#a9bbd055; gap:4px;
}
.card[data-rank="1"] { --rank-face:url(assets/sausage/ui-v4-r2/EntryLevel1.png); }
.card[data-rank="2"] { --rank-face:url(assets/sausage/ui-v4-r2/EntryLevel2.png); }
.card[data-rank="3"] { --rank-face:url(assets/sausage/ui-v4-r2/EntryLevel3.png); }
.card[data-rank="4"] { --rank-face:url(assets/sausage/ui-v4-r2/EntryLevel4.png); }
.card[data-rank="0"] { --rank-face:url(assets/sausage/ui-v4-r2/EntryLevel0.png); }
.reward-panel .reward-art small { font-size:14px; }
.reward-panel .reward-art .reward-gap { display:inline-block; }
.gd-flight {
  position:fixed; width:72px; height:72px; object-fit:contain; z-index:9; pointer-events:none;
  filter:drop-shadow(0 0 10px #ffdb6c) drop-shadow(0 2px #fff);
}
.panel .sectioned { display:grid; grid-template-columns:130px minmax(0,1fr); min-height:0; gap:13px; }
.panel .sectioned .collection-scroll { border:0; padding:1px 7px 8px 2px; max-height:min(56vh,510px); }
.panel .sectioned > .collection-scroll > section { margin:0 0 15px; }
.panel .panel-tabs { display:flex; flex-direction:column; gap:7px; align-self:start; }
.panel .panel-tabs button {
  min-height:45px; padding:5px 8px; background:#22354f; border:1px solid #7890b3;
  color:#ecf4ff; font-size:15px; border-radius:5px; line-height:1.2; overflow-wrap:anywhere;
}
.panel .panel-tabs button[aria-current="true"] {
  color:#eafff7; border-left:4px solid var(--gd-mint);
  background:url(assets/sausage/ui-v4-r2/tab.png) right center/contain no-repeat,#304860;
}
.panel .panel-tabs button:hover { background-color:#48637d; }
.panel .panel-tabs button:focus-visible { outline:3px solid #43f8c9; outline-offset:3px; }
.panel .section-name { margin:0 0 8px; border-left:3px solid #02cf9c; padding:4px 8px; color:#eaf6ff; background:#2b405a; font-size:17px; }
.panel .product,.panel .achievement { background:linear-gradient(142deg,#425c78,#26384f 80%); box-shadow:none; }
.panel .product { display:grid; grid-template-columns:50px minmax(0,1fr); gap:6px 10px; align-items:center; min-width:0; }
.panel .product > img { width:48px; height:46px; object-fit:contain; border:0; box-shadow:none; background:transparent; margin:0; }
.panel .product h3 { font-size:17px; margin:0; overflow-wrap:anywhere; }
.panel .product .muted,.panel .product .status-chip,.panel .product .store-buy { grid-column:1/-1; }
.panel .product .muted { margin:0; }
.panel .product .status-chip { margin:0; justify-self:start; }
.panel .store-buy { display:flex; align-items:center; justify-content:center; gap:8px; margin:0; min-width:0; font-size:16px; }
.panel .store-buy .coin { background:none; box-shadow:none; border:0; padding:0; }
.panel .store-buy .price { color:#ffec9d; font-size:18px; }
.panel .store-buy[data-price-state="ready"] { background:#2f3744; border:2px solid #ffcc55; color:#fff8d4; }
.panel .store-buy[data-price-state="ready"]:hover { background:#665329; }
.panel .store-buy[data-price-state="short"] { background:#263045; color:#d3dbe9; border:1px solid #8492a8; }
.panel .store-buy[data-price-state="short"] .price { color:#ede7d8; }
.panel .store-buy[data-price-state="short"] .price-short { color:#fff; background:#962c49; }
.panel .store-buy[data-price-state="max"]:disabled { background:#213f40; color:#bbf0df; border-color:#729a99; opacity:1; }
.panel .achievement-art { position:relative; display:grid; place-items:center; width:45px; height:43px; background:#243851; border-radius:6px; }
.panel .achievement-art img { width:37px!important; height:37px!important; object-fit:contain; }
.panel .achievement-art img:last-child:not(:first-child) { position:absolute; bottom:-2px; right:-2px; width:19px!important; height:19px!important; background:#182842; border-radius:3px; }
.panel .achievement[data-lock="true"] .achievement-art > img:first-child { opacity:.66; }
.panel .achievement small { color:#e0eaf6; font-size:14px; }
.panel .empty-state { display:grid; place-items:center; gap:4px; padding:35px 20px; text-align:center; }
.panel .empty-state img { width:min(104px,60%); aspect-ratio:1; object-fit:contain; }
.panel .empty-state strong { font-size:22px; }
.panel .empty-state p { margin:0; font-size:16px; color:#cfdaeb; }
.panel.settings-panel { width:min(650px,96vw); }
.panel.stats-panel { width:min(820px,100%); }
.pause-layout .stats-panel { width:100%; }
.panel .stat-sections { grid-template-columns:112px minmax(0,1fr); }
.panel .stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; }
.panel .stat-tile {
  display:grid; grid-template-columns:26px minmax(0,1fr) auto; grid-template-rows:auto; gap:6px;
  min-height:47px; align-items:center; padding:5px 8px; background:#293d56; border:1px solid #7890ad;
  box-shadow:none; overflow:visible;
}
.panel .stat-tile:not(:has(img)) { grid-template-columns:minmax(0,1fr) auto; }
.panel .stat-tile img { width:25px; height:25px; object-fit:contain; }
.panel .stat-tile > span { font-size:16px; color:#edf4ff; line-height:1.12; }
.panel .stat-tile strong { font-size:20px; font-variant-numeric:tabular-nums; color:#fff5b9; white-space:nowrap; }
.panel .stat-tile .cape-bonus { display:inline; margin-left:3px; color:#95ffe5; }
.pause-layout .stat-tile { grid-template-columns:25px minmax(0,1fr) auto; }
.pause-layout .stat-sections { grid-template-columns:94px minmax(0,1fr); }
.panel .stat-sections .collection-scroll { max-height:min(66vh,575px); }
.panel .stat-sections h4 { color:white; margin:3px 0 9px; font-size:15px; }
.panel .stat-sections .pet-stats { display:grid; grid-template-columns:1fr; gap:10px; }
.panel.settlement-panel {
  width:min(960px,96vw); min-height:min(520px,82vh); max-height:calc(100dvh - 34px);
  display:grid; grid-template-rows:minmax(128px,auto) auto auto minmax(0,1fr) auto;
  align-content:start; overflow:auto; margin:0 auto; isolation:isolate;
}
.panel.settlement-panel > header {
  min-height:141px; display:grid; justify-content:center; justify-items:center; align-content:center; gap:4px;
  clip-path:polygon(0 0,100% 0,96% 100%,0 100%); border-bottom-width:3px;
}
.panel.settlement-panel > header h2 { order:2; font-size:25px; }
.panel.settlement-panel > header::after { order:1; width:clamp(225px,34vw,397px); height:82px; }
.panel.settlement-panel[data-result="won"] > header { background:linear-gradient(103deg,#844923,#e79232 57%,#694521); }
.panel.settlement-panel[data-result="lost"] > header { background:linear-gradient(103deg,#372c75,#5957aa 58%,#27355d); }
.panel.settlement-panel[data-result]::after { width:100%; opacity:.40; background-position:center 36%; }
.panel.settlement-panel > .summary { margin-bottom:12px; gap:9px; }
.panel.settlement-panel > .summary .metric { padding:9px 13px; }
.panel.settlement-panel > .summary .metric strong { animation:none; font-size:32px; line-height:1.03; font-variant-numeric:tabular-nums; }
.panel.settlement-panel > .record-entry { overflow:auto; }
.panel.settlement-panel > .buttons { margin-top:10px; }
#pet-promotion { width:min(735px,95%,91vh); top:46%; }
.promotion-announcement { font-size:21px; font-weight:800; padding:8px 16px; color:#fff; text-shadow:0 0 13px #d9dbff; }
.promotion-card::before { border-image-width:12px; }
.promotion-card.promotion-result { outline:1px solid #f5c277; outline-offset:-7px; box-shadow:0 0 34px #9186ee88; }
.promotion-card .promotion-copy { font-size:18px; line-height:1.15; text-shadow:0 0 10px #cbccff,0 2px #211b46; }
.promotion-card .promotion-copy .reward-gap { display:block; font-size:14px; border:0; padding:4px; margin-top:5px; }
.promotion-portrait > img.pet-proxy { width:min(95px,90%); aspect-ratio:1; height:auto; background:none; filter:drop-shadow(0 0 13px #b7a7ec); }
@media (max-width:1150px) {
 .panel .sectioned { grid-template-columns:111px minmax(0,1fr); gap:9px; }
 .pause-layout .stat-sections { grid-template-columns:80px minmax(0,1fr); gap:7px; }
 .pause-layout .stat-grid { grid-template-columns:1fr; }
}
@media (max-width:700px) {
 .panel .sectioned,.pause-layout .stat-sections { grid-template-columns:minmax(0,1fr); }
 .panel .panel-tabs { flex-direction:row; flex-wrap:wrap; }
 .reward-panel .card.card-weapon,.reward-panel .card.card-compact { min-height:0; }
}
@media (prefers-reduced-motion:reduce) {
 .reward-panel .card[data-family]:hover,.reward-panel .card[data-family]:active,.reward-panel .card[data-committed] { transform:none; }
}
/* Explicit art slot size prevents a large source PNG from extending the modal. */
.reward-panel .card.card-weapon {
  --weapon-art-height:clamp(153px,28vh,218px);
  grid-template-rows:auto var(--weapon-art-height) auto minmax(59px,1fr);
  min-height:clamp(316px,49vh,379px);
}
.reward-panel .card.card-weapon .card-picture { position:relative; min-height:0; height:100%; }
.reward-panel .card.card-weapon .card-picture img {
  position:absolute; inset:0; margin:auto; max-width:100%; max-height:100%;
}
.reward-panel .card-head { background-position:left center; background-size:100% 100%; }
.reward-panel .card-head > .card-tag { position:relative; }
.reward-panel .card[data-family]:hover .card-picture img { filter:drop-shadow(0 2px #fff) drop-shadow(0 6px 10px #101828); }
.reward-panel .card-head { background:none; }
.reward-panel .card-head .card-tag { border:1px solid #e3ebfb55; background:var(--rank-face) center/100% 100% no-repeat,#172740; }
.panel .store-buy .coin img { height:22px!important; width:22px!important; }
.panel .section-name { scroll-margin-top:4px; }
.achievement-art .milestone {
  position:absolute; left:-3px; bottom:-2px; padding:1px 3px; font-size:14px; line-height:1;
  color:#fff5bf; background:#1c293e; border:1px solid #ad9564; border-radius:3px;
}
#boss-progress .progress-track { background:linear-gradient(#415571,#28394e); }
#boss-warning { font-size:0; }
#boss-warning::before {
  background:#ffe380; opacity:1;
  mask:url(assets/sausage/ui-v4/Sfx_BossHpBG_6.png) center/contain no-repeat;
}
.panel.settlement-panel .metric > span { color:#eaf3ff; font-size:16px; }
.promotion-card::before {
  background:
    radial-gradient(circle at 24% 13%,#e6e9ff 0 1px,transparent 2px) 0 0/53px 61px,
    radial-gradient(circle at 68% 54%,#b6a4fe 0 1px,transparent 2px) 6px 4px/67px 47px,
    radial-gradient(ellipse at 50% 32%,#554991,#222047 68%,#151b36);
}
/* R3 promotion layout. The existing sample timeline and trigger remain intact. */
#pet-promotion[data-result] { width:min(720px,94vw); top:50%; }
#pet-promotion[data-result] > .promotion-announcement {
  position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap;
}
#pet-promotion[data-result] .promotion-stage { height:0; aspect-ratio:auto; }
#pet-promotion .promotion-card.promotion-result {
  top:0; width:min(550px,94vw); height:min(73vh,640px); aspect-ratio:auto;
  padding:20px 24px 17px; display:grid; grid-template-rows:auto minmax(0,1fr); align-items:stretch;
  transform:translate(-50%,-50%) scale(max(.77,var(--card-scale)));
  border:1px solid #f1c980; border-radius:14px 27px 14px 27px;
  outline:1px solid #f1c98088; outline-offset:-7px; box-shadow:0 0 35px #1a153d88;
  background:none;
}
#pet-promotion .promotion-result[hidden] { display:none; }
#pet-promotion .promotion-result::before {
  border-radius:inherit;
  background:
    radial-gradient(circle at 18% 14%,#d4dfff 0 1px,transparent 1.8px) 0 0/62px 63px,
    radial-gradient(circle at 72% 41%,#c2a9ff 0 1px,transparent 1.8px) 11px 3px/77px 78px,
    radial-gradient(ellipse at 50% 49%,#6856a6,#34285f 52%,#1a1d40 94%);
}
.promotion-result-heading {
  display:grid; justify-items:center; gap:3px; padding:5px 0 11px;
  border-bottom:1px solid #efd397a0; color:#fff;
  background:linear-gradient(90deg,transparent,#b196e447,transparent);
}
.promotion-result-heading > strong {
  font-size:clamp(30px,4.9vw,55px); font-style:italic; font-weight:900; line-height:1.05;
  text-shadow:0 0 13px #d5c6ff,0 3px #252047;
}
.promotion-result-heading > span { font-size:21px; text-shadow:0 0 8px #d7c7ff; }
.promotion-card .promotion-portrait > .promotion-pet-art {
  width:min(85%,120px); height:min(12vh,110px); aspect-ratio:auto; border:0; border-radius:0; background:transparent; box-shadow:none;
}
.promotion-result .promotion-portrait {
  display:grid; grid-template-rows:minmax(0,1fr) auto; align-content:normal; align-items:center;
  justify-items:center; min-height:0; gap:5px; padding:9px 0 8px;
}
.promotion-result .promotion-portrait > .promotion-pet-art {
  width:min(85%,300px); height:min(100%,289px); object-fit:contain; max-width:100%; max-height:100%;
  filter:drop-shadow(0 0 16px #ccc1f599) drop-shadow(0 5px 7px #22182e);
}
.promotion-result .promotion-portrait > .card-stars { gap:7px; }
.promotion-result .promotion-portrait > .card-stars img { width:26px; height:26px; }
#labels .enemy-life[data-unit-tier="elite"] { --tier-medal:url(assets/sausage/ui-v4-r3/EliteHpBarIcon.png); }
#labels .enemy-life[data-unit-tier="senior"] { --tier-medal:url(assets/sausage/ui-v4-r3/SeniorHpBarIcon.png); }
#labels .enemy-life:is([data-unit-tier="elite"],[data-unit-tier="senior"]) {
  display:flex; align-items:center; gap:4px;
}
#labels .enemy-life:is([data-unit-tier="elite"],[data-unit-tier="senior"])[hidden] { display:none; }
#labels .enemy-life:is([data-unit-tier="elite"],[data-unit-tier="senior"])::before {
  content:""; width:20px; height:20px; background:var(--tier-medal) center/contain no-repeat;
}

/* Pressed and disabled states shared by control types that had no R2 variant. */
.panel .panel-tabs button:active:not(:disabled) { transform:translateY(2px); background-color:#1b2c45; }
#touch button:hover:not(:disabled) { filter:brightness(1.14); }
#game button:disabled:not(.store-buy) {
  cursor:default; filter:grayscale(.7) brightness(.74); opacity:.76;
  transform:none;
}
/* Chest reward UI. Header and action bar stay accessible while a long list scrolls. */
#overlay .r4-reward-panel {
  width:min(1050px,100%); max-height:calc(100dvh - 32px);
  display:flex; flex-direction:column; overflow:hidden; padding-bottom:14px;
}
.r4-reward-panel > header,.r4-reward-panel > .muted,.r4-reward-panel > .buttons { flex:none; }
.r4-reward-panel .r4-card-scroll { overflow-y:auto; overflow-x:hidden; min-height:0; padding:5px 7px 10px; }
.r4-reward-panel .cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; padding:0; }
.r4-reward-panel[data-card-count="1"] .cards { grid-template-columns:minmax(0,420px); justify-content:center; }
.r4-reward-panel[data-card-count="2"] .cards { grid-template-columns:repeat(2,minmax(0,350px)); justify-content:center; }
.r4-reward-panel .card.r4-card {
  position:relative; min-width:0; min-height:350px; display:flex; flex-direction:column; align-items:stretch;
  gap:7px; text-align:left; padding:10px 13px 13px; border-width:1px 2px 2px; border-top-width:4px;
}
.r4-reward-panel .r4-card:hover { transform:translateY(-2px) scale(1.015); }
.r4-reward-panel .r4-card:active { transform:translateY(-2px) scale(1.025); }
.r4-card .card-head { margin-bottom:0; min-height:28px; }
.r4-card-art { display:flex; align-items:center; justify-content:center; min-width:0; height:clamp(120px,24vh,192px); }
.r4-card-art img { min-width:0; width:auto; max-width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 5px 5px #101629); }
.r4-card-art:has(img:nth-child(2)) img { max-width:48%; }
.r4-card > strong { display:block; font-size:21px; line-height:1.13; }
.r4-card-copy { display:flex; flex-wrap:wrap; gap:4px 5px; align-items:start; font-size:16px; line-height:1.23; }
.r4-card-copy .effect-unit,.r4-card-copy .effect-phrase { max-width:100%; }
.r4-values { display:grid; gap:2px; margin-top:auto; }
.r4-delta { display:flex; justify-content:space-between; gap:7px; align-items:baseline; padding:3px 6px; background:#102039ad; border-radius:4px; font-size:16px; }
.r4-delta b { text-align:right; color:#d7fff3; font-variant-numeric:tabular-nums; white-space:nowrap; }
.r4-card .r4-delta b { font-size:16px; }
.r4-reward-panel > .buttons { flex-wrap:wrap; margin-top:7px; gap:6px; }
.r4-reward-panel .r4-reroll[data-short] { border-color:#65738e; color:#c1cbdc; background:#283143; }
.r4-reward-panel .r4-reroll .price { color:#ffeec2; font-size:17px; }
.r4-reward-panel .r4-reroll[data-short] .price { color:#c9d2e5; }
.r4-entry-flight,.r4-choice-ghost { position:fixed; z-index:12; pointer-events:none; }
.r4-entry-flight { width:155px; height:155px; object-fit:contain; translate:-50% -50%; filter:drop-shadow(0 0 22px #ffda6f); }
.r4-choice-ghost {
  display:grid; place-content:center; padding:12px; color:white; text-align:center;
  border:2px solid #8094b1; border-radius:8px; background:linear-gradient(145deg,#527293,#1b2b45);
}
.r4-choice-ghost.r4-selection-flight { z-index:13; border-color:#ffdd77; box-shadow:0 0 16px #ffc04b8c; }
.r4-choice-ghost[data-family="blue"] { background:linear-gradient(145deg,#4e7eaa,#22436b); }
.r4-choice-ghost[data-family="dark"] { background:linear-gradient(145deg,#8a69b2,#453260); }
.r4-choice-ghost[data-family="red"],.r4-choice-ghost[data-family="relic"] { background:linear-gradient(145deg,#b77931,#52321d); }
.r4-choice-ghost[data-family="pet"] { background:linear-gradient(145deg,#2d806e,#1b5042); }
.r4-choice-ghost strong { font-size:20px; }
@media(max-width:700px) {
  #overlay .r4-reward-panel { max-height:calc(100dvh - 18px); padding-inline:10px; }
  .r4-reward-panel .cards,.r4-reward-panel[data-card-count="2"] .cards { grid-template-columns:minmax(0,1fr); gap:9px; }
  .r4-reward-panel .card.r4-card {
    min-height:175px; display:grid; grid-template-columns:minmax(72px,29%) minmax(0,1fr);
    grid-template-rows:auto auto auto auto;
    grid-template-areas:"head head" "art name" "art stats" "art numbers"; gap:5px 8px; padding:8px;
  }
  .r4-card > strong { grid-area:name; font-size:18px; }
  .r4-card-art { grid-area:art; height:100%; min-height:94px; max-height:142px; }
  .r4-card-copy { grid-area:stats; }
  .r4-values { grid-area:numbers; }
  .r4-delta { font-size:14px; }
  .r4-card .r4-delta b { font-size:14px; }
  .r4-reward-panel .buttons > .action { min-height:44px; font-size:14px; }
  .r4-reward-panel .r4-card:hover,.r4-reward-panel .r4-card:active { transform:none; }
}

.r4-card-art:is([data-art-kind="equipment"],[data-art-kind="heal"],[data-art-kind="double"],[data-art-kind="gold"]) img { height:min(100%,105px); }
.r4-reward-panel .r4-reroll[data-short] .price.price-short { color:#fff; background:#992f4e; }
@media (max-width:700px) {
  .r4-card-art:is([data-art-kind="equipment"],[data-art-kind="heal"],[data-art-kind="double"],[data-art-kind="gold"]) img { height:min(100%,85px); }
}
@media (prefers-reduced-motion:reduce) {
  .r4-reward-panel .r4-card:hover,.r4-reward-panel .r4-card:active { transform:none; }
}

/* Override the earlier narrow rule that made every reward child unshrinkable. */
#overlay .r4-reward-panel > .r4-card-scroll { flex:0 1 auto; }
@media(max-width:700px) {
  .r4-card-art { height:104px; min-height:0; align-self:center; }
}

/* V4 UI R5: larger desktop reward cards, family upgrade path, ride banner. */
.r5-path { display:flex; align-items:center; gap:6px; padding:4px 8px; border-radius:5px; background:#0e1a30b8; color:#d5e1f5; font-size:15px; line-height:1.2; }
.r5-path > em { font-style:normal; margin-right:auto; white-space:nowrap; }
.r5-path > i { font-style:normal; color:#ffe08a; font-size:18px; }
.r5-path > img { flex:0 1 62px; min-width:0; width:62px; height:40px; object-fit:contain; filter:drop-shadow(0 2px 2px #0b1220); }
.r5-path > img[data-current] { outline:2px solid #ffdd77; outline-offset:1px; border-radius:4px; }
.r4-card[data-family="blue"] { --r5-glow:#7fd2ff; }
.r4-card[data-family="dark"] { --r5-glow:#cf9bff; }
.r4-card[data-family="red"] { --r5-glow:#ffb14d; }
.r4-card:is([data-family="blue"],[data-family="dark"],[data-family="red"]) .r4-card-art[data-art-kind="bow"] img {
  filter:drop-shadow(0 0 1.5px var(--r5-glow)) drop-shadow(0 0 1.5px var(--r5-glow)) drop-shadow(0 0 13px var(--r5-glow)) drop-shadow(0 5px 5px #101629);
}
.r5-more { flex:none; align-self:center; position:relative; z-index:2; visibility:hidden; height:28px; margin:-31px 0 3px; padding:4px 14px; border-radius:14px;
  background:#ffd659; color:#1d2a3f; font-size:15px; font-weight:800; line-height:20px; box-shadow:0 3px 0 #9b6a17,0 0 0 2px #1d2a3f; pointer-events:none; }
.r4-reward-panel[data-more] > .r5-more { visibility:visible; }
.r4-reward-panel[data-more] > .r4-card-scroll { mask-image:linear-gradient(#000 calc(100% - 54px),#0000); }
@media (min-width:701px) {
  #overlay .r4-reward-panel { width:min(1120px,100%); }
  .r4-reward-panel .card.r4-card { min-height:clamp(380px,62.5vh,520px); gap:8px; padding:12px 15px 14px; }
  .r4-card-art { height:clamp(120px,21vh,200px); }
  .r4-reward-panel:not([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-card-art[data-art-kind="pet"] img { scale:1.3; }
  .r4-reward-panel .r4-card > strong { font-size:24px; }
  .r4-reward-panel .r4-card .mode-line,.r4-reward-panel .r4-card .mode-mark { font-size:16px; }
  .r4-reward-panel .r4-card .r4-card-copy,.r4-reward-panel .r4-card .r4-card-copy :is(.effect-unit,.effect-phrase,.effect-unit b,.effect-unit span) { font-size:17px; }
  .r4-reward-panel .r4-card .r4-delta,.r4-reward-panel .r4-card .r4-delta b { font-size:17px; }
  .r4-delta { padding:4px 8px; }
  /* Four to six cards: side-by-side art and copy so two rows fit one screen where possible. */
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .card.r4-card {
    min-height:0; display:grid; grid-template-columns:minmax(88px,31%) minmax(0,1fr); grid-template-rows:auto auto auto 1fr;
    grid-template-areas:"head head" "art name" "art stats" "path numbers"; gap:5px 9px; padding:8px 10px 10px; align-content:start;
  }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-card > strong { grid-area:name; font-size:20px; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-card-art { grid-area:art; height:92px; align-self:center; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-card-copy { grid-area:stats; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-values { grid-area:numbers; margin-top:0; align-self:start; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-card :is(.r4-card-copy,.effect-unit,.effect-phrase,.effect-unit b,.effect-unit span,.r4-delta,.r4-delta b) { font-size:15px; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r4-delta { padding:2px 6px; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r5-path { grid-area:path; align-self:start; flex-wrap:wrap; justify-content:center; gap:2px 3px; padding:3px 4px; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r5-path > em { width:100%; margin:0; text-align:center; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r5-path > img { width:27px; height:20px; }
  .r4-reward-panel:is([data-card-count="4"],[data-card-count="5"],[data-card-count="6"]) .r5-path > i { font-size:13px; }
}
@media (max-width:700px) {
  /* Portrait keeps the R4 card heights: the path sits in the free right half of the header row. */
  .r5-path { position:absolute; z-index:1; top:7px; right:8px; gap:3px; padding:2px 6px; font-size:13px; }
  .r5-path > em { margin-right:3px; }
  .r5-path > img { flex:none; width:32px; height:22px; }
  .r5-path > i { font-size:13px; }
}
.r5-ride-banner { position:absolute; z-index:3; left:50%; top:max(58px,calc(env(safe-area-inset-top) + 54px)); transform:translate(-50%,0);
  display:flex; align-items:center; gap:14px; min-width:min(430px,88vw); max-width:92vw; padding:10px 26px 10px 16px; pointer-events:none;
  color:#fff; background:linear-gradient(100deg,#22314bf2,#2f4670f2 62%,#22314bf2); border:2px solid #ffd659; border-radius:10px;
  box-shadow:0 4px 0 #131c2d,0 0 22px #ffd65966; clip-path:polygon(14px 0,100% 0,calc(100% - 14px) 100%,0 100%); }
.r5-ride-banner > img { width:64px; height:64px; object-fit:contain; flex:none; filter:drop-shadow(0 3px 3px #0b1220); }
.r5-ride-copy { display:grid; gap:1px; min-width:0; }
.r5-ride-copy > small { color:#ffe08a; font-size:15px; font-weight:800; letter-spacing:.08em; }
.r5-ride-copy > strong { font-size:28px; line-height:1.1; font-style:italic; text-shadow:0 2px #101827; }
.r5-ride-gains { display:flex; flex-wrap:wrap; gap:3px 12px; font-size:17px; }
.r5-ride-gains b { color:#80ffe0; }
.r5-ride-light { position:fixed; z-index:3; width:120px; height:120px; object-fit:contain; translate:-50% -50%; pointer-events:none; filter:drop-shadow(0 0 18px #ffda6f); }
@media (max-width:700px) {
  .r5-ride-banner { top:max(204px,calc(env(safe-area-inset-top) + 200px)); gap:8px; padding:6px 18px 6px 12px; }
  .r5-ride-banner > img { width:42px; height:42px; }
  .r5-ride-copy > small { font-size:13px; }
  .r5-ride-copy > strong { font-size:20px; }
  .r5-ride-gains { font-size:14px; gap:2px 9px; }
}

/* V4 UI R6: HUD under the overhead camera. Thin route progress; the boss bar opens only in fight range. */
#boss-progress { top:max(10px,env(safe-area-inset-top)); height:10px; width:clamp(180px,26vw,360px); transition:opacity .2s ease-out; }
#boss-progress .progress-fill { inset:2px auto 2px 2px; border-radius:3px; }
#boss-progress .progress-marks { inset:2px; }
#boss-progress .progress-hero { width:26px; height:28px; }
#boss-progress[data-engaged] { opacity:0; }
#bossbar { top:max(8px,env(safe-area-inset-top)); width:min(38vw,460px); grid-template-columns:40px minmax(0,1fr) auto; align-items:center; column-gap:8px; row-gap:2px;
  padding:3px 10px 6px; transform-origin:50% 0; transition:opacity .2s ease-out,scale .2s ease-out,visibility 0s linear 0s; }
#bossbar[data-state="closed"] { opacity:0; scale:.55 .2; visibility:hidden; pointer-events:none; transition:opacity .2s ease-in,scale .2s ease-in,visibility 0s linear .2s; }
#bossbar #boss-portrait { width:38px; height:42px; }
#bossbar #bossname { grid-column:2; grid-row:1; justify-self:start; padding:0; font-size:16px; line-height:1.15; overflow:hidden; text-overflow:ellipsis; max-width:100%; }
#bossbar .r6-boss-percent { grid-column:3; grid-row:1; color:#ffe9a8; font-size:15px; line-height:1.15; font-variant-numeric:tabular-nums; text-shadow:0 1px #101827; }
#bossbar progress { grid-column:2 / 4; grid-row:2; height:12px; }
#bossbar .r6-boss-ticks { grid-column:2 / 4; grid-row:2; align-self:stretch; height:12px; position:relative; z-index:1; pointer-events:none;
  background:linear-gradient(#fff,#fff) 25% 0/2px 100% no-repeat,linear-gradient(#fff,#fff) 50% 0/2px 100% no-repeat,linear-gradient(#fff,#fff) 75% 0/2px 100% no-repeat; opacity:.85; }
#bossbar::before { left:54px; }
/* Overhead view puts the boss at the top centre of the screen, so on landscape the open bar docks under the top-right buttons. */
@media (min-width:701px) {
  #bossbar { left:auto; right:max(20px,env(safe-area-inset-right)); transform:none; transform-origin:100% 0; top:max(70px,calc(env(safe-area-inset-top) + 66px)); width:min(34vw,400px); }
}
#boss-warning { height:22px; bottom:-26px; font-size:14px; }
/* Enemy plates: size comes from screen height (far = small), 12 px floor; tier medal kept. */
#labels .world-label.enemy-life,#labels .world-label.boss-life { font-size:var(--life-size,16px); font-weight:800; line-height:1.15; padding:1px 5px; min-width:1.6em; text-align:center;
  font-variant-numeric:tabular-nums; letter-spacing:0; color:#fff; background:#16233ae8; border:1px solid #c9d8f2; border-radius:4px; text-shadow:0 1px 0 #0a1220,0 0 2px #0a1220; }
#labels .world-label.boss-life { color:#ffe877; border-color:#ffcf5a; }
/* Ride banner slots and the chest-to-rider light. */
@media (min-width:701px) { .r5-ride-banner { top:max(28px,calc(env(safe-area-inset-top) + 24px)); } }
.r5-ride-banner[data-slot="side"] { left:max(20px,env(safe-area-inset-left)); top:var(--r6-side-top,180px); transform:none; min-width:0; max-width:min(400px,34vw); }
/* 768x512 render with the mount in the middle band: cover-crop the empty top and bottom. */
.r5-ride-banner > img[data-ui-asset^="v4-art/mounts"] { width:150px; height:64px; object-fit:cover; }
.r5-ride-light { width:190px; height:190px; filter:brightness(1.5) drop-shadow(0 0 10px #fff) drop-shadow(0 0 26px #ffcf4a); }
.r6-ride-trail { position:fixed; z-index:3; height:14px; margin-top:-7px; transform-origin:0 50%; pointer-events:none; border-radius:7px;
  background:linear-gradient(90deg,#ffd65900,#ffe9a0 18%,#fff 82%,#ffffff00); box-shadow:0 0 14px 4px #ffcf4acc; }
.r6-ride-ring { position:fixed; z-index:3; width:150px; height:56px; translate:-50% -50%; pointer-events:none; border-radius:50%;
  border:5px solid #fff3b8; box-shadow:0 0 16px 5px #ffcf4acc,inset 0 0 12px #ffcf4a; }
@media (max-width:700px) {
  #boss-progress { top:max(8px,env(safe-area-inset-top)); left:auto; right:max(10px,env(safe-area-inset-right)); translate:none; width:min(46vw,190px); height:9px; }
  /* Portrait: the bar takes the free strip right of the health pill, above the stat block. */
  #bossbar { left:auto; right:max(10px,env(safe-area-inset-right)); transform:none; width:calc(100vw - 144px); max-width:300px; transform-origin:100% 0; grid-template-columns:34px minmax(0,1fr) auto; padding:3px 8px 5px; }
  #bossbar #boss-portrait { width:32px; height:36px; }
  #boss-warning { left:auto; right:0; translate:none; width:82%; }
  .r5-ride-banner[data-slot="side"] { left:50%; top:auto; bottom:max(70px,calc(env(safe-area-inset-bottom) + 66px)); max-width:92vw; min-width:min(430px,88vw); transform:translate(-50%,0); }
  .r5-ride-banner > img[data-ui-asset^="v4-art/mounts"] { width:104px; height:44px; }
  .r5-ride-light { width:150px; height:150px; }
  .r6-ride-ring { width:120px; height:46px; }
}
@media (prefers-reduced-motion:reduce) { #boss-progress,#bossbar,#bossbar[data-state="closed"] { transition:none; } }

/* ===== V4 UI R7: non-battle screens (lobby, store, records, achievements, settings, pause, stats, settlement, promotion, start-up failure) ===== */
/* Quality backing: 0 grey, 1 green, 2 blue, 3 purple, 4 orange. Same families as the reward cards. */
:root {
  --q0-hi:#607491; --q0-lo:#38445d; --q0-edge:#a9b6cc;
  --q1-hi:#2f947e; --q1-lo:#1b5145; --q1-edge:#8be6cd;
  --q2-hi:#4d83b3; --q2-lo:#224a78; --q2-edge:#a3d1f6;
  --q3-hi:#8b6fbe; --q3-lo:#463471; --q3-edge:#cfbaff;
  --q4-hi:#ce913e; --q4-lo:#7d451e; --q4-edge:#ffd98a;
}
[data-quality="0"] { --q-hi:var(--q0-hi); --q-lo:var(--q0-lo); --q-edge:var(--q0-edge); }
[data-quality="1"] { --q-hi:var(--q1-hi); --q-lo:var(--q1-lo); --q-edge:var(--q1-edge); }
[data-quality="2"] { --q-hi:var(--q2-hi); --q-lo:var(--q2-lo); --q-edge:var(--q2-edge); }
[data-quality="3"] { --q-hi:var(--q3-hi); --q-lo:var(--q3-lo); --q-edge:var(--q3-edge); }
[data-quality="4"] { --q-hi:var(--q4-hi); --q-lo:var(--q4-lo); --q-edge:var(--q4-edge); }

/* Renders are cropped to their alpha bounds by ui.mjs; hold them back until that is known so they never jump. */
img.ui-render { object-fit:contain; }
img.ui-render:not([data-fit]) { visibility:hidden; }

/* Icon plate: quality backing, thick white outline on the picture. */
.art-plate {
  position:relative; flex:none; display:grid; place-items:center; box-sizing:border-box;
  width:var(--plate,56px); height:var(--plate,56px); border:2px solid var(--q-edge,#a9b6cc); border-radius:9px;
  background:var(--v4-quality) center/100% 100% no-repeat,linear-gradient(160deg,var(--q-hi,#607491),var(--q-lo,#38445d));
  box-shadow:inset 0 -3px 0 #0b122255,0 2px 0 #0b1222;
}
#overlay .panel .art-plate > img:first-child {
  position:static; width:84%!important; height:84%!important; margin:0; padding:0; border:0; border-radius:0; background:none; box-shadow:none; opacity:1; object-fit:contain;
  filter:drop-shadow(1px 0 #fff) drop-shadow(-1px 0 #fff) drop-shadow(0 1px #fff) drop-shadow(0 -1px #fff) drop-shadow(0 2px 1px #0b1222b0);
}

/* Shared panel pieces */
#overlay .panel .panel-tabs button { font-size:16px; }
#overlay .panel .stat-sections h4 { font-size:16px; }
#overlay .collection-scroll::-webkit-scrollbar-thumb { background:#3fc7a8; border:3px solid #152038; border-radius:8px; }
#overlay .panel .status-chip { font-size:14px; line-height:1.3; padding:2px 8px; border-radius:5px; }

/* Reminder badge: a count at the top-right corner of an entry (lobby "荣誉贴纸", tabs of the sticker panel). Accent mint on the dark buttons. */
.notice-badge {
  position:absolute; top:-9px; right:-9px; z-index:2; box-sizing:border-box; display:grid; place-items:center;
  min-width:26px; height:26px; padding:0 7px; border:2px solid #0f1a2c; border-radius:13px;
  background:var(--gd-mint); color:#06261d; box-shadow:0 2px 0 #0b1222;
  font-size:15px; line-height:1; font-weight:900; font-style:normal; font-variant-numeric:tabular-nums; text-shadow:none; pointer-events:none;
}
#overlay .action[data-notice],#overlay .panel .panel-tabs button[data-notice] { position:relative; overflow:visible; }
#overlay .panel .panel-tabs button > .notice-badge { top:-8px; right:-4px; min-width:24px; height:24px; padding:0 6px; border-radius:12px; font-size:14px; }

/* Store: product card = plate + name + level, one line of copy, buy button */
#overlay .panel .product {
  display:grid; grid-template-columns:auto minmax(0,1fr); grid-template-rows:auto auto minmax(2.6em,auto) auto;
  grid-template-areas:"art name" "art level" "copy copy" "buy buy"; gap:4px 10px; align-items:center;
  padding:10px; border:1px solid #7386a6; border-top:4px solid var(--q-hi); border-radius:8px;
  background:linear-gradient(162deg,var(--q-lo) 0,#25344d 44%,#1b2740); box-shadow:none;
}
#overlay .panel .product > .art-plate { grid-area:art; --plate:64px; }
#overlay .panel .product > h3 { grid-area:name; align-self:end; margin:0; font-size:18px; line-height:1.2; overflow-wrap:anywhere; }
#overlay .panel .product > .status-chip { grid-area:level; justify-self:start; align-self:start; margin:0; }
#overlay .panel .product > .muted { grid-area:copy; align-self:start; margin:0; font-size:16px; line-height:1.3; }
#overlay .panel .product > .store-buy { grid-area:buy; min-height:44px; font-size:16px; }

/* Achievements: plate with tier colour, state at the right */
#overlay .panel .achievement {
  grid-template-columns:auto minmax(0,1fr) auto; gap:10px; align-items:center; min-height:68px; padding:8px 12px 8px 8px;
  border:1px solid #7386a6; border-left:4px solid var(--q-hi); border-radius:8px;
  background:linear-gradient(100deg,var(--q-lo) 0,#25344d 36%,#1e2b44); box-shadow:none;
}
#overlay .panel .achievement > .art-plate { --plate:52px; width:var(--plate); height:var(--plate); background:var(--v4-quality) center/100% 100% no-repeat,linear-gradient(160deg,var(--q-hi),var(--q-lo)); border-radius:9px; }
#overlay .panel .achievement strong { display:block; font-size:17px; line-height:1.25; }
#overlay .panel .achievement small { display:block; font-size:14px; line-height:1.3; color:#dbe7f7; }
#overlay .panel .achievement[data-state="locked"] { border-left-color:#5b6a84; background:#1e2a41; }
#overlay .panel .achievement[data-state="locked"] > .art-plate { --q-hi:#4b5970; --q-lo:#2c384c; --q-edge:#7f8da6; }
#overlay .panel .achievement[data-state="locked"] > .art-plate > img:first-child {
  filter:grayscale(.9) brightness(.78) drop-shadow(1px 0 #c6d0df) drop-shadow(-1px 0 #c6d0df) drop-shadow(0 1px #c6d0df) drop-shadow(0 -1px #c6d0df); opacity:.82;
}
#overlay .panel .achievement[data-state="locked"] strong { color:#d5deeb; }
.achievement-state { display:grid; justify-items:end; align-content:center; gap:3px; }
.achievement-state .coin { display:inline-flex; align-items:center; gap:4px; font-size:16px; font-variant-numeric:tabular-nums; }
#overlay .panel .achievement .muted { font-size:14px; color:#c3cfe2; }
#overlay .panel .achievement .action.claim { min-height:44px; padding:4px 12px; gap:8px; font-size:16px; background:#2f3744; border:2px solid #ffcc55; color:#fff8d4; }
#overlay .panel .achievement .action.claim:hover { background:#665329; }
#overlay .panel .achievement .action.claim .coin { color:#ffec9d; }
.lock-badge { position:absolute; right:-6px; bottom:-6px; display:grid; place-items:center; width:22px; height:22px; background:#151d30; border:1px solid #8293b0; border-radius:6px; }
#overlay .panel .lock-badge > img { position:static; width:13px!important; height:15px!important; background:none; border-radius:0; filter:none; opacity:1; }
#overlay .panel .achievement-art .milestone { left:-5px; top:-7px; bottom:auto; z-index:1; }

/* Settings: slider with a mint fill and a value, switch instead of the native checkbox */
#overlay .panel .option {
  min-height:56px; margin:6px 0; padding:6px 12px; gap:12px; font-size:16px; border:1px solid #7f92b4; border-radius:8px;
  background:linear-gradient(#34455f,#27344c); box-shadow:none; cursor:pointer;
}
#overlay .panel .option > span { flex:1 1 auto; min-width:5em; }
#overlay .panel .option-range input[type="range"] {
  -webkit-appearance:none; appearance:none; flex:0 1 250px; width:auto; min-width:110px; height:44px; min-height:44px; margin:0; background:transparent; cursor:pointer;
}
#overlay .panel .option-range input[type="range"]::-webkit-slider-runnable-track {
  height:12px; border:1px solid #8ea3c4; border-radius:7px; background:linear-gradient(90deg,var(--gd-mint) var(--fill,50%),#101a2c var(--fill,50%));
}
#overlay .panel .option-range input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance:none; appearance:none; width:26px; height:26px; margin-top:-8px; border:4px solid #17243a; border-radius:50%; background:#fff; box-shadow:0 0 0 2px #fff,0 3px 0 #0b1222;
}
#overlay .panel .option-range input[type="range"]::-moz-range-track { height:12px; border:1px solid #8ea3c4; border-radius:7px; background:#101a2c; }
#overlay .panel .option-range input[type="range"]::-moz-range-progress { height:12px; border-radius:7px; background:var(--gd-mint); }
#overlay .panel .option-range input[type="range"]::-moz-range-thumb { width:20px; height:20px; border:4px solid #17243a; border-radius:50%; background:#fff; box-shadow:0 0 0 2px #fff; }
#overlay .panel .option-range output { flex:none; width:3.1em; text-align:right; font-size:16px; font-variant-numeric:tabular-nums; color:#fff5b9; }
#overlay .panel .option-toggle input[type="checkbox"] {
  -webkit-appearance:none; appearance:none; position:relative; flex:none; width:58px; height:32px; min-height:0; margin:6px 0; border:2px solid #8ea3c4; border-radius:16px;
  background:#101a2c; cursor:pointer; transition:background-color .15s,border-color .15s;
}
#overlay .panel .option-toggle input[type="checkbox"]::before {
  content:""; position:absolute; top:3px; left:3px; width:22px; height:22px; border-radius:50%; background:#fff; box-shadow:0 2px 0 #0b1222; transition:translate .15s;
}
#overlay .panel .option-toggle input[type="checkbox"]:checked { background:var(--gd-mint); border-color:#b6ffe9; }
#overlay .panel .option-toggle input[type="checkbox"]:checked::before { translate:26px 0; }
#overlay .panel .option input:focus-visible { outline:3px solid var(--gd-mint); outline-offset:3px; box-shadow:none; }

/* Stats: readable icons */
#overlay .panel .stat-tile { grid-template-columns:auto minmax(0,1fr) auto; gap:8px; min-height:56px; padding:6px 10px 6px 6px; border-radius:8px; }
#overlay .panel .stat-tile:not(:has(.art-plate)) { grid-template-columns:minmax(0,1fr) auto; padding-left:10px; }
#overlay .panel .stat-tile > .art-plate { --plate:42px; border-width:1px; border-radius:7px; box-shadow:none; }
#overlay .panel .stat-tile > span:not(.art-plate) { font-size:16px; }
#overlay .panel .stat-tile > strong { font-size:22px; }
/* The cape bonus kept a dark green meant for light panels (an old !important rule) */
#overlay .panel .stat-tile .cape-bonus { color:#95ffe5!important; }

/* Record chips (records list and settlement) */
#overlay .panel .record-buffs .loadout-item img { width:28px; height:28px; }
#overlay .panel .record-buffs .loadout-item img.ui-render { width:40px; }

@media (prefers-reduced-motion:reduce) {
  #overlay .panel .option-toggle input[type="checkbox"],#overlay .panel .option-toggle input[type="checkbox"]::before { transition:none; }
}

/* Use the panel height: two rows of products or six achievements without scrolling at 1280x720 */
#overlay .panel .sectioned .collection-scroll { max-height:min(64vh,640px); }

/* Stats: damage totals had 11.8 px labels in a colour meant for light panels */
#overlay .panel .summary > .metric { padding:8px 12px; border-radius:8px; box-shadow:none; }
#overlay .panel .summary > .metric > span { color:#eaf3ff; font-size:16px; line-height:1.25; }
#overlay .panel .summary > .metric > strong { font-size:24px; line-height:1.1; font-variant-numeric:tabular-nums; }
#overlay .panel.settlement-panel > .summary > .metric > strong { font-size:32px; }

/* Records: entry chips and damage columns at readable sizes */
#overlay .panel .record-entry { padding:10px 12px; border-radius:8px; box-shadow:none; }
#overlay .panel .record-entry .scoreline > strong { font-size:20px; }
#overlay .panel .record-entry .scoreline > .muted { font-size:14px; }
#overlay .panel .record-buffs { gap:5px; padding:8px 0; }
#overlay .panel .record-buffs .loadout-item { min-height:36px; padding:2px 6px; gap:5px; font-size:15px; border-width:1px; border-radius:7px; box-shadow:none; }
#overlay .panel .record-buffs .loadout-item .loadout-name { font-size:15px; }
#overlay .panel .record-buffs .loadout-item > strong { font-size:15px; padding:1px 5px; border-radius:4px; }
#overlay .panel .record-damage { gap:5px; }
#overlay .panel .record-damage > div { padding:5px 8px; font-size:14px; border-radius:5px; }
#overlay .panel .record-damage dt { font-size:14px; color:#cfdcee; }
#overlay .panel .record-damage dd { font-size:17px; font-variant-numeric:tabular-nums; }

/* Promotion: the pet fills its slot (renders are cropped to the pet) */
#pet-promotion .promotion-card .promotion-portrait > img.promotion-pet-art { width:92%; height:min(15vh,128px); aspect-ratio:auto; border:0; border-radius:0; background:none; box-shadow:none; }
#pet-promotion .promotion-result .promotion-portrait > img.promotion-pet-art { width:min(88%,380px); height:min(100%,320px); }
#pet-promotion .promotion-result-heading { background:var(--gd-dot) 0 0/7px 7px,linear-gradient(90deg,transparent,#b196e447,transparent); }
/* The three small cards: name and tier on two lines. On one line the caption broke after the number and left "阶" alone. */
#pet-promotion .promotion-card:not(.promotion-result) { padding-inline:2.5%; row-gap:4px; }
/* ...and the pet takes the height the card has left after the stars and the caption (it used to push them onto each other in portrait) */
#pet-promotion .promotion-card:not(.promotion-result) .promotion-portrait { height:100%; min-height:0; grid-template-rows:minmax(0,1fr) auto; align-content:normal; align-items:center; }
#pet-promotion .promotion-card:not(.promotion-result) .promotion-portrait > img.promotion-pet-art { height:100%; min-height:0; max-height:128px; }
#pet-promotion .promotion-card .promotion-copy { display:grid; justify-items:center; gap:3px; }
#pet-promotion .promotion-card .promotion-copy > span { white-space:nowrap; }
#pet-promotion .promotion-card .promotion-copy > span:last-child { font-size:16px; color:#e2d9ff; }

/* Settlement: hero pose at the side of the band, shown only when the package has v4-art/poses/win.png / lose.png */
#overlay .panel.settlement-panel[data-pose] {
  grid-template-columns:minmax(150px,24%) minmax(0,1fr); grid-template-rows:minmax(128px,auto) auto auto minmax(0,1fr) auto;
  grid-template-areas:"band band" "pose note" "pose sums" "pose record" "pose buttons"; column-gap:14px;
}
#overlay .panel.settlement-panel[data-pose] > header { grid-area:band; }
#overlay .panel.settlement-panel[data-pose] > .muted { grid-area:note; }
#overlay .panel.settlement-panel[data-pose] > .summary { grid-area:sums; }
#overlay .panel.settlement-panel[data-pose] > .record-entry { grid-area:record; }
#overlay .panel.settlement-panel[data-pose] > .buttons { grid-area:buttons; }
#overlay .panel.settlement-panel > .settlement-pose {
  grid-area:pose; align-self:end; justify-self:center; width:100%; height:calc(100% + 86px); max-height:420px; margin-top:-86px; z-index:2;
  object-fit:contain; object-position:50% 100%; filter:drop-shadow(0 6px 8px #0b1222aa); pointer-events:none;
}

/* Start-up failure: same panel language as the rest (the text itself lives in index.html) */
html[data-ready="failed"] #overlay { background:var(--gd-dot) 0 0/8px 8px,linear-gradient(160deg,#1e2c42,#121a28); }
html[data-ready="failed"] #overlay > p.panel.narrow {
  position:relative; width:min(560px,100%); padding:72px 22px 22px; overflow:hidden; animation:none;
  font-size:18px; line-height:1.55; text-wrap:balance; color:#fff; border:1px solid #7489a8; border-radius:12px;
  background:linear-gradient(148deg,var(--gd-slate),var(--gd-night) 48%,var(--gd-bottom)); box-shadow:0 8px var(--gd-bottom),0 18px 36px #111624bb;
}
html[data-ready="failed"] #overlay > p.panel.narrow::after {
  content:"载入失败"; position:absolute; left:0; right:0; top:0; height:54px; padding:9px 18px; box-sizing:border-box;
  font-size:30px; line-height:36px; font-weight:900; font-style:italic; color:#fff; -webkit-text-stroke:2px #121a28; paint-order:stroke fill; text-shadow:0 3px #121a28;
  background:var(--gd-hatch),linear-gradient(90deg,#5a2338,#93314a); border-bottom:2px solid #ff8c9c; clip-path:polygon(0 0,100% 0,calc(100% - 12px) 100%,0 100%);
}

/* Portrait: one product per row keeps the name on one line next to its plate */
@media (max-width:700px) {
  #overlay .panel .store { grid-template-columns:minmax(0,1fr); gap:8px; }
  #overlay .panel .product { grid-template-columns:auto minmax(0,1fr) auto; grid-template-rows:auto auto auto; grid-template-areas:"art name level" "art copy copy" "buy buy buy"; }
  #overlay .panel .product > .art-plate { --plate:56px; }
  #overlay .panel .product > h3 { align-self:center; }
  #overlay .panel .product > .status-chip { align-self:center; justify-self:end; }
  #overlay .panel .product > .muted { min-height:0; }
}

/* Long objects in a square plate: swords lie diagonally (as the library's own weapon icons do); wide ones get a little more room */
#overlay .panel .art-plate > img.ui-render:is([data-ui-asset*="/weapons/flyknife"],[data-ui-asset*="/weapons/holy"]) { rotate:-38deg; scale:1.3; }
#overlay .panel .art-plate > img.ui-render[data-shape="wide"]:not([data-ui-asset*="/weapons/holy"]) { scale:1.18; }
#overlay .panel .record-buffs .loadout-item img.ui-render:is([data-ui-asset*="/weapons/flyknife"],[data-ui-asset*="/weapons/holy"]) { rotate:-30deg; scale:1.12; }
@media (max-width:700px) {
  #overlay .panel.settlement-panel[data-pose] { grid-template-columns:minmax(0,1fr); grid-template-areas:"band" "note" "sums" "record" "buttons"; }
  #overlay .panel.settlement-panel[data-pose] > header { padding-right:112px; }
  #overlay .panel.settlement-panel > .settlement-pose { position:absolute; grid-area:auto; right:4px; top:6px; width:112px; height:128px; max-height:none; margin:0; }
}

/* Portrait (390 wide): separate layouts instead of smaller type */
@media (max-width:700px) {
  #overlay .panel:not(.reward-panel) .action { font-size:16px; }
  /* Lobby: the four entries form two rows above the start button, clear of the hero's legs */
  #overlay .menu-buttons { grid-template-columns:repeat(2,minmax(0,1fr)); justify-items:stretch; left:50%; right:auto; transform:translateX(-50%); width:min(92vw,400px); padding:0; gap:8px; }
  #overlay .menu-buttons .action:not(.launch) { width:auto; min-width:0; font-size:16px; }
  #overlay .menu-buttons .launch { grid-column:1 / -1; grid-row:3; aspect-ratio:auto; height:76px; min-height:76px; }
  /* Pause: one scroll area. The action panel stays in view, the stat list takes the rest of the screen */
  #overlay .pause-layout { display:flex; flex-direction:column; align-items:stretch; width:100%; max-height:100%; overflow:hidden; gap:8px; }
  #overlay .pause-layout > .panel.narrow { flex:none; max-height:none; overflow:visible; }
  #overlay .pause-layout > .stats-panel { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; max-height:none; overflow:hidden; }
  #overlay .pause-layout > .stats-panel > header,#overlay .pause-layout > .stats-panel .panel-tabs { flex:none; }
  #overlay .pause-layout > .stats-panel > .sectioned { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; }
  #overlay .pause-layout > .stats-panel .collection-scroll { flex:1 1 auto; min-height:0; max-height:none; }
  /* Stats: one item per row so every label stays on one line beside its plate; pet tiers and damage totals in two columns */
  #overlay .panel .stat-sections .stat-grid { grid-template-columns:minmax(0,1fr); }
  #overlay .panel .stat-sections .pet-stats .stat-grid,#overlay .panel .stat-sections .summary { grid-template-columns:repeat(2,minmax(0,1fr)); }
  #pet-promotion .promotion-card:not(.promotion-result) { padding-block:5%; }
  #pet-promotion .promotion-card .promotion-copy { font-size:14px; }
  #pet-promotion .promotion-card .promotion-copy > span:last-child { font-size:14px; }
}

/* Settlement: the tick / dash beside the title was a drawn shape, not a library icon; the WIN / LOSE art already says it */
#overlay .settlement-panel .outcome-seal { display:none; }
#overlay .lobby-balance > span:last-child { font-size:16px; }

/* ---- Shot count (Lead's supplement): HUD "弹数 ×N" and reward cards that add bullets per shot ---- */
#hud .hud-stats .stat[data-hud-cell="shots"] { position:relative; overflow:visible; }
#hud .hud-stats .stat[data-hud-cell="shots"] > img { width:22px; height:24px; object-fit:contain; filter:drop-shadow(0 1px 0 #0b1222); }
#hud .hud-stats .stat[data-hud-cell="shots"] #arrows::before { content:"×"; margin-right:1px; font-size:.8em; color:var(--gd-paler); }
/* "+2" beside the cell when the count goes up */
.shot-gain {
  position:absolute; left:calc(100% - 12px); top:-12px; z-index:3; padding:0 6px; border-radius:9px; white-space:nowrap; pointer-events:none;
  font-size:18px; line-height:22px; font-weight:900; font-variant-numeric:tabular-nums; color:#06261d; background:var(--gd-mint); border:2px solid #0f1a2c; box-shadow:0 2px 0 #0b1222;
}
/* Cards: the shot-count entry leads and is bold; the picture carries a row of bullets (dim = already fired, lit = added by this card) */
.reward-panel .r4-card .r4-card-art { position:relative; }
.reward-panel .r4-card .effect-unit[data-lead],.reward-panel .r4-card .effect-phrase[data-lead] { font-weight:900; background:#123459; box-shadow:inset 3px 0 var(--gd-yellow); padding-left:7px; }
.reward-panel .r4-card .effect-unit[data-lead] > span,.reward-panel .r4-card .effect-phrase[data-lead] { font-weight:900; color:#fff; }
.reward-panel .r4-card .r4-delta[data-lead] { font-weight:900; background:#123459; box-shadow:inset 3px 0 var(--gd-yellow); }
.reward-panel .r4-card .r4-delta[data-lead] > span { font-weight:900; color:#fff; }
.reward-panel .r4-card .r4-delta[data-lead] > b { font-weight:900; color:#ffe680; }
.shot-diagram {
  position:absolute; right:2px; bottom:2px; z-index:1; display:inline-flex; align-items:center; gap:1px; padding:3px 6px; border-radius:7px;
  background:#0e1629d9; border:1px solid #f3f7ff66; pointer-events:none;
}
.shot-diagram { --cap:6; --step:20.4px; --tall:22px; }
.shot-diagram > i { display:block; height:var(--tall); background:url(assets/sausage/ui-v4-r2/bullet.png) left center/var(--step) var(--tall) repeat-x; }
.shot-diagram > i[data-new] { width:calc(min(var(--lit),var(--cap)) * var(--step)); }
.shot-diagram > i:not([data-new]) { width:calc(max(0,min(var(--dim),var(--cap) - var(--lit))) * var(--step)); opacity:.38; }
.shot-diagram > b { margin-left:4px; font-size:16px; line-height:1; font-weight:900; color:#ffe680; font-variant-numeric:tabular-nums; }
.shot-diagram > b[data-more="narrow"] { display:none; }
@media (max-width:700px) {
  /* portrait: the readings row is narrow, so the cell keeps the icon and "×N"; the word stays available to screen readers */
  #hud .hud-stats .stat[data-hud-cell="shots"] .hud-key { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  /* portrait cards keep the picture in a narrow column: three bullets at most, then "×N" */
  .shot-diagram { --cap:3; --step:15px; --tall:16.2px; padding:2px 4px; }
  .shot-diagram > b { margin-left:3px; font-size:14px; }
  .shot-diagram > b[data-more="narrow"] { display:inline; }
}

/* ---- Boss WARNING strip (Lead's supplement): one text layer. The library sprite already carries the lettering "W A R N I N G";
   R6 gave the hidden DOM text a font size again, so two layers overlapped ("W AWARNING N G"). The letters stay solid while the
   backing under them pulses (ui.mjs animates ::after). ---- */
#boss-warning { font-size:0; }
#boss-warning::after { content:""; position:absolute; inset:0; z-index:-2; background:#2a0c16; opacity:0; pointer-events:none; }

/* ===== V4 UI R8a: life numbers and the four "why did I lose" fixes =====
   Life numbers: one glyph style for the player, for every unit and for the boss bar, so the numbers can be compared
   at a glance - heavy digits inside a ring, no plate behind them. Player: blue-white with a blue ring, always.
   Units and bosses: red with a white ring when running into them would knock the player out, cream with a dark ring
   otherwise. The digit height on screen is set by ui.mjs (--life-size already allows for the scene's distance scale). */
#labels .world-label:is(.player-life,.enemy-life,.boss-life),#bossbar .r8-boss-life {
  --ink:#fff3d2; --rim:#0f1830; --drop:#000c;
  font-weight:900; line-height:1; letter-spacing:0; font-variant-numeric:tabular-nums; color:var(--ink); white-space:nowrap; -webkit-text-stroke:0;
  text-shadow:
    .07em 0 0 var(--rim), -.07em 0 0 var(--rim), 0 .07em 0 var(--rim), 0 -.07em 0 var(--rim),
    .05em .05em 0 var(--rim), -.05em .05em 0 var(--rim), .05em -.05em 0 var(--rim), -.05em -.05em 0 var(--rim),
    .065em .027em 0 var(--rim), -.065em .027em 0 var(--rim), .065em -.027em 0 var(--rim), -.065em -.027em 0 var(--rim),
    .027em .065em 0 var(--rim), -.027em .065em 0 var(--rim), .027em -.065em 0 var(--rim), -.027em -.065em 0 var(--rim),
    0 .12em .1em var(--drop);
}
:is(#labels .world-label:is(.enemy-life,.boss-life),#bossbar .r8-boss-life)[data-threat="over"] { --ink:#ff4636; --rim:#fff; --drop:#3a0606; }
#labels .world-label.player-life { --ink:#f2f8ff; --rim:#1a58ea; --drop:#051a55; z-index:4; }
#labels .world-label:is(.player-life,.enemy-life,.boss-life) {
  font-size:var(--life-size,24px); min-width:0; padding:.1em .12em .14em; border:0; border-radius:0; background:none; box-shadow:none; text-align:center;
  transition:translate .12s linear, color .12s linear;
}
@media (prefers-reduced-motion:reduce) { #labels .world-label:is(.player-life,.enemy-life,.boss-life) { transition:none; } }
/* The number of the unit nearest to the player is never hidden. The trunk's scene still hides any life label that meets a
   gate board (inline visibility; removed by scene R9) - for the nearest unit that rule is overridden here. */
#labels .world-label[data-life-nearest] { visibility:visible!important; }
/* elite / senior medal keeps its place in front of the digits and scales with them */
#labels .enemy-life:is([data-unit-tier="elite"],[data-unit-tier="senior"]) { gap:.08em; }
#labels .enemy-life:is([data-unit-tier="elite"],[data-unit-tier="senior"])::before {
  flex:none; width:.86em; height:.86em; filter:drop-shadow(0 1px 1px #000a);
}
/* Boss bar: the boss's life as a number between the name and the percentage (a flying boss's own number can be above the screen). */
#bossbar { grid-template-columns:40px minmax(0,1fr) auto auto; }
#bossbar .r8-boss-life { grid-column:3; grid-row:1; font-size:19px; padding:0 2px 1px; }
#bossbar .r6-boss-percent { grid-column:4; }
#bossbar progress,#bossbar .r6-boss-ticks { grid-column:2 / 5; }
/* The same value now floats over the player's head, so the capsule in the corner steps back to the size of its neighbours. */
.hud-stats .stat.health { min-height:38px; min-width:84px; padding:2px 10px; border-width:1px; border-radius:14px; box-shadow:0 2px var(--gd-bottom); }
.hud-stats .stat.health img { width:21px; height:21px; }
.hud-stats .stat.health strong { font-size:19px; }

/* Lobby: the sticker entry says that gold is waiting, and how much (the corner badge still counts the stickers). */
.menu-buttons .action .entry-copy { display:grid; justify-items:start; gap:2px; min-width:0; line-height:1.12; }
.menu-buttons .action .entry-gold { display:inline-flex; align-items:center; gap:3px; font-size:13px; line-height:1.1; color:#ffe680; white-space:nowrap; }
.menu-buttons .action .entry-gold .coin { display:inline-flex; align-items:center; gap:2px; font-variant-numeric:tabular-nums; }
.menu-buttons .action:not(.launch) .entry-gold .coin img { width:15px!important; height:15px!important; filter:none; }

/* Store: what a start upgrade gives - now, the next level, the step per level. The numbers are computed by ui.mjs from
   the game's purchase code. The lines say exactly what the old one-sentence description only hinted at ("each level adds
   starting life"), so they take its place on the card; the sentence stays in the page for screen readers. */
#overlay .panel .product:has(> .level-lines) { grid-template-rows:auto auto 1fr auto; grid-template-areas:"art name" "art level" "levels levels" "buy buy"; }
#overlay .panel .product:has(> .level-lines) > .muted { position:absolute; width:1px; height:1px; min-height:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
#overlay .panel .product > .level-lines { grid-area:levels; align-self:start; display:grid; gap:1px; }
#overlay .panel .level-line { display:flex; align-items:baseline; gap:6px; margin:0; padding:1px 8px; border:1px solid #4b5f80; border-radius:6px; background:#131d31;
  font-size:15px; line-height:1.25; color:#dfeaff; font-variant-numeric:tabular-nums; }
#overlay .panel .level-line > span:first-child { flex:1 1 auto; min-width:0; }
#overlay .panel .level-line > b { font-size:16px; color:#fff; }
#overlay .panel .level-line > b.next { color:#8dffb0; }
#overlay .panel .level-line > i { font-style:normal; color:#9fb3d6; }
#overlay .panel .level-line > small { font-size:13px; color:#ffe9a8; white-space:nowrap; }
#overlay .panel .level-line > small:empty { display:none; }
#overlay .panel .level-line[data-max] > small { color:#8dffb0; }

/* Settlement after the first fall: where the gold is and what to buy with it. */
#overlay .settlement-panel .fall-hint { display:flex; align-items:flex-start; gap:8px; margin-top:8px; padding:8px 10px; border:1px solid #b38d42; border-radius:8px;
  background:#38362f; color:#fff3c9; font-size:16px; line-height:1.4; text-align:left; }
#overlay .settlement-panel .fall-hint > img { flex:none; width:24px!important; height:24px!important; margin-top:1px; }
#overlay .settlement-panel .fall-hint b { color:#ffe680; font-variant-numeric:tabular-nums; }

/* First run: one line that explains the numbers over the heads. It stands on the player's own number and points at
   it; a tap puts it away. Nothing is near the player in those first seconds, so it covers only empty road. */
.r8-first-hint { position:absolute; z-index:3; left:clamp(292px,var(--hint-x,50vw),calc(100vw - 292px)); bottom:var(--hint-bottom,40vh); translate:-50% 0;
  width:max-content; max-width:560px; display:flex; align-items:center; gap:12px; min-height:44px; padding:8px 8px 8px 14px;
  border:1px solid #c9d8f2; border-radius:12px; background:#101a2ef2; color:#fff; font:inherit; font-size:16px; line-height:1.4; text-align:left;
  box-shadow:0 4px 0 #0b122299; cursor:pointer; }
.r8-first-hint[hidden] { display:none; }
.r8-first-hint::after { content:""; position:absolute; left:var(--hint-tip,50%); bottom:-8px; width:14px; height:14px; translate:-50% 0; rotate:45deg;
  background:#101a2e; border-right:1px solid #c9d8f2; border-bottom:1px solid #c9d8f2; }
.r8-first-hint b { color:#ffe680; }
.r8-first-hint em { font-style:normal; font-weight:900; }
.r8-first-hint em[data-threat="over"] { color:#ff6a5c; }
.r8-first-hint em[data-threat="under"] { color:#fff3d2; }
.r8-first-hint .hint-close { flex:none; padding:7px 12px; border:1px solid #8d9fbf; border-radius:8px; background:#2d4468; font-size:15px; line-height:1.2; white-space:nowrap; }
.r8-first-hint:hover .hint-close,.r8-first-hint:focus-visible .hint-close { border-color:var(--gd-mint); }

@media (max-width:700px) {
  .hud-stats .stat.health { min-height:34px; min-width:60px; padding-inline:6px; }
  .hud-stats .stat.health img { width:18px; height:18px; }
  .hud-stats .stat.health strong { font-size:17px; }
  #bossbar { grid-template-columns:34px minmax(0,1fr) auto auto; column-gap:6px; }
  #bossbar .r8-boss-life { font-size:17px; }
  #overlay .panel .product:has(> .level-lines) { grid-template-rows:auto auto auto; grid-template-areas:"art name level" "levels levels levels" "buy buy buy"; }
  .r8-first-hint { left:50%; max-width:calc(100vw - 24px); font-size:15px; gap:8px; padding-left:10px; }
}

/* ===== V4 UI R8b: copy follow-ups, loading page, reward cards, old pictures in battle =====
   Loading page: a neutral line about the wait, and one more line that appears only when the page is still on this
   screen after 25 seconds. index.html shows that line by removing its hidden attribute, so it also appears before this
   sheet is applied (the single-file package applies the sheet only once the whole file has been read). */
.loading .loading-note { margin:0; font-size:1rem; line-height:1.4; opacity:.92; }
.loading .loading-slow { margin:6px 0 0; max-width:min(31em,88vw); padding:9px 14px; font-size:1rem; line-height:1.5; text-align:center;
  border:1px solid #c9d8f2; border-radius:10px; background:#101a2ee0; color:#fff; text-shadow:none; }
.loading [hidden] { display:none; }

/* Reward cards: composed pictures for relic and encounter cards (ui.mjs sceneArt). Each scene is a box of a fixed
   shape (--a = width / height) fitted into the art area, and every layer is sized from that box (cqw / cqh), so one
   composition serves the wide card, the six-card grid and the phone layout without spilling. Layers are live files:
   the pictures follow the sword and companion renders the other lines re-issue under the same names. */
.reward-panel .r4-card .r4-card-art { container-type:size; }
.r4-card-art > .card-scene { --a:1.5; position:relative; display:block; flex:none; width:min(100cqw,calc(100cqh * var(--a))); aspect-ratio:var(--a); height:auto; container-type:size; }
.r4-card-art .card-scene img { position:static; width:auto; height:100%; max-width:none; object-fit:contain; }
.r4-card-art .card-scene > i { position:absolute; display:block; font-style:normal; }
.r4-card-art .card-scene > i > img { display:block; width:100%!important; height:100%!important; }
/* one picture: the roadblock units (own render, wide) and the medkit (library sprite, a little over its own size) */
.r4-card-art > .card-scene[data-scene="roadblock"] { width:100cqw; height:100cqh; aspect-ratio:auto; }
/* the four units fill the height of any art area; a narrow one shows the middle of the line */
.r4-card-art .card-scene[data-scene="roadblock"] > img { display:block; width:100%; height:100%; object-fit:cover; }
.card-scene[data-scene="kit"] { --a:1.25; display:flex; align-items:center; justify-content:center; }
.r4-card-art .card-scene[data-scene="kit"] > img { height:80%; }
/* life doubled: two medkits, the second one tucked behind, and a "x2" tag */
.card-scene[data-scene="kits"] { --a:1.4; }
.card-scene[data-scene="kits"] > i { width:54cqw; height:62cqh; left:calc(4cqw + var(--n) * 38cqw); top:calc(32cqh - var(--n) * 26cqh); z-index:calc(2 - var(--n)); }
.card-scene[data-scene="kits"] > em { position:absolute; z-index:3; right:1cqw; bottom:4cqh; padding:0 .32em; border-radius:.5em; background:#101a2ee6; border:1px solid #ffd659;
  color:#ffe680; font-style:normal; font-weight:900; font-size:max(15px,17cqh); line-height:1.35; }
/* a heap of gold beans: five behind, a large one in front */
.card-scene[data-scene="beans"] > i { --x:50; --y:0; --s:50; left:calc(var(--x) * 1cqw - var(--s) * .5cqh); top:calc(var(--y) * 1cqh); width:calc(var(--s) * 1cqh); height:calc(var(--s) * 1cqh); }
.card-scene[data-scene="beans"] > i:nth-child(1) { --x:17; --y:44; --s:50; }
.card-scene[data-scene="beans"] > i:nth-child(2) { --x:83; --y:46; --s:48; }
.card-scene[data-scene="beans"] > i:nth-child(3) { --x:32; --y:8; --s:50; }
.card-scene[data-scene="beans"] > i:nth-child(4) { --x:68; --y:6; --s:52; }
.card-scene[data-scene="beans"] > i:nth-child(5) { --x:50; --y:-2; --s:44; rotate:-12deg; }
.card-scene[data-scene="beans"] > i:nth-child(6) { --x:50; --y:25; --s:75; z-index:2; }
/* both companions, as large as the box allows */
.card-scene[data-scene="pets"] { --a:1.25; display:flex; align-items:flex-end; justify-content:center; }
.r4-card-art .card-scene[data-scene="pets"] > img { height:96%; max-width:62%; }
.r4-card-art .card-scene[data-scene="pets"] > img + img { margin-left:-20cqw; height:88%; }
/* a rack of five flying swords; a family sword render lies flat, so it is stood on the diagonal first */
.card-scene[data-scene="swords"] { --a:1.7; }
.card-scene[data-scene="swords"] > i { top:calc(2cqh + (var(--n) - 2) * (var(--n) - 2) * 1.2cqh); left:calc(var(--n) * 18.5cqh); width:96cqh; height:96cqh;
  rotate:calc((var(--n) - 2) * 5deg); filter:drop-shadow(0 0 5px #8fe9ffb0); }
.card-scene:is([data-scene="swords"],[data-scene="edge"]) > i:has(> img[data-ui-asset*="/weapons/"]) > img { rotate:-45deg; scale:1.38; }
/* one sword with a lit edge and three glints */
.card-scene[data-scene="edge"] { --a:1; }
.card-scene[data-scene="edge"] > i { inset:0; }
.r4-card-art .card-scene[data-scene="edge"] > i > img { filter:drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 9px #ffd35c) drop-shadow(0 5px 5px #101629); }
.card-scene[data-scene="edge"] > b { position:absolute; width:13cqh; aspect-ratio:1; background:#fff; clip-path:polygon(50% 0,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0 50%,40% 40%);
  filter:drop-shadow(0 0 4px #ffe9a0); }
.card-scene[data-scene="edge"] > b:nth-of-type(1) { left:16cqw; top:16cqh; }
.card-scene[data-scene="edge"] > b:nth-of-type(2) { left:56cqw; top:44cqh; width:9cqh; }
.card-scene[data-scene="edge"] > b:nth-of-type(3) { left:74cqw; top:70cqh; width:16cqh; }
/* nine bullets coming down in three slanted lines */
.card-scene[data-scene="rain"] > i { --x:0; --y:0; --s:40; left:calc(var(--x) * 1cqw); top:calc(var(--y) * 1cqh); width:calc(var(--s) * .93cqh); height:calc(var(--s) * 1cqh); rotate:118deg; }
.card-scene[data-scene="rain"] > i:nth-child(1) { --x:2; --y:0; --s:36; }
.card-scene[data-scene="rain"] > i:nth-child(2) { --x:34; --y:6; --s:46; }
.card-scene[data-scene="rain"] > i:nth-child(3) { --x:70; --y:0; --s:34; }
.card-scene[data-scene="rain"] > i:nth-child(4) { --x:15; --y:30; --s:40; }
.card-scene[data-scene="rain"] > i:nth-child(5) { --x:48; --y:36; --s:50; }
.card-scene[data-scene="rain"] > i:nth-child(6) { --x:78; --y:28; --s:38; }
.card-scene[data-scene="rain"] > i:nth-child(7) { --x:0; --y:60; --s:34; }
.card-scene[data-scene="rain"] > i:nth-child(8) { --x:30; --y:62; --s:38; }
.card-scene[data-scene="rain"] > i:nth-child(9) { --x:62; --y:56; --s:42; }
/* the heavy-round box with two rounds standing beside it */
.r4-card-art .card-scene[data-scene="heavy"] > img { position:absolute; left:1cqw; bottom:8cqh; height:60cqh; }
.card-scene[data-scene="heavy"] > i { bottom:10cqh; left:calc(46cqw + var(--n) * 18cqw); width:54cqh; height:58cqh; rotate:calc(-10deg + var(--n) * 16deg); }
@media (max-width:700px) {
  /* Phone: the picture stands beside the name and the one-line effect; the number rows and the upgrade path take the
     full card width below, so no row is squeezed or cut. The list scrolls when three tall cards do not fit. */
  .r4-reward-panel .card.r4-card { min-height:0; grid-template-columns:minmax(112px,38%) minmax(0,1fr); grid-template-rows:auto auto minmax(0,1fr) auto auto;
    grid-template-areas:"head head" "art name" "art stats" "numbers numbers" "path path"; gap:5px 10px; padding:8px 10px 10px; }
  .r4-reward-panel .r4-card .r4-card-art { grid-area:art; height:auto; min-height:92px; max-height:none; align-self:stretch; }
  .r4-reward-panel .r4-card > strong { grid-area:name; align-self:end; font-size:19px; }
  .r4-reward-panel .r4-card .r4-card-copy { grid-area:stats; align-self:start; }
  .r4-reward-panel .r4-card .r4-values { grid-area:numbers; margin-top:0; }
  .r4-reward-panel .r4-card .r4-delta,.r4-reward-panel .r4-card .r4-delta b { font-size:15px; }
  .r4-reward-panel .r4-card .r5-path { grid-area:path; position:static; gap:6px; padding:4px 8px; font-size:13px; }
  .r4-reward-panel .r4-card .r5-path > em { margin-right:auto; }
  .r4-reward-panel .r4-card .r5-path > img { flex:none; width:46px; height:30px; }
  .r4-reward-panel .r4-card .card-tag { font-size:13px; }
  .r4-reward-panel .r4-card .r4-card-art[data-art-kind="pet"] > img { scale:1.25; }
}

/* Life numbers, follow-up to R8a (Lead): numbers in a tight group sit close together, so small digits get a relatively
   heavier ring - ui.mjs keeps it at 1.9 px on screen or more - and every number gets a dark hairline outside its ring.
   Two neighbours stay apart at 14-16 px whatever their colours are. --life-ring / --life-edge are radii in em. */
#labels .world-label:is(.player-life,.enemy-life,.boss-life),#bossbar .r8-boss-life {
  --edge:#0a1122; --r:calc(var(--life-ring,.07) * 1em); --e:calc(var(--life-edge,.07) * 1em);
  text-shadow:
    var(--r) 0 0 var(--rim), calc(0.924 * var(--r)) calc(0.383 * var(--r)) 0 var(--rim), calc(0.707 * var(--r)) calc(0.707 * var(--r)) 0 var(--rim), calc(0.383 * var(--r)) calc(0.924 * var(--r)) 0 var(--rim),
    0 var(--r) 0 var(--rim), calc(-0.383 * var(--r)) calc(0.924 * var(--r)) 0 var(--rim), calc(-0.707 * var(--r)) calc(0.707 * var(--r)) 0 var(--rim), calc(-0.924 * var(--r)) calc(0.383 * var(--r)) 0 var(--rim),
    calc(-1.0 * var(--r)) 0 0 var(--rim), calc(-0.924 * var(--r)) calc(-0.383 * var(--r)) 0 var(--rim), calc(-0.707 * var(--r)) calc(-0.707 * var(--r)) 0 var(--rim), calc(-0.383 * var(--r)) calc(-0.924 * var(--r)) 0 var(--rim),
    0 calc(-1.0 * var(--r)) 0 var(--rim), calc(0.383 * var(--r)) calc(-0.924 * var(--r)) 0 var(--rim), calc(0.707 * var(--r)) calc(-0.707 * var(--r)) 0 var(--rim), calc(0.924 * var(--r)) calc(-0.383 * var(--r)) 0 var(--rim),
    var(--e) 0 0 var(--edge), calc(0.866 * var(--e)) calc(0.5 * var(--e)) 0 var(--edge), calc(0.5 * var(--e)) calc(0.866 * var(--e)) 0 var(--edge), 0 var(--e) 0 var(--edge),
    calc(-0.5 * var(--e)) calc(0.866 * var(--e)) 0 var(--edge), calc(-0.866 * var(--e)) calc(0.5 * var(--e)) 0 var(--edge), calc(-1.0 * var(--e)) 0 0 var(--edge), calc(-0.866 * var(--e)) calc(-0.5 * var(--e)) 0 var(--edge),
    calc(-0.5 * var(--e)) calc(-0.866 * var(--e)) 0 var(--edge), 0 calc(-1.0 * var(--e)) 0 var(--edge), calc(0.5 * var(--e)) calc(-0.866 * var(--e)) 0 var(--edge), calc(0.866 * var(--e)) calc(-0.5 * var(--e)) 0 var(--edge),
    0 .12em .1em var(--drop);
}

/* Record and settlement chips: the gold bean keeps the size of the other chip pictures (it carried the 48 px menu size). */
#overlay .panel .record-buffs .loadout-item img.v4-menu-icon { width:28px!important; height:28px!important; }

/* The card grid inside the scrolling list must not be a scroll container itself. A legacy phone rule (".cards { overflow:auto;
   overscroll-behavior:contain }", from before the list got its own wrapper) left it as one, so a finger drag or a wheel turn
   stopped at the grid and never reached the real list: on a phone the cards below the fold could not be reached. */
.r4-reward-panel .r4-card-scroll > .cards { overflow:visible; overscroll-behavior:auto; }

.r4-reward-panel .r4-card .r4-card-copy,
.r4-reward-panel .r4-card .effect-unit > span {
  min-width:0;
  overflow-wrap:anywhere;
}
.r4-reward-panel .r4-card .effect-unit > span { white-space:normal; }
.r4-reward-panel .r4-card .r4-delta > span { min-width:0; overflow-wrap:anywhere; }
.r9-shot-summary { display:grid; flex:0 0 100%; min-width:0; gap:3px; }
.r9-shot-summary .r4-delta { flex-wrap:wrap; row-gap:1px; }
.r9-shot-note { padding:1px 4px; color:#f1f5ff; }
#overlay .panel .record-buffs .loadout-text { min-width:0; max-width:100%; white-space:normal; }
#overlay .panel .record-buffs .loadout-name { white-space:normal; }
#overlay .panel .record-buffs .loadout-text > :is(img,strong) { flex-shrink:0; }
@media (max-width:700px) {
  #overlay .panel .product .status-chip { white-space:normal; }
  #overlay .panel .level-line { flex-wrap:wrap; row-gap:1px; }
  #overlay .panel .level-line > span:first-child { flex-basis:8em; }
  .r4-reward-panel .r9-shot-summary .r4-delta { display:grid; }
  .r4-reward-panel .r9-shot-summary .r4-delta > b { text-align:left; }
}

#labels .world-label.boss-life { z-index:3; transition:none; }
#labels .world-label.boss-life[data-threat="boss"],#bossbar .r8-boss-life[data-threat="boss"] {
  --ink:#ffe9a8; --rim:#30203e; --edge:#100e24; --drop:#101827;
}
#bossbar { grid-template-columns:40px minmax(0,1fr) auto; }
#bossbar #boss-portrait { grid-row:1 / span 3; }
#bossbar #bossname { grid-column:2; grid-row:1; white-space:normal; overflow:visible; text-overflow:clip; }
#bossbar .r6-boss-percent { grid-column:3; grid-row:1; }
#bossbar .r8-boss-life {
  grid-column:2 / 4; grid-row:2; justify-self:end; padding:0 2px 1px;
  font-size:var(--boss-life-size,20px); white-space:nowrap;
}
#bossbar progress,#bossbar .r6-boss-ticks { grid-column:2 / 4; grid-row:3; }
#labels .boss-life[data-boss-zero],#bossbar[data-defeated] .r8-boss-life {
  animation:r11-boss-zero .34s ease-out;
}
@keyframes r11-boss-zero {
  0%,100% { filter:none; }
  18% { filter:brightness(1.25) drop-shadow(0 0 5px #ffdc65); }
}
@media (pointer:coarse), (max-width:690px) {
  #bossbar { grid-template-columns:34px minmax(0,1fr) auto; }
  #bossbar #bossname { font-size:14px; }
  #bossbar .r8-boss-life { font-size:var(--boss-life-size,18px); }
}
@media (max-width:700px) {
  #bossbar { width:var(--bossbar-safe-width,calc(100vw - 194px)); top:var(--bossbar-safe-top,max(8px,env(safe-area-inset-top))); }
}
@media (prefers-reduced-motion:reduce) {
  #labels .boss-life[data-boss-zero],#bossbar[data-defeated] .r8-boss-life { animation:none; }
}

#overlay [data-shop-item="potion"]:focus { outline:2px solid #ffe680; outline-offset:-2px; }

#labels .world-label:is(.player-life,.enemy-life,.boss-life) { transition-property:color; }
#labels .world-label[data-gate-protected],#labels .world-label[data-ui-obscured] { visibility:hidden!important; }
[data-r12-obscured] { visibility:hidden!important; }
#pet-promotion .r12-promotion-receipt { display:none; }
#pet-promotion[data-docked] {
  width:max-content; max-width:min(248px,calc(100vw - 24px)); height:auto; padding:6px 9px;
  background:linear-gradient(145deg,#324766,#1a263e); border:1px solid #c4a8eb; border-radius:8px;
  box-shadow:0 3px #172035; filter:none; text-align:left; color:#fff;
}
#pet-promotion[data-docked] .promotion-stage,#pet-promotion[data-docked] .promotion-announcement { display:none; }
#pet-promotion[data-docked] .r12-promotion-receipt { display:flex; align-items:center; gap:8px; }
#pet-promotion .r12-promotion-receipt img { width:38px; height:40px; object-fit:contain; flex:none; }
#pet-promotion .r12-promotion-receipt span { display:grid; gap:2px; font-size:15px; line-height:1.22; }
#pet-promotion .r12-promotion-receipt small { font-size:12px; color:#dfd5f9; }
.r12-reward-receipt {
  position:absolute; z-index:3; top:0; left:0; margin:0; display:flex; align-items:center; gap:6px;
  max-width:min(246px,calc(100vw - 24px)); padding:6px 9px; border-radius:8px;
  background:linear-gradient(145deg,#294361,#192840); border:1px solid #e9cc78; color:#fff;
  box-shadow:0 3px #172035; font-size:15px; line-height:1.3; pointer-events:none;
}
.r12-reward-receipt img { width:24px; height:24px; object-fit:contain; flex:none; }
.r12-reward-receipt b { color:#ffe680; }
#game :is(#pet-promotion,#toast,.r12-reward-receipt,.r5-ride-banner,.r8-first-hint)[data-r12-positioned] {
  top:var(--r12-y); left:var(--r12-x); right:auto; bottom:auto; transform:none!important; translate:none!important; animation:none;
}
.r8-first-hint[data-r12-positioned]::after { content:none; }
#boss-warning[data-r12-positioned] {
  position:fixed; top:var(--r12-y); left:var(--r12-x); right:auto; bottom:auto; translate:none; transform:none;
  width:var(--r12-warning-width);
}
#bossbar[data-ahead] { transition:none; }
</script>
