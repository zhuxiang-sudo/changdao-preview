<script>
const format = JSON.parse(document.getElementById('island-format').textContent);
const byteCache = new Map();
const handles = new Map();
function raw(id) {
  const part = document.getElementById('payload-' + id);
  if (!part) throw new Error('Missing bundled bytes: ' + id);
  const chars = atob(part.textContent);
  const bytes = new Uint8Array(chars.length);
  for (let index = 0; index < chars.length; index++) bytes[index] = chars.charCodeAt(index);
  const gzipped = part.dataset.gz === '1';
  part.remove();
  return { bytes, gzipped };
}
function unpack(id) {
  if (!byteCache.has(id)) {
    const { bytes, gzipped } = raw(id);
    const task = gzipped
      ? new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer()
      : Promise.resolve(bytes);
    byteCache.set(id, task);
  }
  return byteCache.get(id);
}
function lookup(name) {
  if (!Object.hasOwn(format.assets, name)) throw new Error('Missing bundled asset: ' + name);
  return format.assets[name];
}
function saveHandle(key, bytes, mime) {
  if (!handles.has(key)) handles.set(key, URL.createObjectURL(new Blob([bytes], { type: mime })));
  return handles.get(key);
}
function url(name) {
  const [id, mime] = lookup(name);
  const key = id + ':' + mime;
  if (handles.has(key)) return handles.get(key);
  const { bytes, gzipped } = raw(id);
  if (gzipped) throw new Error('Asset must be prepared before its URL is used: ' + name);
  return saveHandle(key, bytes, mime);
}
const json = async name => {
  const [id] = lookup(name);
  return JSON.parse(new TextDecoder().decode(await unpack(id)).replace(/^\uFEFF/, ""));
};
function fail(error) {
  console.error(error);
  const block = document.querySelector('.loading p');
  if (block) block.textContent = '无法打开游戏。请用 Chrome 或 Edge 重新打开这个文件。技术详情：' + error.message;
  document.documentElement.dataset.ready = 'failed';
}
async function boot() {
  const skin = document.createElement('style');
  skin.textContent = document.getElementById('island-style').textContent.replace(
    /url\(\s*(?:["'])?assets\/([^'"\s)]+)(?:["'])?\s*\)/g, (_, path) => 'url("' + url(path) + '")'
  );
  document.head.append(skin);
  for (const tag of document.querySelectorAll('[data-island-src],[data-island-href]')) {
    for (const key of ['src','href']) {
      const identity = tag.getAttribute('data-island-' + key);
      if (identity) tag.setAttribute(key, url(identity));
    }
  }
  globalThis.__islandAssets = Object.freeze({ url, json });
  const decoder = new TextDecoder();
  const moduleUrls = new Map();
  const audio = Promise.all(format.audio.map(async name => {
    const [id, mime] = lookup(name);
    saveHandle(id + ':' + mime, await unpack(id), mime);
    byteCache.delete(id);
  }));
  for (const [identity, payload, imports] of format.modules) {
    let contents = decoder.decode(await unpack(payload));
    byteCache.delete(payload);
    for (const [token, dependency] of imports) {
      if (!moduleUrls.has(dependency)) throw new Error('Module order: ' + dependency);
      contents = contents.replaceAll(token, moduleUrls.get(dependency));
    }
    moduleUrls.set(identity, URL.createObjectURL(new Blob([contents], {type:'text/javascript'})));
  }
  await audio;
  await import(moduleUrls.get('src/main.mjs'));
}
boot().catch(fail);
</script>
